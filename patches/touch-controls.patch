+#if !TARGET_OS_VISION
+// ---- touch controls (iPhone and iPad): a stick to walk, a camera pad, buttons, and a keyboard
+//
+// For playing with neither a keyboard nor a game controller. Addons can't move the character (the
+// game's movement functions are protected), so the stick lives here and presses W, A, S and D (walk
+// forward, turn left, walk back, turn right; or Q and E, strafing, for left and right) as a keyboard
+// would, through the same event queue sp_key fills.
+//
+// The buttons press keys: Jump is Space; Interact F11, Fishing F12 and Auto Run F10, which the SPTouch
+// addon binds with priority (interact with the soft target; cast Fishing, then land the catch; toggle
+// autorun), and F9 (open the chat) when the keyboard opens. Without the addon those keys are the game's
+// own. Not F13: on a Mac that is Print Screen, which the game names PRINTSCREEN and takes a screenshot
+// with. The camera pad is a right-button drag, as a two-finger drag is (sp_chord_resolve), which turns
+// the character and the camera; a tap on it is a left click where it landed.
+//
+// Six buttons sit in the strip beside the game (an iPhone's Dynamic Island side), always there: Touch
+// shows and hides the rest (hidden by itself while a game controller or a hardware keyboard is
+// connected); Seite switches the right side between page 1 (Fishing, Jump) and page 2, whose fight
+// buttons the SPTouch addon draws in the game itself (from the player's own key bindings, with their
+// cooldowns, rage, range, and the stance), told which page by F6, F7, and F8; the gear opens the
+// settings (sizes, the stick's sideways keys, the camera pad's speed, opacity, vibration; NSUserDefaults
+// "sp_touch_*"), and held, edit mode, where a drag moves a control and a tap steps its size, saved per
+// page; the map button is M (the game's world map), Esc is Escape, and the keyboard button opens the
+// system keyboard, whose text goes to the game as key presses. Off altogether with SP_TOUCH_CONTROLS=0
+// or NSUserDefaults "sp_touch_controls" = NO.
+
+static BOOL sp_touch_controls_wanted(void) {
+    const char *env = getenv("SP_TOUCH_CONTROLS");
+    if (env) return atoi(env) != 0;
+    id v = [NSUserDefaults.standardUserDefaults objectForKey:@"sp_touch_controls"];
+    return v ? [v boolValue] : YES;
+}
+
+// ---- settings: the panel's rows, in order, and what each is saved as
+
+enum { SP_TS_STICK, SP_TS_BUTTONS, SP_TS_SIDE, SP_TS_CENTER, SP_TS_LOOK, SP_TS_OPACITY, SP_TS_HAPTICS, SP_TS_COUNT };
+
+static const struct {
+    const char *key, *title;
+    const char *choices[4];
+    int count, def;
+} sp_ts_rows[SP_TS_COUNT] = {
+    { "sp_touch_stick_size", "Joystick-Größe", { "Klein", "Mittel", "Groß" }, 3, 1 },
+    { "sp_touch_button_size", "Tasten-Größe", { "Klein", "Mittel", "Groß" }, 3, 1 },
+    { "sp_touch_stick_side", "Joystick seitlich", { "Drehen", "Seitwärts" }, 2, 0 },
+    { "sp_touch_stick_center", "Joystick-Mitte", { "Fest", "Am Daumen" }, 2, 1 },
+    { "sp_touch_look", "Kamera-Feld", { "Aus", "Langsam", "Mittel", "Schnell" }, 4, 2 },
+    { "sp_touch_opacity", "Deckkraft", { "Schwach", "Mittel", "Voll" }, 3, 2 },
+    { "sp_touch_haptics", "Vibration", { "Aus", "An" }, 2, 1 },
+};
+
+static int sp_ts[SP_TS_COUNT];
+
+static void sp_ts_load(void) {
+    NSUserDefaults *d = NSUserDefaults.standardUserDefaults;
+    for (int i = 0; i < SP_TS_COUNT; i++) {
+        id v = [d objectForKey:@(sp_ts_rows[i].key)];
+        int n = v ? (int)[v integerValue] : sp_ts_rows[i].def;
+        sp_ts[i] = n >= 0 && n < sp_ts_rows[i].count ? n : sp_ts_rows[i].def;
+    }
+}
+
+static void sp_ts_set(int row, int value) {
+    sp_ts[row] = value;
+    [NSUserDefaults.standardUserDefaults setInteger:value forKey:@(sp_ts_rows[row].key)];
+}
+
+static const CGFloat sp_ts_size[3] = { 0.8, 1.0, 1.2 };
+static const CGFloat sp_ts_look_speed[4] = { 0, 1.0, 1.7, 2.6 };
+static const CGFloat sp_ts_alpha[3] = { 0.45, 0.72, 1.0 };
+
+// A light tap in the hand on a press, when vibration is on.
+static void sp_touch_haptic(void) {
+    if (!sp_ts[SP_TS_HAPTICS]) return;
+    static UIImpactFeedbackGenerator *g;
+    if (!g) g = [[UIImpactFeedbackGenerator alloc] initWithStyle:UIImpactFeedbackStyleLight];
+    [g impactOccurred];
+}
+
+// A key press with no UIKey behind it: the Mac key code and the characters it types.
+static void sp_virtual_key(unsigned short mac, NSString *chars, BOOL down) {
+    SPEvent *e = sp_event(down ? SPKeyDown : SPKeyUp);
+    e->keyCode = mac;
+    unichar fc = sp_function_char(mac);
+    if (fc) {
+        e->characters = e->charactersIgnoringModifiers = [NSString stringWithCharacters:&fc length:1];
+        if (fc >= 0xF700) e->modifierFlags |= SPFunction;
+    } else {
+        e->characters = e->charactersIgnoringModifiers = chars ?: @"";
+    }
+    sp_post(e);
+}
+
+static void sp_virtual_tap(unsigned short mac, NSString *chars) {
+    sp_virtual_key(mac, chars, YES);
+    sp_virtual_key(mac, chars, NO);
+}
+
+// ---- edit mode: the controls move and change size instead of pressing anything
+//
+// Each control's touch handlers start with these; YES means edit mode had the touch. A drag moves the
+// control with the finger; a lift without one is a tap, which steps its size. SPTouchControls saves
+// either (sp_touch_edit_done), for the page shown.
+static BOOL sp_touch_editing;
+static void (^sp_touch_edit_done)(UIView *view, BOOL moved);
+static UIView *sp_edit_view;
+static UITouch *sp_edit_touch;
+static CGPoint sp_edit_from, sp_edit_center;
+static BOOL sp_edit_moved;
+static const CGFloat sp_edit_steps[5] = { 0.7, 0.85, 1.0, 1.2, 1.4 };
+
+static BOOL sp_edit_begin(UIView *v, NSSet<UITouch *> *touches) {
+    if (!sp_touch_editing) return NO;
+    if (!sp_edit_touch) {
+        sp_edit_view = v;
+        sp_edit_touch = touches.anyObject;
+        sp_edit_from = [sp_edit_touch locationInView:v.superview];
+        sp_edit_center = v.center;
+        sp_edit_moved = NO;
+    }
+    return YES;
+}
+
+static BOOL sp_edit_move(UIView *v, NSSet<UITouch *> *touches) {
+    if (!sp_touch_editing) return NO;
+    if (v != sp_edit_view || ![touches containsObject:sp_edit_touch]) return YES;
+    CGPoint p = [sp_edit_touch locationInView:v.superview];
+    CGFloat dx = p.x - sp_edit_from.x, dy = p.y - sp_edit_from.y;
+    if (!sp_edit_moved && hypot(dx, dy) < 8) return YES;   // a tap's wobble isn't a move
+    sp_edit_moved = YES;
+    v.center = CGPointMake(sp_edit_center.x + dx, sp_edit_center.y + dy);
+    return YES;
+}
+
+static BOOL sp_edit_end(UIView *v, NSSet<UITouch *> *touches, BOOL cancelled) {
+    if (!sp_touch_editing) return NO;
+    if (v != sp_edit_view || ![touches containsObject:sp_edit_touch]) return YES;
+    BOOL moved = sp_edit_moved;
+    sp_edit_view = nil;
+    sp_edit_touch = nil;
+    if ((moved || !cancelled) && sp_touch_edit_done) sp_touch_edit_done(v, moved);
+    return YES;
+}
+
+// A view as large as its superview that takes no touch itself: everything outside its subviews goes
+// to the view underneath (the root view, the game).
+@interface SPPassView : UIView
+@end
+
+@implementation SPPassView
+- (UIView *)hitTest:(CGPoint)point withEvent:(UIEvent *)event {
+    UIView *v = [super hitTest:point withEvent:event];
+    return v == self ? nil : v;
+}
+@end
+
+// ---- the stick
+
+// Forward, left, back, right: the keys (Mac key codes, kVK_ANSI_*) and what they type. Left and right
+// turn (A, D) or strafe (Q, E), the setting's choice. Turning by key, not by a right-button drag: the
+// stick's own mouselook press was taken as a right click on whatever stood there. The camera pad turns
+// by drag, from a touch of its own.
+static void sp_stick_key(int i, BOOL strafe, unsigned short *mac, NSString **chars) {
+    static const unsigned short turn[4] = { 0x0D, 0x00, 0x01, 0x02 }, side[4] = { 0x0D, 0x0C, 0x01, 0x0E };
+    static NSString *const turn_c[4] = { @"w", @"a", @"s", @"d" }, *const side_c[4] = { @"w", @"q", @"s", @"e" };
+    *mac = strafe ? side[i] : turn[i];
+    *chars = strafe ? side_c[i] : turn_c[i];
+}
+
+// Each key's direction (degrees, 0 right, counterclockwise, up 90) and half its sector. Forward and
+// back get 140 degrees, left and right 120: straight ahead and straight back have 60 to themselves,
+// left and right 40, and each diagonal (both keys) 40. A key held keeps its sector 7 degrees wider,
+// so a thumb resting on a boundary doesn't flick the key on and off.
+static const CGFloat sp_stick_dir[4] = { 90, 180, 270, 0 }, sp_stick_half[4] = { 70, 60, 70, 60 };
+
+@interface SPStickView : UIView
+@property(nonatomic) CGPoint rest;   // the centre at rest, in the superview's coordinates
+- (void)sp_release;
+@end
+
+@implementation SPStickView {
+    UITouch *_touch;   // the thumb on the stick; nil when free
+    UIView *_knob;
+    UILabel *_arrow[4];
+    BOOL _down[4];
+    unsigned short _mac[4];   // the key each pressed, so its release is the same key after a mode change
+    NSString *_chars[4];
+}
+
+- (instancetype)initWithFrame:(CGRect)frame {
+    if (!(self = [super initWithFrame:frame])) return nil;
+    self.backgroundColor = [UIColor colorWithWhite:1 alpha:0.10];
+    self.layer.borderColor = [UIColor colorWithWhite:1 alpha:0.35].CGColor;
+    self.layer.borderWidth = 1.5;
+    static NSString *const arrows[4] = { @"▲", @"◀", @"▼", @"▶" };
+    for (int i = 0; i < 4; i++) {
+        _arrow[i] = [[UILabel alloc] init];
+        _arrow[i].text = arrows[i];
+        _arrow[i].textAlignment = NSTextAlignmentCenter;
+        _arrow[i].textColor = [UIColor colorWithWhite:1 alpha:0.35];
+        _arrow[i].userInteractionEnabled = NO;
+        [self addSubview:_arrow[i]];
+    }
+    _knob = [[UIView alloc] init];
+    _knob.userInteractionEnabled = NO;
+    _knob.backgroundColor = [UIColor colorWithWhite:1 alpha:0.35];
+    [self addSubview:_knob];
+    return self;
+}
+
+- (CGFloat)sp_r {
+    return self.bounds.size.width / 2;
+}
+
+// A new rest point (a layout) moves a stick that's free; a held one goes back there on release.
+- (void)setRest:(CGPoint)rest {
+    _rest = rest;
+    if (!_touch) self.center = rest;
+}
+
+- (void)layoutSubviews {
+    [super layoutSubviews];
+    CGFloat r = [self sp_r], k = r * 0.8;
+    self.layer.cornerRadius = r;
+    _knob.bounds = CGRectMake(0, 0, k, k);
+    _knob.layer.cornerRadius = k / 2;
+    if (!_touch) _knob.center = CGPointMake(r, r);
+    CGFloat a = MAX(10, r * 0.22);
+    for (int i = 0; i < 4; i++) {
+        _arrow[i].font = [UIFont boldSystemFontOfSize:a];
+        _arrow[i].bounds = CGRectMake(0, 0, a * 1.6, a * 1.6);
+        CGFloat rad = sp_stick_dir[i] * M_PI / 180;
+        _arrow[i].center = CGPointMake(r + cos(rad) * r * 0.78, r - sin(rad) * r * 0.78);
+    }
+}
+
+// A catch area wider than the ring, so a thumb landing a little outside still takes the stick; wider
+// still when the centre goes to the thumb.
+- (BOOL)pointInside:(CGPoint)p withEvent:(UIEvent *)event {
+    CGFloat r = [self sp_r];
+    return hypot(p.x - r, p.y - r) <= r * (sp_ts[SP_TS_CENTER] ? 1.45 : 1.3);
+}
+
+- (void)sp_key:(int)i down:(BOOL)down {
+    if (_down[i] == down) return;
+    if (down) {
+        NSString *chars;
+        sp_stick_key(i, sp_ts[SP_TS_SIDE] == 1, &_mac[i], &chars);
+        _chars[i] = chars;
+    }
+    _down[i] = down;
+    sp_virtual_key(_mac[i], _chars[i], down);
+    _arrow[i].textColor = [UIColor colorWithWhite:1 alpha:down ? 0.95 : 0.35];
+}
+
+// p is in the superview's coordinates. Moves the centre to within 0.9 radius of the rest point.
+- (void)sp_center_toward:(CGPoint)c {
+    CGFloat r = [self sp_r], ox = c.x - _rest.x, oy = c.y - _rest.y, ol = hypot(ox, oy), max = r * 0.9;
+    if (ol > max) c = CGPointMake(_rest.x + ox * max / ol, _rest.y + oy * max / ol);
+    self.center = c;
+}
+
+- (void)sp_follow:(CGPoint)p {
+    CGFloat r = [self sp_r];
+    if (r <= 0) return;
+    CGPoint c = self.center;
+    CGFloat dx = (p.x - c.x) / r, dy = (p.y - c.y) / r, len = hypot(dx, dy);
+    // With the centre at the thumb, a thumb past the ring drags the ring along (so turning back is a
+    // short way, not across a far-off centre), within its bounds near the rest point.
+    if (sp_ts[SP_TS_CENTER] && len > 1) {
+        [self sp_center_toward:CGPointMake(p.x - dx / len * r, p.y - dy / len * r)];
+        c = self.center;
+        dx = (p.x - c.x) / r;
+        dy = (p.y - c.y) / r;
+        len = hypot(dx, dy);
+    }
+    if (len > 1) { dx /= len; dy /= len; len = 1; }
+    _knob.center = CGPointMake(r + dx * r * 0.62, r + dy * r * 0.62);
+    BOOL engaged = _down[0] || _down[1] || _down[2] || _down[3];
+    BOOL active = len >= (engaged ? 0.14 : 0.2);   // a resting thumb presses nothing
+    CGFloat deg = atan2(-dy, dx) * 180 / M_PI;     // screen y grows down
+    for (int i = 0; i < 4; i++) {
+        CGFloat off = fabs(remainder(deg - sp_stick_dir[i], 360));
+        [self sp_key:i down:active && off < sp_stick_half[i] + (_down[i] ? 7 : 0)];
+    }
+}
+
+- (void)sp_release {
+    for (int i = 0; i < 4; i++) [self sp_key:i down:NO];
+    _touch = nil;
+    self.center = _rest;
+    CGFloat r = [self sp_r];
+    _knob.center = CGPointMake(r, r);
+}
+
+- (void)touchesBegan:(NSSet<UITouch *> *)touches withEvent:(UIEvent *)event {
+    if (sp_edit_begin(self, touches) || _touch) return;
+    _touch = touches.anyObject;
+    CGPoint p = [_touch locationInView:self.superview];
+    // The centre where the thumb landed, so the first touch presses nothing (unless it landed far out).
+    if (sp_ts[SP_TS_CENTER]) [self sp_center_toward:p];
+    [self sp_follow:p];
+}
+
+- (void)touchesMoved:(NSSet<UITouch *> *)touches withEvent:(UIEvent *)event {
+    if (sp_edit_move(self, touches)) return;
+    if (_touch && [touches containsObject:_touch]) [self sp_follow:[_touch locationInView:self.superview]];
+}
+
+- (void)touchesEnded:(NSSet<UITouch *> *)touches withEvent:(UIEvent *)event {
+    if (sp_edit_end(self, touches, NO)) return;
+    if (_touch && [touches containsObject:_touch]) [self sp_release];
+}
+
+- (void)touchesCancelled:(NSSet<UITouch *> *)touches withEvent:(UIEvent *)event {
+    if (sp_edit_end(self, touches, YES)) return;
+    if (_touch && [touches containsObject:_touch]) [self sp_release];
+}
+@end
+
+// ---- the camera pad: a one-finger right-button drag
+
+@interface SPLookPad : UIView
+- (void)sp_release;
+@end
+
+@implementation SPLookPad {
+    UITouch *_touch;
+    CGPoint _start, _last, _virt;   // UIKit points in the root view; _virt is the mouse, scaled
+    BOOL _pressed;
+    UILabel *_label;
+}
+
+- (instancetype)initWithFrame:(CGRect)frame {
+    if (!(self = [super initWithFrame:frame])) return nil;
+    self.backgroundColor = [UIColor colorWithWhite:1 alpha:0.06];
+    self.layer.borderColor = [UIColor colorWithWhite:1 alpha:0.28].CGColor;
+    self.layer.borderWidth = 1.5;
+    _label = [[UILabel alloc] init];
+    _label.text = @"Kamera\n◀ wischen ▶";
+    _label.numberOfLines = 2;
+    _label.textAlignment = NSTextAlignmentCenter;
+    _label.textColor = [UIColor colorWithWhite:1 alpha:0.5];
+    _label.font = [UIFont boldSystemFontOfSize:12];
+    _label.userInteractionEnabled = NO;
+    [self addSubview:_label];
+    return self;
+}
+
+- (void)layoutSubviews {
+    [super layoutSubviews];
+    self.layer.cornerRadius = MIN(18, self.bounds.size.height / 4);
+    _label.frame = self.bounds;
+}
+
+- (CGPoint)sp_at:(UITouch *)t {
+    return [t locationInView:sp_touch_controls.superview];
+}
+
+- (void)touchesBegan:(NSSet<UITouch *> *)touches withEvent:(UIEvent *)event {
+    if (sp_edit_begin(self, touches) || _touch) return;
+    _touch = touches.anyObject;
+    _start = _last = _virt = [self sp_at:_touch];
+    _pressed = NO;
+    self.backgroundColor = [UIColor colorWithWhite:1 alpha:0.16];
+}
+
+// The press waits until the finger has moved, so a resting finger right-clicks nothing; then down where
+// it landed and a drag from there, as sp_chord_resolve does for two fingers. Vertical moves count for
+// less than across: a sideways swipe mostly turns, and tilts the camera only a little.
+- (void)touchesMoved:(NSSet<UITouch *> *)touches withEvent:(UIEvent *)event {
+    if (sp_edit_move(self, touches)) return;
+    if (!_touch || ![touches containsObject:_touch]) return;
+    CGPoint p = [self sp_at:_touch];
+    if (!_pressed) {
+        if (hypot(p.x - _start.x, p.y - _start.y) < 7) return;
+        _pressed = YES;
+        sp_mouse_button(1, YES, sp_from_uikit(_start));
+    }
+    CGFloat speed = sp_ts_look_speed[sp_ts[SP_TS_LOOK]];
+    _virt.x += (p.x - _last.x) * speed;
+    _virt.y += (p.y - _last.y) * speed * 0.7;
+    _last = p;
+    CGPoint m = sp_from_uikit(_virt);
+    if (m.x != sp_pointer.x || m.y != sp_pointer.y) sp_mouse_moved_to(m, sp_motion_type(), NO);
+}
+
+- (void)touchesEnded:(NSSet<UITouch *> *)touches withEvent:(UIEvent *)event {
+    if (sp_edit_end(self, touches, NO)) return;
+    if (!_touch || ![touches containsObject:_touch]) return;
+    if (!_pressed) {
+        // A tap: a left click where it landed (select what's there), as a tap anywhere else is.
+        CGPoint m = sp_from_uikit(_start);
+        sp_mouse_button(0, YES, m);
+        sp_mouse_button(0, NO, m);
+    }
+    [self sp_release];
+}
+
+- (void)touchesCancelled:(NSSet<UITouch *> *)touches withEvent:(UIEvent *)event {
+    if (sp_edit_end(self, touches, YES)) return;
+    if (_touch && [touches containsObject:_touch]) [self sp_release];
+}
+
+// The release where the mouse is: anywhere else would move it first, mid-mouselook a jump.
+- (void)sp_release {
+    if (_pressed) sp_mouse_button(1, NO, sp_pointer);
+    _pressed = NO;
+    _touch = nil;
+    self.backgroundColor = [UIColor colorWithWhite:1 alpha:0.06];
+}
+@end
+
+// ---- buttons
+
+// A round button holding one key down while touched.
+@interface SPPadButton : UIView
+- (instancetype)initWithTitle:(NSString *)title mac:(unsigned short)mac chars:(NSString *)chars;
+- (void)sp_release;
+@end
+
+@implementation SPPadButton {
+    UITouch *_touch;
+    UILabel *_label;
+    unsigned short _mac;
+    NSString *_chars;
+}
+
+- (instancetype)initWithTitle:(NSString *)title mac:(unsigned short)mac chars:(NSString *)chars {
+    if (!(self = [super initWithFrame:CGRectZero])) return nil;
+    _mac = mac;
+    _chars = [chars copy];
+    self.backgroundColor = [UIColor colorWithWhite:1 alpha:0.12];
+    self.layer.borderColor = [UIColor colorWithWhite:1 alpha:0.4].CGColor;
+    self.layer.borderWidth = 1.5;
+    _label = [[UILabel alloc] init];
+    _label.text = title;
+    _label.textColor = [UIColor colorWithWhite:1 alpha:0.9];
+    _label.font = [UIFont boldSystemFontOfSize:14];
+    _label.numberOfLines = 2;
+    _label.textAlignment = NSTextAlignmentCenter;
+    _label.adjustsFontSizeToFitWidth = YES;
+    _label.minimumScaleFactor = 0.6;
+    _label.userInteractionEnabled = NO;
+    [self addSubview:_label];
+    return self;
+}
+
+- (void)layoutSubviews {
+    [super layoutSubviews];
+    CGFloat d = self.bounds.size.width;
+    self.layer.cornerRadius = d / 2;
+    _label.font = [UIFont boldSystemFontOfSize:MAX(11, d * 0.17)];
+    _label.frame = CGRectInset(self.bounds, d * 0.1, d * 0.1);
+}
+
+- (BOOL)pointInside:(CGPoint)p withEvent:(UIEvent *)event {
+    CGFloat r = self.bounds.size.width / 2;
+    return hypot(p.x - r, p.y - r) <= r * 1.2;
+}
+
+- (void)touchesBegan:(NSSet<UITouch *> *)touches withEvent:(UIEvent *)event {
+    if (sp_edit_begin(self, touches) || _touch) return;
+    _touch = touches.anyObject;
+    self.backgroundColor = [UIColor colorWithWhite:1 alpha:0.35];
+    sp_touch_haptic();
+    sp_virtual_key(_mac, _chars, YES);
+}
+
+- (void)touchesMoved:(NSSet<UITouch *> *)touches withEvent:(UIEvent *)event {
+    sp_edit_move(self, touches);
+}
+
+- (void)touchesEnded:(NSSet<UITouch *> *)touches withEvent:(UIEvent *)event {
+    if (sp_edit_end(self, touches, NO)) return;
+    if (_touch && [touches containsObject:_touch]) [self sp_release];
+}
+
+- (void)touchesCancelled:(NSSet<UITouch *> *)touches withEvent:(UIEvent *)event {
+    if (sp_edit_end(self, touches, YES)) return;
+    if (_touch && [touches containsObject:_touch]) [self sp_release];
+}
+
+- (void)sp_release {
+    if (!_touch) return;
+    _touch = nil;
+    self.backgroundColor = [UIColor colorWithWhite:1 alpha:0.12];
+    sp_virtual_key(_mac, _chars, NO);
+}
