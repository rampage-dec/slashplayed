+static BOOL sp_prof_delete(NSString *name) {
+    NSString *path = sp_prof_path(name);
+    if (!path || ![NSFileManager.defaultManager removeItemAtPath:path error:NULL]) return NO;
+    sp_prof_relink(name, nil);
+    sp_layout_backup();
+    return YES;
+}
+
+static BOOL sp_prof_rename(NSString *from, NSString *to) {
+    if (!to.length || [from isEqualToString:to] || sp_prof_exists(to)) return NO;
+    if (![NSFileManager.defaultManager moveItemAtPath:sp_prof_path(from) toPath:sp_prof_path(to) error:NULL]) return NO;
+    sp_prof_relink(from, to);
+    sp_layout_backup();
+    return YES;
+}
