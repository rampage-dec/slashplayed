+// The strip's lower group's order: the saved one, as far as it names each button once; the rest as built.
+- (void)sp_load_strip_order {
+    _strip_order = [NSMutableArray array];
+    NSArray *saved = [NSUserDefaults.standardUserDefaults arrayForKey:@"sp_touch_strip"];
+    for (id k in saved)
+        if ([k isKindOfClass:NSString.class] && [@[ @"map", @"info", @"esc", @"kbd" ] containsObject:k]
+            && ![_strip_order containsObject:k]) [_strip_order addObject:k];
+    for (NSString *k in @[ @"map", @"info", @"esc", @"kbd" ])
+        if (![_strip_order containsObject:k]) [_strip_order addObject:k];
+}
+
+// ---- the pages
+
+- (void)sp_load_pages {
+    NSUserDefaults *d = NSUserDefaults.standardUserDefaults;
+    _pages = [NSMutableArray array];
+    id saved = [d objectForKey:@"sp_touch_pages"];
+    if ([saved isKindOfClass:NSArray.class]) {
+        for (id page in saved) {
+            if (![page isKindOfClass:NSArray.class] || (NSInteger)_pages.count >= sp_max_pages) continue;
+            NSMutableArray *items = [NSMutableArray array];
+            for (id it in page)
+                if (sp_item_ok(it)) [items addObject:[it mutableCopy]];
+            [_pages addObject:items];
+        }
+    }
+    if (!_pages.count) {
+        for (NSInteger p = 1; p <= 2; p++) {
+            NSDictionary *lay = sp_old_layout(p);
+            NSMutableArray *items = [NSMutableArray array];
+            for (NSString *k in sp_default_kinds(p)) [items addObject:sp_item_from_old(k, lay)];
+            [_pages addObject:items];
+        }
+        [d setObject:_pages forKey:@"sp_touch_pages"];
+    }
+    if (![[d objectForKey:@"sp_touch_stick"] isKindOfClass:NSDictionary.class])
+        [d setObject:sp_item_from_old(@"stick", sp_old_layout(1)) forKey:@"sp_touch_stick"];
+    _page = [[d objectForKey:@"sp_touch_page"] integerValue];
+    if (_page < 1 || _page > (NSInteger)_pages.count) _page = 1;
+    // Each page's trigger, as many as there are pages (a layout from before has none).
+    _page_auto = [NSMutableArray array];
+    NSArray *autos = [d arrayForKey:@"sp_touch_page_auto"];
+    for (NSUInteger i = 0; i < _pages.count; i++) {
+        id k = i < autos.count ? autos[i] : nil;
+        [_page_auto addObject:[k isKindOfClass:NSString.class] ? k : @""];
+    }
+}
+
+- (void)sp_save_pages {
+    [NSUserDefaults.standardUserDefaults setObject:_pages forKey:@"sp_touch_pages"];
+    [NSUserDefaults.standardUserDefaults setObject:[_page_auto copy] forKey:@"sp_touch_page_auto"];
+    [NSUserDefaults.standardUserDefaults setInteger:_page forKey:@"sp_touch_page"];
+    [NSUserDefaults.standardUserDefaults synchronize];
+    sp_layout_backup();
+}
+
+// The settings' "Layout laden": the file's layout and settings, shown at once.
+- (BOOL)sp_layout_load {
+    if (!sp_layout_restore_from(sp_layout_saved_path()) && !sp_layout_restore()) return NO;
+    [self sp_reload_layout];
+    return YES;
+}
+
+// A layout taken from a file or a profile: everything read again and shown.
+- (void)sp_reload_layout {
+    sp_layout_backup();
+    sp_ts_load();
+    sp_fps_apply();
+    [self sp_load_pages];
+    [self sp_load_strip_order];
+    [self sp_rebuild_items];
+    [self sp_page_look];
+    _sent = -1;
+    _auto_page = _auto_want = 0;
+    _auto_key = nil;
+    _auto_held = NO;
+    [self sp_update_hidden];
+    [self setNeedsLayout];
+    [_panel sp_sync];
+}
+
+// A layout profile (the panel's Layout tab, or a character's at its login): the layout as it is goes
+// back into the active profile first (or, with none, into the saved file where there's none yet), so
+// nothing changed since is lost. link: the character the addon names gets it (Profil je Charakter).
+- (BOOL)sp_profile_load:(NSString *)name link:(BOOL)link {
+    if (!sp_prof_exists(name)) return NO;
+    NSString *active = sp_prof_active();
+    if (active && ![active isEqualToString:name] && sp_prof_exists(active)) sp_prof_write(active);
+    else if (!active) sp_layout_keep_before_reset();
+    if (!sp_prof_apply(name)) return NO;
+    sp_prof_set_active(name);
+    if (link && sp_ts[SP_TS_CHARPROF]) sp_prof_link(sp_gs_who(), name);
+    [self sp_reload_layout];
+    return YES;
+}
