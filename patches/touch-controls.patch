+#import <UIKit/UIGestureRecognizerSubclass.h>
+
+// Notes every touch in the window, for the battery saver: it never recognizes, cancels, or delays
+// anything. It stays possible while a finger is down (a stick held for minutes sends no new touch, and
+// a thumb at rest no moves: sp_touching says the screen is in use), and fails when the last one lifts.
+@interface SPActivityRecognizer : UIGestureRecognizer
+@end
+
+@implementation SPActivityRecognizer
+- (void)touchesBegan:(NSSet<UITouch *> *)touches withEvent:(UIEvent *)event {
+    sp_touching = YES;
+    sp_touch_activity();
+}
+- (void)touchesMoved:(NSSet<UITouch *> *)touches withEvent:(UIEvent *)event {
+    sp_touching = YES;
+    sp_touch_activity();
+}
+- (void)sp_lifted:(UIEvent *)event {
+    sp_touch_activity();
+    for (UITouch *t in event.allTouches)
+        if (t.phase != UITouchPhaseEnded && t.phase != UITouchPhaseCancelled) return;
+    sp_touching = NO;
+    self.state = UIGestureRecognizerStateFailed;
+}
+- (void)touchesEnded:(NSSet<UITouch *> *)touches withEvent:(UIEvent *)event {
+    [self sp_lifted:event];
+}
+- (void)touchesCancelled:(NSSet<UITouch *> *)touches withEvent:(UIEvent *)event {
+    [self sp_lifted:event];
+}
+- (void)reset {
+    [super reset];
+    sp_touching = NO;
+}
+@end
