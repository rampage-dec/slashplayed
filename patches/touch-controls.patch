+// ---- Uhr & Akku: "14:05 · 78 %" (⚡ charging), and "heiß" with the phone hot (30 FPS with Hitzeschutz)
+
+- (void)sp_status_update {
+    BOOL show = sp_ts[SP_TS_STATUS] != 0;
+    _status.hidden = !show;
+    if (!show) return;
+    NSDateComponents *c = [NSCalendar.currentCalendar components:NSCalendarUnitHour | NSCalendarUnitMinute fromDate:NSDate.date];
+    NSMutableString *text = [NSMutableString stringWithFormat:@"%02ld:%02ld", (long)c.hour, (long)c.minute];
+    float level = UIDevice.currentDevice.batteryLevel;
+    if (level >= 0) {
+        UIDeviceBatteryState st = UIDevice.currentDevice.batteryState;
+        BOOL charging = st == UIDeviceBatteryStateCharging || st == UIDeviceBatteryStateFull;
+        [text appendFormat:@" · %@%d %%", charging ? @"⚡" : @"", (int)lroundf(level * 100)];
+    }
+    if (sp_hot) [text appendString:sp_heat_on ? @" · heiß, 20 FPS" : @" · heiß"];
+    _status.text = text;
+    _status.textColor = sp_hot ? [UIColor colorWithRed:1 green:0.55 blue:0.3 alpha:0.95]
+                     : (level >= 0 && level < 0.2 ? [UIColor colorWithRed:1 green:0.4 blue:0.4 alpha:0.95]
+                                                  : [UIColor colorWithWhite:1 alpha:0.8]);
+    [self setNeedsLayout];
+}
+
+// ---- ⓘ: a tap arms it for the next touch over the game, a hold for every one until it's tapped again.
+// That touch moves the pointer where it lands and follows the finger (the game shows what's under it:
+// an item's, a buff's, a unit's tooltip) and clicks nothing; the pointer stays there after, so the
+// tooltip does too.
+
+- (void)sp_info_tap {
+    if (_info_locked || _info_armed) {
+        _info_locked = _info_armed = NO;
+    } else {
+        _info_armed = YES;
+    }
+    _info.on = _info_armed;
+}
+
+- (void)sp_info_lock {
+    _info_locked = _info_armed = YES;
+    _info.on = YES;
+    sp_touch_haptic();
+}
+
+- (UIView *)hitTest:(CGPoint)point withEvent:(UIEvent *)event {
+    UIView *v = [super hitTest:point withEvent:event];
+    if (!v && _info_armed && !self.hidden && !_editing && CGRectContainsPoint([self sp_game], point)) return self;
+    return v;
+}
+
+- (void)sp_info_point:(UITouch *)t {
+    CGPoint p = [t locationInView:self.superview];
+    sp_mouse_moved_to(sp_from_uikit(p), sp_motion_type(), NO);
+}
+
+- (void)touchesBegan:(NSSet<UITouch *> *)touches withEvent:(UIEvent *)event {
+    if (!_info_armed || _info_touch) return;
+    _info_touch = touches.anyObject;
+    [self sp_info_point:_info_touch];
+}
+
+- (void)touchesMoved:(NSSet<UITouch *> *)touches withEvent:(UIEvent *)event {
+    if (_info_touch && [touches containsObject:_info_touch]) [self sp_info_point:_info_touch];
+}
+
+- (void)touchesEnded:(NSSet<UITouch *> *)touches withEvent:(UIEvent *)event {
+    if (!_info_touch || ![touches containsObject:_info_touch]) return;
+    _info_touch = nil;
+    if (!_info_locked) {
+        _info_armed = NO;
+        _info.on = NO;
+    }
+}
+
+- (void)touchesCancelled:(NSSet<UITouch *> *)touches withEvent:(UIEvent *)event {
+    [self touchesEnded:touches withEvent:event];
+}
+
+// ---- the pages
+
+- (void)sp_load_pages {
+    NSUserDefaults *d = NSUserDefaults.standardUserDefaults;
+    _pages = [NSMutableArray array];
+    id saved = [d objectForKey:@"sp_touch_pages"];
+    if ([saved isKindOfClass:NSArray.class]) {
+        for (id page in saved) {
+            if (![page isKindOfClass:NSArray.class] || (NSInteger)_pages.count >= sp_max_pages) continue;
+            NSMutableArray *items = [NSMutableArray array];
+            for (id it in page)
+                if (sp_item_ok(it)) [items addObject:[it mutableCopy]];
+            [_pages addObject:items];
+        }
+    }
+    if (!_pages.count) {
+        for (NSInteger p = 1; p <= 2; p++) {
+            NSDictionary *lay = sp_old_layout(p);
+            NSMutableArray *items = [NSMutableArray array];
+            for (NSString *k in sp_default_kinds(p)) [items addObject:sp_item_from_old(k, lay)];
+            [_pages addObject:items];
+        }
+        [d setObject:_pages forKey:@"sp_touch_pages"];
+    }
+    if (![[d objectForKey:@"sp_touch_stick"] isKindOfClass:NSDictionary.class])
+        [d setObject:sp_item_from_old(@"stick", sp_old_layout(1)) forKey:@"sp_touch_stick"];
+    _page = [[d objectForKey:@"sp_touch_page"] integerValue];
+    if (_page < 1 || _page > (NSInteger)_pages.count) _page = 1;
+}
+
+- (void)sp_save_pages {
+    [NSUserDefaults.standardUserDefaults setObject:_pages forKey:@"sp_touch_pages"];
+    [NSUserDefaults.standardUserDefaults setInteger:_page forKey:@"sp_touch_page"];
+    [NSUserDefaults.standardUserDefaults synchronize];
+    sp_layout_backup();
+}
+
+// The settings' "Layout laden": the file's layout and settings, shown at once.
+- (BOOL)sp_layout_load {
+    if (!sp_layout_restore()) return NO;
+    sp_ts_load();
+    sp_fps_apply();
+    [self sp_load_pages];
+    [self sp_rebuild_items];
+    [self sp_page_look];
+    _sent = -1;
+    [self sp_update_hidden];
+    [self setNeedsLayout];
+    return YES;
+}
+
+- (void)didMoveToWindow {
+    [super didMoveToWindow];
+    if (!self.window) return;
+    for (UIGestureRecognizer *g in self.window.gestureRecognizers)
+        if ([g isKindOfClass:SPActivityRecognizer.class]) return;
+    SPActivityRecognizer *g = [[SPActivityRecognizer alloc] initWithTarget:nil action:NULL];
+    g.cancelsTouchesInView = NO;
+    g.delaysTouchesEnded = NO;
+    [self.window addGestureRecognizer:g];
+}
+
+- (NSMutableArray<NSMutableDictionary *> *)sp_items {
+    return _pages[_page - 1];
+}
+
+- (UIView *)sp_view_for:(NSDictionary *)it {
+    NSString *k = it[@"k"];
+    if ([k isEqualToString:@"look"]) return [[SPLookPad alloc] initWithFrame:CGRectZero];
+    if ([k isEqualToString:@"jump"]) return [[SPPadButton alloc] initWithTitle:@"Springen" mac:0x31 chars:@" "];
+    if ([k isEqualToString:@"interact"]) return [[SPPadButton alloc] initWithTitle:@"Inter-\nagieren" mac:0x67 chars:nil];
+    if ([k isEqualToString:@"fish"]) return [[SPPadButton alloc] initWithTitle:@"Angeln" mac:0x6F chars:nil];
+    if ([k isEqualToString:@"autorun"]) return [[SPPadButton alloc] initWithTitle:@"Auto-\nLauf" mac:0x6D chars:nil];
+    id t = it[@"t"], ch = it[@"ch"];
+    return [[SPPadButton alloc] initWithTitle:[t isKindOfClass:NSString.class] ? t : @"?"
+                                          mac:(unsigned short)[it[@"mac"] integerValue]
+                                        chars:[ch isKindOfClass:NSString.class] ? ch : nil];
+}
+
+// The page's controls anew: on a page change, an add, or a removal. The camera pads go under the
+// stick and the buttons, which come after it, so Auto Run takes a tap at the stick's edge.
+- (void)sp_rebuild_items {
+    [self sp_release_all];
+    for (UIView *v in _views) [v removeFromSuperview];
+    [_views removeAllObjects];
+    for (NSDictionary *it in [self sp_items]) {
+        UIView *v = [self sp_view_for:it];
+        [_views addObject:v];
+        if ([v isKindOfClass:SPLookPad.class]) [_pad insertSubview:v atIndex:0];
+        else [_pad addSubview:v];
+    }
+    [self sp_apply_settings];
+    [self sp_edit_look];
+    [self setNeedsLayout];
+}
+
+- (void)sp_page_look {
+    [_page_button sp_set_title:[NSString stringWithFormat:@"Seite %ld", (long)_page]];
+    _page_button.on = _page > 1;
+    [_banner sp_page:_page of:(NSInteger)_pages.count];
+}
+
+- (void)sp_go_page:(NSInteger)page {
+    NSInteger n = (NSInteger)_pages.count;
+    _page = ((page - 1) % n + n) % n + 1;
+    [NSUserDefaults.standardUserDefaults setInteger:_page forKey:@"sp_touch_page"];
+    [NSUserDefaults.standardUserDefaults synchronize];
+    [self sp_rebuild_items];
+    [self sp_page_look];
+    _sent = -1;   // a page change always tells the addon, even if it missed the last one
+    [self sp_update_hidden];
+}
+
+- (void)sp_next_page {
+    [self sp_go_page:_page + 1];
+}
+
+- (void)sp_prev_page {
+    [self sp_go_page:_page - 1];
+}
+
+// A new page starts as page 2 did: Auto Run, Interact, and the camera pad; the rest is added.
+- (void)sp_add_page {
+    if ((NSInteger)_pages.count >= sp_max_pages) return;
+    NSMutableArray *items = [NSMutableArray array];
+    for (NSString *k in sp_default_kinds(2)) [items addObject:[NSMutableDictionary dictionaryWithObject:k forKey:@"k"]];
+    [_pages addObject:items];
+    [self sp_save_pages];
+    [self sp_go_page:(NSInteger)_pages.count];
+}
+
+// The addon is put on this page first (the whole state again), then F5 takes its buttons on it, and
+// moves those on the pages after down one, as the pages here do.
+- (void)sp_delete_page {
+    if (_pages.count <= 1) return;
+    _sent = -1;
+    [self sp_update_hidden];
+    sp_virtual_tap(0x60, nil);
+    [_pages removeObjectAtIndex:_page - 1];
+    [self sp_save_pages];
+    [self sp_go_page:MIN(_page, (NSInteger)_pages.count)];
+}
+
+- (void)sp_release_all {
+    [_stick sp_release];
+    for (UIView *v in _views) {
+        if ([v isKindOfClass:SPPadButton.class]) [(SPPadButton *)v sp_release];
+        else if ([v isKindOfClass:SPLookPad.class]) [(SPLookPad *)v sp_release];
+    }
+}
+
+- (BOOL)sp_device {
+    return GCController.controllers.count > 0 || GCKeyboard.coalescedKeyboard != nil;
+}
+
+- (void)sp_devices_changed {
+    _on_with_device = NO;
+    [self sp_update_hidden];
+}
+
+- (void)sp_toggle {
+    if ([self sp_device]) {
+        _on_with_device = !_on_with_device;
+    } else {
+        _user_on = !_user_on;
+        [NSUserDefaults.standardUserDefaults setBool:_user_on forKey:@"sp_touch_on"];
+        [NSUserDefaults.standardUserDefaults synchronize];
+    }
+    [self sp_update_hidden];
+}
+
+// Shown while the settings are open or in edit mode too, to see what they change.
+- (void)sp_update_hidden {
+    BOOL device = [self sp_device];
+    sp_saver_ok = !device;
+    BOOL show = _panel != nil || _editing || (device ? _on_with_device : _user_on);
+    if (!show && !_pad.hidden) [self sp_release_all];
+    if (show == _pad.hidden) {
+        sp_stub_log([NSString stringWithFormat:@"touch controls: %s (controller or keyboard %d)",
+                     show ? "shown" : "hidden", device].UTF8String);
+    }
+    _pad.hidden = !show;
+    _toggle.on = device ? _on_with_device : _user_on;
+    self.hidden = !sp_touch_controls_wanted();
+    [self sp_send_state:show];
+}
+
+// ---- the page, for the SPTouch addon, by keys it binds: F6 (no page, edit mode off), F7 once per page
+// (page 3: F6 F7 F7 F7), then F8 in edit mode. The whole state each time, from F6 on, so a key the game
+// missed (one while the chat box had the keyboard) is put right by the next state. Sent on a change.
+- (void)sp_send_state:(BOOL)shown {
+    if (!sp_touch_controls_wanted()) return;
+    NSInteger page = shown ? _page : 0, state = page * 2 + (shown && _editing ? 1 : 0);
+    if (state == _sent) return;
+    _sent = state;
+    sp_virtual_tap(0x61, nil);
+    for (NSInteger i = 0; i < page; i++) sp_virtual_tap(0x62, nil);
+    if (state & 1) sp_virtual_tap(0x64, nil);
+}
+
+- (void)sp_resend_page {
+    _sent = -1;
+    [self sp_update_hidden];
+}
+
+// ---- edit mode
+
+- (void)sp_edit_toggle {
+    [self sp_edit:!_editing];
+}
+
+- (void)sp_edit:(BOOL)on {
+    if (on == _editing) return;
+    [self sp_release_all];
+    sp_edit_view = nil;
+    sp_edit_touch = nil;
+    _editing = on;
+    sp_touch_editing = on;
+    if (on) {
+        if (_panel) [self sp_settings_done];
+        __weak SPTouchControls *weak = self;
+        _banner = [[SPEditBanner alloc] initWithFrame:CGRectZero];
+        _banner.prev = ^{ [weak sp_prev_page]; };
+        _banner.next = ^{ [weak sp_next_page]; };
+        _banner.add_page = ^{ [weak sp_add_page]; };
+        _banner.delete_page = ^{ [weak sp_delete_page]; };
+        _banner.add_key = ^{ [weak sp_show_adder]; };
+        _banner.add_ability = ^{ sp_virtual_tap(0x76, nil); };   // F4: the addon's list, for a new button
+        _banner.fold = ^{ [weak sp_fold_banner]; };
+        _banner.reset = ^{ [weak sp_edit_reset]; };
+        _banner.done = ^{ [weak sp_edit:NO]; };
+        _banner.small = _banner_small;
+        [self addSubview:_banner];
+        // Under the controls, so one dragged onto it stays in sight; the grid under that.
+        _trash = [[SPTrashView alloc] initWithFrame:CGRectZero];
+        [self insertSubview:_trash belowSubview:_pad];
+        if (sp_ts[SP_TS_GRID]) {
+            _grid = [[SPGridView alloc] initWithFrame:self.bounds];
+            [self insertSubview:_grid belowSubview:_trash];
+        }
+        UIColor *line = [UIColor colorWithRed:1 green:0.78 blue:0.2 alpha:0.9];
+        _guide_x = [[UIView alloc] init];
+        _guide_y = [[UIView alloc] init];
+        for (UIView *g in @[ _guide_x, _guide_y ]) {
+            g.backgroundColor = line;
+            g.userInteractionEnabled = NO;
+            g.hidden = YES;
+            [self insertSubview:g belowSubview:_pad];
+        }
+    } else {
+        [_banner removeFromSuperview];
+        _banner = nil;
+        [_trash removeFromSuperview];
+        [_grid removeFromSuperview];
+        [_guide_x removeFromSuperview];
+        [_guide_y removeFromSuperview];
+        _trash = nil;
+        _grid = nil;
+        _guide_x = _guide_y = nil;
+        [self sp_hide_adder];
+    }
+    _gear.on = on;
+    [self sp_page_look];
+    [self sp_edit_look];
+    [self sp_update_hidden];
+    [self setNeedsLayout];
+}
+
+- (void)sp_fold_banner {
+    _banner_small = !_banner_small;
+    _banner.small = _banner_small;
+    [self setNeedsLayout];
+}
+
+- (void)sp_edit_look {
+    UIColor *hi = [UIColor colorWithRed:1 green:0.78 blue:0.2 alpha:0.95];
+    NSMutableArray<UIView *> *all = [NSMutableArray arrayWithObject:_stick];
+    [all addObjectsFromArray:_views];
+    for (UIView *v in all) {
+        CGFloat a = v == _stick ? 0.35 : [v isKindOfClass:SPLookPad.class] ? 0.28 : 0.4;   // their own borders
+        v.layer.borderWidth = _editing ? 3 : 1.5;
+        v.layer.borderColor = _editing ? hi.CGColor : [UIColor colorWithWhite:1 alpha:a].CGColor;
+    }
+}
+
+- (BOOL)sp_over_trash:(UIView *)v {
+    return _trash && v != _stick && CGRectContainsPoint(CGRectInset(_trash.frame, -10, -10), v.center);
+}
+
+// The grid's place nearest a dragged control's centre; or, within most of a grid step, another
+// control's centre line (across or down), drawn as a guide while it holds. Off in the settings: free.
+- (CGPoint)sp_snap:(UIView *)v to:(CGPoint)p {
+    _guide_x.hidden = _guide_y.hidden = YES;
+    if (!sp_ts[SP_TS_GRID]) return p;
+    CGRect g = [self sp_game];
+    if (g.size.height <= 0) return p;
+    CGFloat step = g.size.height / sp_grid_rows, nearX = step * 0.6, nearY = step * 0.6;
+    CGFloat lineX = NAN, lineY = NAN;
+    NSMutableArray<UIView *> *others = [NSMutableArray arrayWithObject:_stick];
+    [others addObjectsFromArray:_views];
+    for (UIView *o in others) {
+        if (o == v || o.hidden) continue;
+        CGPoint c = o.center;
+        if (fabs(c.x - p.x) < nearX) { nearX = fabs(c.x - p.x); lineX = c.x; }
+        if (fabs(c.y - p.y) < nearY) { nearY = fabs(c.y - p.y); lineY = c.y; }
+    }
+    CGPoint q;
+    q.x = isnan(lineX) ? g.origin.x + round((p.x - g.origin.x) / step) * step : lineX;
+    q.y = isnan(lineY) ? g.origin.y + round((p.y - g.origin.y) / step) * step : lineY;
+    if (!isnan(lineX)) {
+        _guide_x.frame = CGRectMake(q.x - 0.75, CGRectGetMinY(g), 1.5, g.size.height);
+        _guide_x.hidden = NO;
+    }
+    if (!isnan(lineY)) {
+        _guide_y.frame = CGRectMake(CGRectGetMinX(g), q.y - 0.75, g.size.width, 1.5);
+        _guide_y.hidden = NO;
+    }
+    return q;
+}
+
+- (void)sp_edit_moving:(UIView *)v {
+    _trash.hot = [self sp_over_trash:v];
+}
+
+// A drag's end: the new place, or onto the trash: off the page. A tap: the next size round (70 % to
+// 140 %), in place. The stick's own place, for every page.
+- (void)sp_edit_finished:(UIView *)v moved:(BOOL)moved {
+    BOOL trashed = moved && [self sp_over_trash:v];
+    _trash.hot = NO;
+    _guide_x.hidden = _guide_y.hidden = YES;
+    CGRect g = [self sp_game];
+    if (g.size.width <= 0 || g.size.height <= 0) return;
+    NSUserDefaults *d = NSUserDefaults.standardUserDefaults;
+    NSMutableDictionary *it;
+    if (v == _stick) {
+        id st = [d objectForKey:@"sp_touch_stick"];
+        it = [st isKindOfClass:NSDictionary.class] ? [st mutableCopy] : [NSMutableDictionary dictionary];
+    } else {
+        NSUInteger i = [_views indexOfObject:v];
+        if (i == NSNotFound || i >= [self sp_items].count) return;
+        if (trashed) {
+            sp_touch_haptic();
+            [[self sp_items] removeObjectAtIndex:i];
+            [self sp_save_pages];
+            [self sp_rebuild_items];
+            return;
+        }
+        it = [self sp_items][i];
+    }
+    CGFloat size = sp_item_size(it);
+    if (!moved) {
+        int near = 0;
+        for (int i = 1; i < 5; i++)
+            if (fabs(sp_edit_steps[i] - size) < fabs(sp_edit_steps[near] - size)) near = i;
+        size = sp_edit_steps[(near + 1) % 5];
+    }
+    sp_touch_haptic();
+    CGPoint c = v.center;
+    it[@"x"] = @((c.x - g.origin.x) / g.size.width);
+    it[@"y"] = @((c.y - g.origin.y) / g.size.height);
+    it[@"s"] = @(size);
+    if (v == _stick) {
+        [d setObject:it forKey:@"sp_touch_stick"];
+        [d synchronize];
+    } else {
+        [self sp_save_pages];
+    }
+    [self setNeedsLayout];
+}
+
+// Standard: this page's controls and the stick back to their default places and sizes.
+- (void)sp_edit_reset {
+    for (NSMutableDictionary *it in [self sp_items]) [it removeObjectsForKeys:@[ @"x", @"y", @"s" ]];
+    [NSUserDefaults.standardUserDefaults setObject:@{ @"k" : @"stick" } forKey:@"sp_touch_stick"];
+    [self sp_save_pages];
+    [self setNeedsLayout];
+}
+
+- (void)sp_show_adder {
+    if (_adder) return;
+    __weak SPTouchControls *weak = self;
+    _adder = [[SPAddPanel alloc] initWithFrame:CGRectZero];
+    _adder.picked = ^(NSDictionary *item) { [weak sp_add_item:item]; };
+    _adder.cancel = ^{ [weak sp_hide_adder]; };
+    [self addSubview:_adder];
+    [self setNeedsLayout];
+}
+
+- (void)sp_hide_adder {
+    [_adder removeFromSuperview];
+    _adder = nil;
+}
+
+// A control with a place of its own (Jump, Interact, …) goes there; a key, to the middle of the right
+// half, a little apart from the one before, to be dragged on from there.
+- (void)sp_add_item:(NSDictionary *)item {
+    [self sp_hide_adder];
+    NSMutableDictionary *it = [item mutableCopy];
+    NSMutableArray *items = [self sp_items];
+    if ([it[@"k"] isEqualToString:@"key"]) {
+        NSUInteger n = items.count;
+        it[@"x"] = @(0.55 + 0.07 * (n % 4));
+        it[@"y"] = @(0.40 + 0.14 * ((n / 4) % 3));
+    }
+    [items addObject:it];
+    [self sp_save_pages];
+    [self sp_rebuild_items];
+}
+
+- (CGRect)sp_game {
+    CGRect g = sp_game_rect();
+    return CGRectIsEmpty(g) ? self.bounds : g;
+}
+
+// ---- settings
+
+- (void)sp_apply_settings {
+    [self sp_status_update];
+    [_stick sp_release];   // a held key from the old side mode goes up as the key it was
+    _pad.alpha = sp_ts_alpha[sp_ts[SP_TS_OPACITY]];
+    for (UIView *v in _views) {
+        if (![v isKindOfClass:SPLookPad.class]) continue;
+        [(SPLookPad *)v sp_relabel];
+        if (!sp_ts[SP_TS_LOOK]) [(SPLookPad *)v sp_release];
+        v.hidden = !sp_ts[SP_TS_LOOK];
+    }
+    [self setNeedsLayout];
+}
+
+- (void)sp_settings {
+    if (_panel) {
+        [self sp_settings_done];
+        return;
+    }
+    if (_editing) [self sp_edit:NO];
+    _panel = [[SPSettingsPanel alloc] initWithFrame:CGRectZero];
+    __weak SPTouchControls *weak = self;
+    _panel.changed = ^{ [weak sp_apply_settings]; };
+    _panel.load = ^BOOL { return [weak sp_layout_load]; };
+    _panel.done = ^{ [weak sp_settings_done]; };
+    _panel.edit = ^{ [weak sp_edit:YES]; };
+    [self addSubview:_panel];
+    _gear.on = YES;
+    [self sp_update_hidden];
+    [self setNeedsLayout];
+}
+
+- (void)sp_settings_done {
+    [_panel removeFromSuperview];
+    _panel = nil;
+    _gear.on = NO;
+    [self sp_update_hidden];
+}
+
+- (void)sp_keyboard:(BOOL)chat {
+    if (_sink.isFirstResponder) [_sink sp_close];
+    else [_sink sp_open:chat];
+}
+
+- (void)sp_keyboard_changed:(BOOL)open {
+    _kbd.on = open;
+}
+
+- (void)sp_keyboard_hidden {
+    if (_sink.isFirstResponder) return;
+    _kbd.on = NO;
+    if (!self.superview.isFirstResponder) [self.superview becomeFirstResponder];
+}
+
+// The strip's buttons, for the root view's pointInside: (the strip is outside the game, where the root
+// view takes no touch).
+- (BOOL)sp_claims:(CGPoint)p {
+    if (self.hidden) return NO;
+    for (UIView *v in @[ _toggle, _page_button, _gear, _map, _esc, _kbd, _info ])
+        if (!v.hidden && [v pointInside:[self convertPoint:p toView:v] withEvent:nil]) return YES;
+    return NO;
+}
+
+// Placed from the game rect (the window less the Dynamic Island's strip), sized from its height, so
+// they sit the same on every iPhone and iPad, times the settings' sizes; then each item's own place
+// and size from edit mode. The defaults, for a thumb: the stick lower left with Auto Run above it, and
+// on the right Interact, the one used most, biggest and lowest, where the thumb rests, with Fishing to
+// its left, Jump above it, and the camera pad in the corner between. Well clear of the screen's edges:
