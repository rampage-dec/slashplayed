+@implementation SPKeyBar
+- (void)layoutSubviews {
+    [super layoutSubviews];
+    UIEdgeInsets s = self.safeAreaInsets;
+    CGRect b = self.bounds;
+    CGFloat x = b.origin.x + s.left + 8, h = b.size.height, end = CGRectGetMaxX(b) - s.right - 8;
+    for (UIView *v in _left) {
+        v.frame = CGRectMake(x, 5, 58, h - 10);
+        x += 64;
+    }
+    _right.frame = CGRectMake(end - 80, 5, 80, h - 10);
+    _preview.frame = CGRectMake(x + 6, 0, MAX(0, end - 86 - x - 6), h);
+}
+@end
