+// A button in the strip beside the game: a tap, and optionally a hold (half a second).
+@interface SPStripButton : UIView
+- (instancetype)initWithTitle:(NSString *)title symbol:(NSString *)symbol;
+@property(nonatomic, copy) void (^tap)(void);
+@property(nonatomic, copy) void (^hold)(void);
