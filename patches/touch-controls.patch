+// The title and the tabs at the top, Bearbeiten and Fertig at the bottom, the tab's rows between, scrolled
+// when they don't fit.
+- (void)layoutSubviews {
+    [super layoutSubviews];
+    CGRect b = self.bounds;
+    CGFloat pad = 14, w = b.size.width - 2 * pad, foot = 44;
+    BOOL narrow = w < 560;   // the title over the tabs, not beside them
+    CGFloat tw = narrow ? w : MIN(170, w * 0.26);
+    _title.frame = CGRectMake(pad, 8, tw, 28);
+    _tabs.frame = narrow ? CGRectMake(pad, 38, w, 30) : CGRectMake(pad + tw + 8, 8, w - tw - 8, 30);
+    CGFloat top = CGRectGetMaxY(_tabs.frame) + 8;
+    _scroll.frame = CGRectMake(pad, top, w, MAX(0, b.size.height - top - foot - 6));
+    _editButton.frame = CGRectMake(pad, b.size.height - foot, 130, foot - 8);
+    _addonButton.frame = CGRectMake(CGRectGetMidX(b) - 80, b.size.height - foot, 160, foot - 8);
+    _finish.frame = CGRectMake(CGRectGetMaxX(b) - pad - 130, b.size.height - foot, 130, foot - 8);
+    CGFloat y = 2;
+    for (UIView *v in _items) {
+        CGFloat h;
+        if ([v isKindOfClass:SPPanelRow.class]) {
+            h = [(SPPanelRow *)v sp_height];
+        } else if (v == _profileBox) {
+            // Four to a row, every profile's button and + Neues Profil last.
+            int cols = w >= 500 ? 4 : 3, n = (int)_profileButtons.count;
+            CGFloat gap = 6, bw = (w - (cols - 1) * gap) / cols, bh = 34;
+            for (int i = 0; i < n; i++)
+                _profileButtons[(NSUInteger)i].frame = CGRectMake((i % cols) * (bw + gap), (i / cols) * (bh + gap), bw, bh);
+            h = ((n + cols - 1) / cols) * (bh + gap);
+        } else if (v == _actions) {
+            NSArray<UIView *> *all = @[ _saveButton, _loadButton, _reset ];
+            CGFloat gap = 6, bw = (w - 2 * gap) / 3;
+            for (NSUInteger i = 0; i < all.count; i++) all[i].frame = CGRectMake(i * (bw + gap), 4, bw, 34);
+            h = 42;
+        } else {
+            h = ceil([v sizeThatFits:CGSizeMake(w, 1000)].height) + 4;
+        }
+        v.frame = CGRectMake(0, y, w, h);
+        y += h + 4;
+    }
+    _scroll.contentSize = CGSizeMake(w, y);
+    _chooser.frame = CGRectInset(b, 6, 6);
+    if (_chooser) [self bringSubviewToFront:_chooser];
+}
+@end
