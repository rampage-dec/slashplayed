+// The camera pad's double or triple tap: every action as a button, over the settings; a tap picks it.
+@interface SPGestureChooser : UIView
+@property(nonatomic, copy) void (^picked)(int index);   // -1: closed without a pick
+- (instancetype)initWithWhich:(int)which;
+@end
+
+@implementation SPGestureChooser {
+    UILabel *_title;
+    NSMutableArray<UIButton *> *_buttons;
