+
+- (void)setGame:(CGRect)game {
+    if (CGRectEqualToRect(game, _game)) return;
+    _game = game;
+    [self setNeedsDisplay];
+}
+
+- (void)drawRect:(CGRect)rect {
+    CGRect g = _game;
+    if (g.size.height <= 0) return;
+    CGFloat step = g.size.height / sp_grid_rows;
+    [[UIColor colorWithWhite:1 alpha:0.25] setFill];
+    for (CGFloat y = g.origin.y; y <= CGRectGetMaxY(g) + 0.5; y += step)
+        for (CGFloat x = g.origin.x; x <= CGRectGetMaxX(g) + 0.5; x += step)
+            UIRectFill(CGRectMake(x - 1, y - 1, 2, 2));
+}
