+    return CGRectIsEmpty(g) ? self.bounds : g;
+}
+
+// ---- pages that show by themselves, layouts per character: what the SPTouch addon says (sp_game_state)
+//
+// Each page can have a trigger (edit mode's Auto). The first page whose trigger holds now is shown, in
+// this order: the world map open, the form or stance, combat, a flight, mounted; when none holds any more,
+// the page from before. The player turning the page by hand meanwhile wins until the trigger changes. Not
+// while editing or in the settings, not while typing (the page goes to the addon as F-keys, which a text
+// box with the keyboard would take as text), and not while a finger is on one of the page's controls (a
+// moment later then); the stick keeps its thumb, so a walk goes on through it.
+
+// The page a trigger asks for now (0: none), and the trigger.
+- (NSInteger)sp_auto_target:(NSString **)key {
+    if (!sp_gs_fresh()) return 0;
+    int f = sp_gs.flags;
+    NSMutableArray<NSString *> *now = [NSMutableArray array];
+    if (f & SP_GS_MAP) [now addObject:@"karte"];
+    if (sp_gs.form > 0 && sp_gs.form < 255) [now addObject:[NSString stringWithFormat:@"form:%d", sp_gs.form]];
+    if (f & SP_GS_COMBAT) [now addObject:@"kampf"];
+    if (f & SP_GS_TAXI) [now addObject:@"flug"];
+    else if (f & SP_GS_MOUNT) [now addObject:@"reiten"];
+    for (NSString *k in now) {
+        NSUInteger i = [_page_auto indexOfObject:k];
+        if (i != NSNotFound && i < _pages.count) {
+            if (key) *key = k;
+            return (NSInteger)i + 1;
+        }
+    }
+    return 0;
+}
+
+- (void)sp_auto_update {
+    if (!sp_ts[SP_TS_AUTOPAGE] || _editing || _panel || _pad.hidden || self.hidden) return;
+    NSString *key = nil;
+    NSInteger target = [self sp_auto_target:&key];
+    if (target) {
+        if (!_auto_page) {
+            _home_page = _page;
+            _auto_held = NO;
+        } else if (![key isEqualToString:_auto_key]) {
+            _auto_held = NO;   // another trigger: the page turned by hand under the last one doesn't hold
+        }
+        _auto_page = target;
+        _auto_key = key;
+        _auto_want = _auto_held ? 0 : target;
+    } else if (_auto_page) {
+        // Back to the page from before, unless the player has turned away from the trigger's.
+        _auto_want = !_auto_held && _page == _auto_page ? _home_page : 0;
+        _auto_page = 0;
+        _auto_key = nil;
+        _auto_held = NO;
+    }
+    [self sp_auto_apply];
+}
+
+- (void)sp_auto_apply {
+    NSInteger want = _auto_want;
+    if (!want || want == _page || want > (NSInteger)_pages.count || _editing || _panel) {
+        _auto_want = 0;
+        return;
+    }
+    if ([self sp_page_busy] || sp_touch_keyboard_open() || sp_keyboard_up()) {
+        if (_auto_retry) return;
+        _auto_retry = YES;
+        __weak SPTouchControls *weak = self;
+        dispatch_after(dispatch_time(DISPATCH_TIME_NOW, (int64_t)(0.4 * NSEC_PER_SEC)), dispatch_get_main_queue(), ^{
+            SPTouchControls *me = weak;
+            if (!me) return;
+            me->_auto_retry = NO;
+            [me sp_auto_apply];
+        });
+        return;
+    }
+    _auto_want = 0;
+    [self sp_go_page:want automatic:YES];
+}
+
+// Edit mode's Auto for the page shown: a trigger is one page's only (another page with it gives it up).
+- (void)sp_set_page_auto:(NSString *)key {
+    if (_page < 1 || _page > (NSInteger)_page_auto.count) return;
+    NSString *k = key ?: @"";
+    if (k.length)
+        for (NSUInteger i = 0; i < _page_auto.count; i++)
+            if ([_page_auto[i] isEqualToString:k]) _page_auto[i] = @"";
+    _page_auto[(NSUInteger)_page - 1] = k;
+    [self sp_save_pages];
+    [self sp_page_look];
+    if (!k.length) return;
+    if (!sp_ts[SP_TS_AUTOPAGE]) [self sp_note:@"Seiten automatisch ist aus: Zahnrad → Layout"];
+    else if (!sp_gs_known()) [self sp_note:@"Dafür braucht es das SPTouch-Addon ab Version 62"];
+}
+
+// Another character in the game (or the first since the app started): with Profil je Charakter, the
+// profile it had last; one with none yet gets the active one as its own.
+- (void)sp_character_changed {
+    NSString *who = sp_gs_who();
+    if (!sp_ts[SP_TS_CHARPROF] || !who) return;
+    NSString *target = sp_prof_for(who), *active = sp_prof_active();
+    if (target && !sp_prof_exists(target)) target = nil;
+    if (!target) {
+        if (active && sp_prof_exists(active)) {
+            sp_prof_link(who, active);
+            sp_layout_backup();
+        }
+        return;
+    }
+    if ([target isEqualToString:active]) return;
+    if ([self sp_profile_load:target link:NO])
+        [self sp_note:[NSString stringWithFormat:@"Layout „%@“ für %@", target, sp_gs_name() ?: who]];
+}
+
+// The addon's word, at each change (sp_touch_strip_frame).
+- (void)sp_game_state_changed:(BOOL)who {
+    if (who) [self sp_character_changed];
+    [self sp_auto_update];
+    if (_banner) [_banner sp_auto:[self sp_page_auto_key] klass:sp_gs.klass];
+    [_panel sp_sync];
+}
+
+// The Akku tab's what holds now: the frame limit and why, the battery's use, how warm, and the addon.
+- (NSString *)sp_live_text {
+    NSMutableString *t = [NSMutableString stringWithFormat:@"Jetzt: %@", sp_limit_text()];
+    if (sp_saver_after_ns) [t appendFormat:@", %llu s ohne Tippen: 10 FPS", (unsigned long long)(sp_saver_after_ns / 1000000000ull)];
+    float level = UIDevice.currentDevice.batteryLevel;
+    UIDeviceBatteryState st = UIDevice.currentDevice.batteryState;
+    BOOL charging = st == UIDeviceBatteryStateCharging || st == UIDeviceBatteryStateFull;
+    if (level >= 0) {
+        [t appendFormat:@"\nAkku: %d %%", (int)lroundf(level * 100)];
+        double rate = charging ? -1 : sp_batt_rate(level);
+        if (charging) [t appendString:@", lädt"];
+        else if (rate > 0.5) {
+            int mins = (int)(level * 100 / rate * 60);
+            [t appendFormat:@", −%.0f %% pro Stunde, noch etwa %d h %02d min", rate, mins / 60, mins % 60];
+        } else {
+            [t appendString:@", der Verbrauch steht nach ein paar Minuten ohne Ladekabel hier"];
+        }
+    }
+    [t appendFormat:@" · Gerät: %@", sp_thermal_word()];
+    if (!sp_gs_known()) {
+        [t appendString:@"\nSPTouch-Addon: noch nichts gehört (ab Version 62, im Spiel)"];
+    } else if (!sp_gs_fresh()) {
+        [t appendString:@"\nSPTouch-Addon: gerade still (Ladebildschirm oder Oberfläche aus)"];
+    } else {
+        int f = sp_gs.flags;
+        [t appendFormat:@"\nSPTouch-Addon: verbunden, %@, Stufe %d%@%@%@", sp_gs_name() ?: @"?", sp_gs.level,
+                        (f & SP_GS_COMBAT) ? @", im Kampf" : @"", (f & SP_GS_TAXI) ? @", auf Flugroute"
+                        : (f & SP_GS_MOUNT) ? @", reitet" : @"", (f & SP_GS_REST) ? @", erholt sich" : @""];
+    }
+    return t;
+}
