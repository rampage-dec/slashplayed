+// ---- the controls' container: the stick (on every page), the page's controls, the strip
+//
+// What each page holds: NSUserDefaults "sp_touch_pages", an array of pages, each an array of items
+// { k: the kind, x and y: its centre as fractions of the game rect (absent: the kind's default place),
+// s: a size factor (absent: 1), and for a key mac (its Mac key code), ch (what it types), t (title) }.
+// Kinds: jump, interact, fish, autorun, look (the camera pad), key. The stick is on every page, its
+// place "sp_touch_stick", the same kind of dictionary. Up to nine pages: the addon has nine page frames.
+
+static const NSInteger sp_max_pages = 9;
+
+static NSArray<NSString *> *sp_default_kinds(NSInteger page) {
+    return page == 1 ? @[ @"autorun", @"interact", @"fish", @"jump", @"look" ] : @[ @"autorun", @"interact", @"look" ];
+}
+
+static BOOL sp_item_ok(id it) {
+    if (![it isKindOfClass:NSDictionary.class]) return NO;
+    id k = it[@"k"];
+    if (![k isKindOfClass:NSString.class]) return NO;
+    if ([k isEqualToString:@"key"]) return [it[@"mac"] isKindOfClass:NSNumber.class];
+    return [@[ @"jump", @"interact", @"fish", @"autorun", @"look" ] containsObject:k];
+}
+
+static CGFloat sp_item_size(NSDictionary *it) {
+    id s = it[@"s"];
+    return [s isKindOfClass:NSNumber.class] ? MIN(2, MAX(0.5, [s doubleValue])) : 1;
+}
+
+static CGPoint sp_item_at(NSDictionary *it, CGPoint def, CGRect g) {
+    id x = it[@"x"], y = it[@"y"];
+    if (![x isKindOfClass:NSNumber.class] || ![y isKindOfClass:NSNumber.class]) return def;
+    return CGPointMake(g.origin.x + MIN(1, MAX(0, [x doubleValue])) * g.size.width,
+                       g.origin.y + MIN(1, MAX(0, [y doubleValue])) * g.size.height);
+}
+
+// The two fixed pages before, with what edit mode placed on them (name: [x, y, size]).
+static NSDictionary *sp_old_layout(NSInteger page) {
+    id d = [NSUserDefaults.standardUserDefaults objectForKey:page == 2 ? @"sp_touch_layout_2" : @"sp_touch_layout_1"];
+    return [d isKindOfClass:NSDictionary.class] ? d : @{};
+}
+
+static NSMutableDictionary *sp_item_from_old(NSString *kind, NSDictionary *lay) {
+    NSMutableDictionary *it = [NSMutableDictionary dictionary];
+    it[@"k"] = kind;
+    id o = lay[kind];
+    if ([o isKindOfClass:NSArray.class] && [o count] == 3) {
+        BOOL numbers = YES;
+        for (id n in o)
+            if (![n isKindOfClass:NSNumber.class]) numbers = NO;
+        if (numbers) {
+            it[@"x"] = o[0];
+            it[@"y"] = o[1];
+            it[@"s"] = o[2];
+        }
+    }
+    return it;
+}
