+#if !TARGET_OS_VISION
+// ---- touch controls (iPhone and iPad): a stick to walk, Jump, and an action button
+//
+// For playing with neither a keyboard nor a game controller. Addons can't move the character (the
+// game's movement functions are protected), so the stick lives here. Up and down press W and S (the
+// game's forward and back keys) as a keyboard would, through the same event queue sp_key fills. Left
+// and right turn the way a right-button drag does (mouselook), at a speed that follows how far the
+// stick is pushed: the keyboard's A and D turn at one slow, fixed rate.
+//
+// The buttons press keys: Jump is Space; Interact F11, Fishing F12 and Auto Run F10, which the SPTouch
+// addon binds with priority (interact with the soft target; cast Fishing, then land the catch; toggle
+// autorun). Without the addon those keys are the game's own (bags). Not F13: on a Mac that is Print
+// Screen, which the game names PRINTSCREEN and takes a screenshot with. Two-finger drags beside the
+// controls still turn the camera, as before, since these views take only their own touches.
+//
+// Hidden while a game controller or a hardware keyboard is connected (those have their own keys), and
+// off altogether with SP_TOUCH_CONTROLS=0 or NSUserDefaults "sp_touch_controls" = NO.
+
+static BOOL sp_touch_controls_wanted(void) {
+    const char *env = getenv("SP_TOUCH_CONTROLS");
+    if (env) return atoi(env) != 0;
+    id v = [NSUserDefaults.standardUserDefaults objectForKey:@"sp_touch_controls"];
+    return v ? [v boolValue] : YES;
+}
+
+// A key press with no UIKey behind it: the Mac key code and the characters it types.
+static void sp_virtual_key(unsigned short mac, NSString *chars, BOOL down) {
+    SPEvent *e = sp_event(down ? SPKeyDown : SPKeyUp);
+    e->keyCode = mac;
+    unichar fc = sp_function_char(mac);
+    if (fc) {
+        e->characters = e->charactersIgnoringModifiers = [NSString stringWithCharacters:&fc length:1];
+        if (fc >= 0xF700) e->modifierFlags |= SPFunction;
+    } else {
+        e->characters = e->charactersIgnoringModifiers = chars ?: @"";
+    }
+    sp_post(e);
+}
+
+// W and S as Mac key codes (kVK_ANSI_W, kVK_ANSI_S) and what they type.
+static const unsigned short sp_stick_mac[2] = { 0x0D, 0x01 };
+static NSString *const sp_stick_chars[2] = { @"w", @"s" };
+
+// Turning, in points of right-button drag per 1/60 s at full deflection (SP_STICK_TURN overrides).
+static CGFloat sp_stick_turn_speed(void) {
+    static CGFloat speed;
+    if (!speed) speed = getenv("SP_STICK_TURN") ? atof(getenv("SP_STICK_TURN")) : 12;
+    if (speed <= 0) speed = 12;
+    return speed;
+}
+
+@interface SPStickView : UIView
+- (void)sp_release;
+@end
+
+@implementation SPStickView {
+    UITouch *_touch;        // the thumb on the stick; nil when free
+    UIView *_knob;
+    BOOL _down[2];          // W S, as last pressed
+    CGFloat _turn;          // -1 ... 1, left to right, after the dead zone and curve
+    BOOL _turning;          // the right button is down for our mouselook
+    NSTimer *_link;         // drives the turn while the stick is held sideways (60 Hz; NSTimer, as
+                            // libspAppKit doesn't link QuartzCore, CADisplayLink's home)
+    NSTimeInterval _last;
+}
+
+- (instancetype)initWithFrame:(CGRect)frame {
+    if (!(self = [super initWithFrame:frame])) return nil;
+    self.backgroundColor = [UIColor colorWithWhite:1 alpha:0.10];
+    self.layer.borderColor = [UIColor colorWithWhite:1 alpha:0.35].CGColor;
+    self.layer.borderWidth = 1.5;
+    _knob = [[UIView alloc] init];
+    _knob.userInteractionEnabled = NO;
+    _knob.backgroundColor = [UIColor colorWithWhite:1 alpha:0.35];
+    [self addSubview:_knob];
+    return self;
+}
+
+- (void)layoutSubviews {
+    [super layoutSubviews];
+    CGFloat r = self.bounds.size.width / 2, k = r * 0.8;
+    self.layer.cornerRadius = r;
+    _knob.bounds = CGRectMake(0, 0, k, k);
+    _knob.layer.cornerRadius = k / 2;
+    if (!_touch) _knob.center = CGPointMake(r, r);
+}
+
+// A catch area wider than the ring, so a thumb landing a little outside still takes the stick.
+- (BOOL)pointInside:(CGPoint)p withEvent:(UIEvent *)event {
+    CGFloat r = self.bounds.size.width / 2;
+    return hypot(p.x - r, p.y - r) <= r * 1.35;
+}
+
+- (void)sp_key:(int)i down:(BOOL)down {
+    if (_down[i] == down) return;
+    _down[i] = down;
+    sp_virtual_key(sp_stick_mac[i], sp_stick_chars[i], down);
+}
+
+// Mouselook from the stick: the right button goes down over the world, the turn comes as
+// right-button drags each frame, and the button comes up when the stick is back in the middle. The
+// first drag goes out with the press, so the game never sees a right click (that would interact with
+// whatever is under the pointer). A right button some finger already holds is left to that finger.
+- (void)sp_turn_step:(CFTimeInterval)dt {
+    if (!_turn) return;
+    if (!_turning) {
+        if (sp_mouse_buttons) return;  // a finger is clicking or dragging: don't fight it
+        // Over the world, above the character, where no UI frame sits: a right press over an action
+        // button, a window or the minimap would go to that frame instead of turning. sp_mouse_button
+        // moves the pointer there first. Window coordinates: origin bottom left.
+        CGRect g = sp_game_rect();
+        sp_mouse_button(1, YES, CGPointMake(g.size.width / 2, g.size.height * 0.62));
+        _turning = YES;
+    }
+    CGFloat dx = _turn * sp_stick_turn_speed() * (dt > 0 ? MIN(dt, 0.1) * 60 : 1);
+    sp_post_motion(SPRightMouseDragged, dx, 0);
+}
+
+- (void)sp_turn_end {
+    [_link invalidate];
+    _link = nil;
+    if (_turning) {
+        _turning = NO;
+        sp_mouse_button(1, NO, sp_pointer);
+    }
+}
+
+- (void)sp_tick {
+    NSTimeInterval now = NSProcessInfo.processInfo.systemUptime, dt = _last ? now - _last : 1.0 / 60;
+    _last = now;
+    [self sp_turn_step:dt];
+}
+
+- (void)sp_follow:(CGPoint)p {
+    CGFloat r = self.bounds.size.width / 2;
+    if (r <= 0) return;
+    CGFloat dx = (p.x - r) / r, dy = (p.y - r) / r, len = hypot(dx, dy);
+    if (len > 1) { dx /= len; dy /= len; }
+    _knob.center = CGPointMake(r + dx * r * 0.6, r + dy * r * 0.6);
+    // Forward and back past a quarter of the way.
+    [self sp_key:0 down:dy < -0.25];
+    [self sp_key:1 down:dy > 0.25];
+    // Turning: a dead zone of 0.2, then a curve, so a small push turns finely and a full one fast.
+    CGFloat a = fabs(dx) < 0.2 ? 0 : (fabs(dx) - 0.2) / 0.8;
+    _turn = (dx < 0 ? -1 : 1) * a * a;
+    if (_turn) {
+        if (!_link) {
+            __weak SPStickView *weak = self;
+            _link = [NSTimer timerWithTimeInterval:1.0 / 60 repeats:YES block:^(NSTimer *t) { [weak sp_tick]; }];
+            [NSRunLoop.mainRunLoop addTimer:_link forMode:NSRunLoopCommonModes];
+            _last = 0;
+            [self sp_turn_step:1.0 / 60];  // the press and its first drag together, right now
+        }
+    } else {
+        [self sp_turn_end];
+    }
+}
+
+- (void)sp_release {
+    for (int i = 0; i < 2; i++) [self sp_key:i down:NO];
+    _turn = 0;
+    [self sp_turn_end];
+    _touch = nil;
+    CGFloat r = self.bounds.size.width / 2;
+    _knob.center = CGPointMake(r, r);
+}
+
+- (void)touchesBegan:(NSSet<UITouch *> *)touches withEvent:(UIEvent *)event {
+    if (_touch) return;
+    _touch = touches.anyObject;
+    [self sp_follow:[_touch locationInView:self]];
+}
+
+- (void)touchesMoved:(NSSet<UITouch *> *)touches withEvent:(UIEvent *)event {
+    if (_touch && [touches containsObject:_touch]) [self sp_follow:[_touch locationInView:self]];
+}
+
+- (void)touchesEnded:(NSSet<UITouch *> *)touches withEvent:(UIEvent *)event {
+    if (_touch && [touches containsObject:_touch]) [self sp_release];
+}
+
+- (void)touchesCancelled:(NSSet<UITouch *> *)touches withEvent:(UIEvent *)event {
+    [self touchesEnded:touches withEvent:event];
+}
+@end
+
+// A round button holding one key down while touched.
+@interface SPPadButton : UIView
+- (instancetype)initWithTitle:(NSString *)title mac:(unsigned short)mac chars:(NSString *)chars;
+- (void)sp_release;
+@end
+
+@implementation SPPadButton {
+    UITouch *_touch;
+    UILabel *_label;
+    unsigned short _mac;
+    NSString *_chars;
+}
+
+- (instancetype)initWithTitle:(NSString *)title mac:(unsigned short)mac chars:(NSString *)chars {
+    if (!(self = [super initWithFrame:CGRectZero])) return nil;
+    _mac = mac;
+    _chars = [chars copy];
+    self.backgroundColor = [UIColor colorWithWhite:1 alpha:0.12];
+    self.layer.borderColor = [UIColor colorWithWhite:1 alpha:0.4].CGColor;
+    self.layer.borderWidth = 1.5;
+    _label = [[UILabel alloc] init];
+    _label.text = title;
+    _label.textColor = [UIColor colorWithWhite:1 alpha:0.9];
+    _label.font = [UIFont boldSystemFontOfSize:14];
+    _label.numberOfLines = 2;
+    _label.textAlignment = NSTextAlignmentCenter;
+    _label.adjustsFontSizeToFitWidth = YES;
+    _label.minimumScaleFactor = 0.6;
+    _label.userInteractionEnabled = NO;
+    [self addSubview:_label];
+    return self;
+}
+
+- (void)layoutSubviews {
+    [super layoutSubviews];
+    CGFloat d = self.bounds.size.width;
+    self.layer.cornerRadius = d / 2;
+    _label.font = [UIFont boldSystemFontOfSize:MAX(12, d * 0.17)];
+    _label.frame = CGRectInset(self.bounds, d * 0.1, d * 0.1);
+}
+
+- (BOOL)pointInside:(CGPoint)p withEvent:(UIEvent *)event {
+    CGFloat r = self.bounds.size.width / 2;
+    return hypot(p.x - r, p.y - r) <= r * 1.2;
+}
+
+- (void)touchesBegan:(NSSet<UITouch *> *)touches withEvent:(UIEvent *)event {
+    if (_touch) return;
+    _touch = touches.anyObject;
+    self.backgroundColor = [UIColor colorWithWhite:1 alpha:0.35];
+    sp_virtual_key(_mac, _chars, YES);
+}
+
+- (void)touchesEnded:(NSSet<UITouch *> *)touches withEvent:(UIEvent *)event {
+    if (_touch && [touches containsObject:_touch]) [self sp_release];
+}
+
+- (void)touchesCancelled:(NSSet<UITouch *> *)touches withEvent:(UIEvent *)event {
+    [self touchesEnded:touches withEvent:event];
+}
+
+- (void)sp_release {
+    if (!_touch) return;
+    _touch = nil;
+    self.backgroundColor = [UIColor colorWithWhite:1 alpha:0.12];
+    sp_virtual_key(_mac, _chars, NO);
+}
+@end
+
+// The controls' container: as large as the root view, but it takes no touch itself, so everything
+// outside the stick and the buttons goes to the root view underneath, as before.
+@interface SPTouchControls : UIView
+@end
+
+@implementation SPTouchControls {
+    SPStickView *_stick;
+    SPPadButton *_interact, *_fish, *_jump, *_autorun;
+}
+
+- (instancetype)initWithFrame:(CGRect)frame {
+    if (!(self = [super initWithFrame:frame])) return nil;
+    self.backgroundColor = UIColor.clearColor;
+    self.multipleTouchEnabled = YES;
+    _stick = [[SPStickView alloc] initWithFrame:CGRectZero];
+    _interact = [[SPPadButton alloc] initWithTitle:@"Inter-\nagieren" mac:0x67 chars:nil];  // F11
+    _fish = [[SPPadButton alloc] initWithTitle:@"Angeln" mac:0x6F chars:nil];               // F12
+    _jump = [[SPPadButton alloc] initWithTitle:@"Springen" mac:0x31 chars:@" "];            // Space
+    _autorun = [[SPPadButton alloc] initWithTitle:@"Auto-\nLauf" mac:0x6D chars:nil];        // F10
+    for (UIView *v in @[ _stick, _interact, _fish, _jump, _autorun ]) [self addSubview:v];
+    __weak SPTouchControls *weak = self;
+    void (^update)(NSNotification *) = ^(NSNotification *n) { [weak sp_update_hidden]; };
+    for (NSNotificationName name in @[ GCControllerDidConnectNotification, GCControllerDidDisconnectNotification,
+                                       GCKeyboardDidConnectNotification, GCKeyboardDidDisconnectNotification ])
+        [NSNotificationCenter.defaultCenter addObserverForName:name object:nil queue:NSOperationQueue.mainQueue
+                                                    usingBlock:update];
+    // Leaving the app mid-walk lifts every key, so the character doesn't keep running.
+    [NSNotificationCenter.defaultCenter addObserverForName:UIApplicationWillResignActiveNotification object:nil
+                                                     queue:NSOperationQueue.mainQueue
+                                                usingBlock:^(NSNotification *n) { [weak sp_release_all]; }];
+    [self sp_update_hidden];
+    return self;
+}
+
+- (UIView *)hitTest:(CGPoint)point withEvent:(UIEvent *)event {
+    UIView *v = [super hitTest:point withEvent:event];
+    return v == self ? nil : v;
+}
+
+- (void)sp_release_all {
+    [_stick sp_release];
+    for (SPPadButton *b in @[ _interact, _fish, _jump, _autorun ]) [b sp_release];
+}
+
+- (void)sp_update_hidden {
+    BOOL pad = GCController.controllers.count > 0;
+    BOOL keyboard = GCKeyboard.coalescedKeyboard != nil;
+    BOOL hide = pad || keyboard || !sp_touch_controls_wanted();
+    if (hide && !self.hidden) [self sp_release_all];
+    if (hide != self.hidden) {
+        sp_stub_log([NSString stringWithFormat:@"touch controls: %s (controller %d, keyboard %d)",
+                     hide ? "hidden" : "shown", pad, keyboard].UTF8String);
+    }
+    self.hidden = hide;
+}
+
+// Placed from the game rect (the window less the Dynamic Island's strip), sized from its height, so
+// they sit the same on every iPhone and iPad. Large, for a thumb: the stick lower left with Auto Run
+// above it, and on the right Interact, the one used most, biggest and lowest, where the thumb rests,
+// with Fishing to its left and Jump above it. Well clear of the screen's edges: the root view defers
+// the system's edge gestures (preferredScreenEdgesDeferringSystemGestures), and for that iOS holds
+// back touches that start near an edge, which made a stick in the corner answer late.
+- (void)layoutSubviews {
+    [super layoutSubviews];
+    CGRect g = sp_game_rect();
+    if (CGRectIsEmpty(g)) g = self.bounds;
+    CGRect b = self.bounds;
+    CGFloat h = g.size.height;
+    CGFloat margin = MAX(h * 0.09, 40);  // from the screen's edges, not the game rect's
+    CGFloat bottom = MIN(CGRectGetMaxY(g), CGRectGetMaxY(b) - margin);
+    CGFloat left = MAX(CGRectGetMinX(g) + h * 0.04, CGRectGetMinX(b) + margin);
+    CGFloat right = MIN(CGRectGetMaxX(g) - h * 0.04, CGRectGetMaxX(b) - margin);
+
+    CGFloat r = MIN(h * 0.19, 96);       // the stick's radius
+    _stick.bounds = CGRectMake(0, 0, 2 * r, 2 * r);
+    _stick.center = CGPointMake(left + r, bottom - r - h * 0.02);
+
+    CGFloat big = MIN(h * 0.22, 104), mid = MIN(h * 0.17, 84), small = MIN(h * 0.13, 64);
+    _interact.bounds = CGRectMake(0, 0, big, big);
+    _fish.bounds = _jump.bounds = CGRectMake(0, 0, mid, mid);
+    _autorun.bounds = CGRectMake(0, 0, small, small);
+    _interact.center = CGPointMake(right - big / 2, bottom - big / 2 - h * 0.02);
+    _fish.center = CGPointMake(_interact.center.x - big / 2 - mid * 0.75, _interact.center.y - big * 0.45);
+    _jump.center = CGPointMake(_interact.center.x, _interact.center.y - big / 2 - mid * 0.8);
+    _autorun.center = CGPointMake(_stick.center.x + r * 0.9, _stick.center.y - r - small * 0.75);
+}
+@end
+#endif
