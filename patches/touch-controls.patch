+// A finger on one of the page's controls (not the stick).
+- (BOOL)sp_page_busy {
+    for (UIView *v in _views)
+        if (([v isKindOfClass:SPPadButton.class] && [(SPPadButton *)v sp_busy])
+            || ([v isKindOfClass:SPLookPad.class] && [(SPLookPad *)v sp_busy])) return YES;
+    return NO;
+}
