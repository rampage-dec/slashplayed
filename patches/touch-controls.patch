+                     st.flags, st.form, st.klass, st.level, who ? ", a character (again)" : ""].UTF8String);
+    SPTouchControls *c = (SPTouchControls *)sp_touch_controls;
+    [c sp_game_state_changed:who && st.who[0]];
+}
