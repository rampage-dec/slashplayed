+// ---- the keyboard: the system's, its text sent as key presses
+
+// Typed text, a character at a time, each as a press of the ISO section key (0x0A) with that character:
+// the game takes a text box's text from the event's characters, and its key bindings from the key code,
+// so a letter typed with no box open (or before the box has the keyboard) presses nothing bound to it.
+// Before, each went as its own key: "hallo" pressed H, A, L, and O wherever they were bound, and an M
+// opened the map.
+static void sp_type_text(NSString *text) {
+    [text enumerateSubstringsInRange:NSMakeRange(0, text.length) options:NSStringEnumerationByComposedCharacterSequences
+                          usingBlock:^(NSString *ch, NSRange r, NSRange er, BOOL *stop) {
+        sp_virtual_tap(0x0A, ch);
+    }];
+}
+
+// ---- the frame limit: the game asks its CAMetalLayer for each frame's drawable (nextDrawable); that
+// waits here until the frame's turn, so the game draws (and the CPU and GPU work, and the battery
+// drains) at most that many frames a second. The cadence is kept, a late frame owes nothing: the next
+// is a whole frame after it. By the runtime, so nothing links QuartzCore.
+#include <objc/runtime.h>
+#include <time.h>
+
+static const int sp_fps_rates[5] = { 0, 30, 45, 60, 120 };
+static const int sp_saver_seconds[4] = { 0, 15, 30, 60 };
+static const uint64_t sp_saver_frame_ns = 1000000000ull / 20;
+static const uint64_t sp_heat_frame_ns = 1000000000ull / 20;
+static volatile BOOL sp_heat_on;            // the setting
+static volatile BOOL sp_hot;                // thermal state serious or critical
+static volatile uint64_t sp_fps_frame_ns;   // 0: no limit
+static volatile uint64_t sp_saver_after_ns; // 0: no saver
+static volatile uint64_t sp_last_touch_ns;  // the last touch (or typed key)
+static volatile BOOL sp_saver_ok = YES;     // no controller or keyboard connected
+static IMP sp_next_drawable_orig;
+
+static void sp_touch_activity(void) {
+    sp_last_touch_ns = clock_gettime_nsec_np(CLOCK_UPTIME_RAW);
+}
+
+static id sp_next_drawable(id self, SEL _cmd) {
+    uint64_t frame = sp_fps_frame_ns, after = sp_saver_after_ns;
+    if (sp_heat_on && sp_hot && frame < sp_heat_frame_ns) frame = sp_heat_frame_ns;
+    if (after && sp_saver_ok && frame < sp_saver_frame_ns
+        && clock_gettime_nsec_np(CLOCK_UPTIME_RAW) - sp_last_touch_ns > after)
+        frame = sp_saver_frame_ns;
+    // For the log, every 30 s: the frames asked for, the limit, the time waited (spconsole.log).
+    static uint64_t calls, slept, logged;
+    uint64_t start = clock_gettime_nsec_np(CLOCK_UPTIME_RAW);
+    calls++;
+    if (frame) {
+        static uint64_t due;
+        uint64_t now = start;
+        if (due > now && due - now <= frame) {
+            uint64_t wait = due - now;
+            struct timespec ts = { (time_t)(wait / 1000000000ull), (long)(wait % 1000000000ull) };
+            nanosleep(&ts, NULL);
+            slept += wait;
+            now = due;
+        }
+        due = now + frame;
+    }
+    if (!logged) logged = start;
+    if (start - logged >= 30000000000ull) {
+        double secs = (start - logged) / 1e9;
+        fprintf(stderr, "[sp:AppKit] touch frame limit: %.1f drawables/s, limit %s, waited %.0f%% of the time\n",
+                calls / secs, frame ? [NSString stringWithFormat:@"%.0f fps", 1e9 / frame].UTF8String : "none",
+                slept / 1e9 / secs * 100);
+        calls = slept = 0;
+        logged = start;
+    }
+    return ((id (*)(id, SEL))sp_next_drawable_orig)(self, _cmd);
+}
+
+static void sp_fps_apply(void) {
+    int i = sp_ts[SP_TS_FPS], j = sp_ts[SP_TS_SAVER];
+    int rate = i > 0 && i < 5 ? sp_fps_rates[i] : 0;
+    int idle = j > 0 && j < 4 ? sp_saver_seconds[j] : 0;
+    sp_fps_frame_ns = rate ? 1000000000ull / (uint64_t)rate : 0;
+    sp_saver_after_ns = (uint64_t)idle * 1000000000ull;
+    sp_heat_on = sp_ts[SP_TS_HEAT] != 0;
+    sp_hot = NSProcessInfo.processInfo.thermalState >= NSProcessInfoThermalStateSerious;
+    if (!sp_last_touch_ns) sp_touch_activity();
+    if ((!rate && !idle && !sp_heat_on) || sp_next_drawable_orig) return;
+    Class c = NSClassFromString(@"CAMetalLayer");
+    Method m = c ? class_getInstanceMethod(c, @selector(nextDrawable)) : NULL;
+    if (m) sp_next_drawable_orig = method_setImplementation(m, (IMP)sp_next_drawable);
+    sp_stub_log(m ? "touch frame limit: on -[CAMetalLayer nextDrawable]" : "touch frame limit: no CAMetalLayer nextDrawable");
+}
