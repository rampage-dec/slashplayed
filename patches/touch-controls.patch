+    for (UIView *v in @[ _toggle, _page_button, _gear, _map, _esc, _kbd ]) [self addSubview:v];
+    sp_touch_edit_done = ^(UIView *v, BOOL moved) { [weak sp_edit_finished:v moved:moved]; };
+    _sink = [[SPKeyboardSink alloc] initWithFrame:CGRectMake(0, 0, 1, 1)];
+    _sink.changed = ^(BOOL open) { [weak sp_keyboard_changed:open]; };
+    [self addSubview:_sink];
+
+    void (^devices)(NSNotification *) = ^(NSNotification *n) { [weak sp_devices_changed]; };
+    for (NSNotificationName name in @[ GCControllerDidConnectNotification, GCControllerDidDisconnectNotification,
+                                       GCKeyboardDidConnectNotification, GCKeyboardDidDisconnectNotification ])
+        [NSNotificationCenter.defaultCenter addObserverForName:name object:nil queue:NSOperationQueue.mainQueue
+                                                    usingBlock:devices];
+    // Leaving the app mid-walk lifts every key, so the character doesn't keep running.
+    [NSNotificationCenter.defaultCenter addObserverForName:UIApplicationWillResignActiveNotification object:nil
+                                                     queue:NSOperationQueue.mainQueue
+                                                usingBlock:^(NSNotification *n) { [weak sp_release_all]; }];
+    // The keyboard can go without Fertig (an iPad's hide key): the root view takes the keys again.
+    [NSNotificationCenter.defaultCenter addObserverForName:UIKeyboardDidHideNotification object:nil
+                                                     queue:NSOperationQueue.mainQueue
+                                                usingBlock:^(NSNotification *n) { [weak sp_keyboard_hidden]; }];
+    // Back in the app: the page once more, in case the game missed the last one (a loading screen).
+    [NSNotificationCenter.defaultCenter addObserverForName:UIApplicationDidBecomeActiveNotification object:nil
+                                                     queue:NSOperationQueue.mainQueue
+                                                usingBlock:^(NSNotification *n) { [weak sp_resend_page]; }];
+    [self sp_page_look];
+    [self sp_apply_settings];
+    [self sp_update_hidden];
+    return self;
+}
+
+- (void)sp_release_all {
+    [_stick sp_release];
+    [_look sp_release];
+    for (SPPadButton *b in @[ _interact, _fish, _jump, _autorun ]) [b sp_release];
+}
+
+- (BOOL)sp_device {
+    return GCController.controllers.count > 0 || GCKeyboard.coalescedKeyboard != nil;
+}
+
+- (void)sp_devices_changed {
+    _on_with_device = NO;
+    [self sp_update_hidden];
+}
+
+- (void)sp_toggle {
+    if ([self sp_device]) {
+        _on_with_device = !_on_with_device;
+    } else {
+        _user_on = !_user_on;
+        [NSUserDefaults.standardUserDefaults setBool:_user_on forKey:@"sp_touch_on"];
+    }
+    [self sp_update_hidden];
+}
+
+// Shown while the settings are open or in edit mode too, to see what they change. Page 2 leaves out
+// Fishing and Jump: the addon's fight buttons take that side.
+- (void)sp_update_hidden {
+    BOOL device = [self sp_device];
+    BOOL show = _panel != nil || _editing || (device ? _on_with_device : _user_on);
+    if (!show && !_pad.hidden) [self sp_release_all];
+    if (show == _pad.hidden) {
+        sp_stub_log([NSString stringWithFormat:@"touch controls: %s (controller or keyboard %d)",
+                     show ? "shown" : "hidden", device].UTF8String);
+    }
+    _pad.hidden = !show;
+    _fish.hidden = _jump.hidden = _page == 2;
+    _toggle.on = device ? _on_with_device : _user_on;
+    self.hidden = !sp_touch_controls_wanted();
+    [self sp_send_page:show];
+}
+
+// ---- the page, for the SPTouch addon: F6 page 1 (or the touch controls hidden: no fight buttons
+// either), F7 page 2, F8 page 2 in edit mode (its fight buttons movable). Explicit states, not a
+// toggle, so a missed key is put right by the next one. Sent on a change only.
+- (void)sp_send_page:(BOOL)shown {
+    if (!sp_touch_controls_wanted()) return;
+    unsigned short key = !shown || _page != 2 ? 0x61 : _editing ? 0x64 : 0x62;
+    if (key == _sent) return;
+    _sent = key;
+    sp_virtual_tap(key, nil);
+}
+
+- (void)sp_resend_page {
+    _sent = 0;
+    [self sp_update_hidden];
+}
+
+- (void)sp_page_look {
+    [_page_button sp_set_title:_page == 2 ? @"Seite 2" : @"Seite 1"];
+    _page_button.on = _page == 2;
+    [_banner sp_page:_page];
+}
+
+- (void)sp_switch_page {
+    [self sp_release_all];
+    _page = _page == 2 ? 1 : 2;
+    [NSUserDefaults.standardUserDefaults setInteger:_page forKey:@"sp_touch_page"];
+    [self sp_page_look];
+    _sent = 0;  // a tap on Seite always tells the addon, even if it missed the last one
+    [self sp_update_hidden];
+    [self setNeedsLayout];
+}
+
+// ---- edit mode
+
+- (void)sp_edit_toggle {
+    [self sp_edit:!_editing];
+}
+
+- (void)sp_edit:(BOOL)on {
+    if (on == _editing) return;
+    [self sp_release_all];
+    sp_edit_view = nil;
+    sp_edit_touch = nil;
+    _editing = on;
+    sp_touch_editing = on;
+    if (on) {
+        if (_panel) [self sp_settings_done];
+        _banner = [[SPEditBanner alloc] initWithFrame:CGRectZero];
+        __weak SPTouchControls *weak = self;
+        _banner.reset = ^{ [weak sp_edit_reset]; };
+        _banner.done = ^{ [weak sp_edit:NO]; };
+        [self addSubview:_banner];
+        [_banner sp_page:_page];
+    } else {
+        [_banner removeFromSuperview];
+        _banner = nil;
+    }
+    _gear.on = on;
+    UIColor *hi = [UIColor colorWithRed:1 green:0.78 blue:0.2 alpha:0.95];
+    for (UIView *v in @[ _stick, _autorun, _interact, _fish, _jump, _look ]) {
+        CGFloat a = v == _stick ? 0.35 : v == _look ? 0.28 : 0.4;   // their own borders, as at init
+        v.layer.borderWidth = on ? 3 : 1.5;
+        v.layer.borderColor = on ? hi.CGColor : [UIColor colorWithWhite:1 alpha:a].CGColor;
+    }
+    [self sp_update_hidden];
+    [self setNeedsLayout];
+}
+
+// Each control's placement and size on a page: NSUserDefaults "sp_touch_layout_<page>", a dictionary
+// of name to [x, y, size], x and y the centre as fractions of the game rect, size a factor.
+- (NSString *)sp_layout_key {
+    return _page == 2 ? @"sp_touch_layout_2" : @"sp_touch_layout_1";
+}
+
+- (NSDictionary *)sp_layout {
+    id d = [NSUserDefaults.standardUserDefaults objectForKey:[self sp_layout_key]];
+    return [d isKindOfClass:NSDictionary.class] ? d : @{};
+}
+
+static NSArray *sp_layout_entry(NSDictionary *lay, NSString *name) {
+    id o = lay[name];
+    if (![o isKindOfClass:NSArray.class] || [o count] != 3) return nil;
+    for (id n in o)
+        if (![n isKindOfClass:NSNumber.class]) return nil;
+    return o;
+}
+
+static CGFloat sp_layout_size(NSDictionary *lay, NSString *name) {
+    NSArray *o = sp_layout_entry(lay, name);
+    return o ? MIN(2, MAX(0.5, [o[2] doubleValue])) : 1;
+}
+
+static CGPoint sp_layout_at(NSDictionary *lay, NSString *name, CGPoint def, CGRect g) {
+    NSArray *o = sp_layout_entry(lay, name);
+    if (!o) return def;
+    CGFloat fx = MIN(1, MAX(0, [o[0] doubleValue])), fy = MIN(1, MAX(0, [o[1] doubleValue]));
+    return CGPointMake(g.origin.x + fx * g.size.width, g.origin.y + fy * g.size.height);
+}
+
+- (NSString *)sp_name:(UIView *)v {
+    if (v == _stick) return @"stick";
+    if (v == _autorun) return @"autorun";
+    if (v == _interact) return @"interact";
+    if (v == _fish) return @"fish";
+    if (v == _jump) return @"jump";
+    if (v == _look) return @"look";
+    return nil;
+}
+
+- (CGRect)sp_game {
+    CGRect g = sp_game_rect();
+    return CGRectIsEmpty(g) ? self.bounds : g;
+}
+
+// A drag's end: the new place. A tap: the next size round (70 % to 140 %), in place.
+- (void)sp_edit_finished:(UIView *)v moved:(BOOL)moved {
+    NSString *name = [self sp_name:v];
+    if (!name) return;
+    CGRect g = [self sp_game];
+    if (g.size.width <= 0 || g.size.height <= 0) return;
+    NSMutableDictionary *lay = [[self sp_layout] mutableCopy];
+    CGFloat size = sp_layout_size(lay, name);
+    if (!moved) {
+        int near = 0;
+        for (int i = 1; i < 5; i++)
+            if (fabs(sp_edit_steps[i] - size) < fabs(sp_edit_steps[near] - size)) near = i;
+        size = sp_edit_steps[(near + 1) % 5];
+    }
+    sp_touch_haptic();
+    CGPoint c = v.center;
+    lay[name] = @[ @((c.x - g.origin.x) / g.size.width), @((c.y - g.origin.y) / g.size.height), @(size) ];
+    [NSUserDefaults.standardUserDefaults setObject:lay forKey:[self sp_layout_key]];
+    [self setNeedsLayout];
+}
+
+- (void)sp_edit_reset {
+    [NSUserDefaults.standardUserDefaults removeObjectForKey:[self sp_layout_key]];
+    [self setNeedsLayout];
+}
+
+- (void)sp_apply_settings {
+    [_stick sp_release];   // a held key from the old side mode goes up as the key it was
+    _pad.alpha = sp_ts_alpha[sp_ts[SP_TS_OPACITY]];
+    if (!sp_ts[SP_TS_LOOK]) [_look sp_release];
+    _look.hidden = !sp_ts[SP_TS_LOOK];
+    [self setNeedsLayout];
+}
+
+- (void)sp_settings {
+    if (_panel) {
+        [self sp_settings_done];
+        return;
+    }
+    if (_editing) [self sp_edit:NO];
+    _panel = [[SPSettingsPanel alloc] initWithFrame:CGRectZero];
+    __weak SPTouchControls *weak = self;
+    _panel.changed = ^{ [weak sp_apply_settings]; };
+    _panel.done = ^{ [weak sp_settings_done]; };
+    _panel.edit = ^{ [weak sp_edit:YES]; };
+    [self addSubview:_panel];
+    _gear.on = YES;
+    [self sp_update_hidden];
+    [self setNeedsLayout];
+}
+
+- (void)sp_settings_done {
+    [_panel removeFromSuperview];
+    _panel = nil;
+    _gear.on = NO;
+    [self sp_update_hidden];
+}
+
+- (void)sp_keyboard:(BOOL)chat {
+    if (_sink.isFirstResponder) [_sink sp_close];
+    else [_sink sp_open:chat];
+}
+
+- (void)sp_keyboard_changed:(BOOL)open {
+    _kbd.on = open;
+}
+
+- (void)sp_keyboard_hidden {
+    if (_sink.isFirstResponder) return;
+    _kbd.on = NO;
+    if (!self.superview.isFirstResponder) [self.superview becomeFirstResponder];
+}
+
+// The strip's buttons and the panel, for the root view's pointInside: (the strip is outside the game,
+// where the root view takes no touch).
+- (BOOL)sp_claims:(CGPoint)p {
+    if (self.hidden) return NO;
+    for (UIView *v in @[ _toggle, _page_button, _gear, _map, _esc, _kbd ])
+        if (!v.hidden && [v pointInside:[self convertPoint:p toView:v] withEvent:nil]) return YES;
+    return (_panel && CGRectContainsPoint(_panel.frame, p)) || (_banner && CGRectContainsPoint(_banner.frame, p));
+}
+
+// Placed from the game rect (the window less the Dynamic Island's strip), sized from its height, so
+// they sit the same on every iPhone and iPad, times the settings' sizes. For a thumb: the stick lower
+// left with Auto Run above it, and on the right Interact, the one used most, biggest and lowest, where
+// the thumb rests, with Fishing to its left, Jump above it, and the camera pad in the corner between.
+// Well clear of the screen's edges: the root view defers the system's edge gestures
+// (preferredScreenEdgesDeferringSystemGestures), and for that iOS holds back touches that start near
+// an edge, which made a stick in the corner answer late.
+- (void)layoutSubviews {
+    [super layoutSubviews];
+    CGRect g = [self sp_game];
+    CGRect b = self.bounds;
+    _pad.frame = b;
+    CGFloat h = g.size.height;
+    CGFloat margin = MAX(h * 0.09, 40);  // from the screen's edges, not the game rect's
+    CGFloat bottom = MIN(CGRectGetMaxY(g), CGRectGetMaxY(b) - margin);
+    CGFloat left = MAX(CGRectGetMinX(g) + h * 0.04, CGRectGetMinX(b) + margin);
+    CGFloat right = MIN(CGRectGetMaxX(g) - h * 0.04, CGRectGetMaxX(b) - margin);
+    CGFloat ss = sp_ts_size[sp_ts[SP_TS_STICK]], bs = sp_ts_size[sp_ts[SP_TS_BUTTONS]];
+
+    // The defaults: each from the others' default places, so moving one in edit mode moves only it.
+    CGFloat r = MIN(h * 0.165, 82) * ss;  // the stick's radius
+    CGFloat big = MIN(h * 0.22, 104) * bs, mid = MIN(h * 0.17, 84) * bs, small = MIN(h * 0.13, 64) * bs;
+    CGPoint stick = CGPointMake(left + r, bottom - r - h * 0.02);
+    CGPoint interact = CGPointMake(right - big / 2, bottom - big / 2 - h * 0.02);
+    CGPoint fish = CGPointMake(interact.x - big / 2 - mid * 0.75, interact.y - big * 0.45);
+    CGPoint jump = CGPointMake(interact.x, interact.y - big / 2 - mid * 0.8);
+    CGPoint autorun = CGPointMake(stick.x + r * 0.9, stick.y - r - small * 0.75);
+    // The camera pad: left of Jump, above Fishing, kept to the right half and below the top eighth.
+    CGFloat lx1 = jump.x - mid / 2 - mid * 0.1, ly1 = fish.y - mid / 2 - mid * 0.12;
+    CGFloat lx0 = MAX(lx1 - big * 1.5, CGRectGetMidX(g) + 20), ly0 = MAX(ly1 - big * 1.05, CGRectGetMinY(g) + h * 0.12);
+    CGSize look = CGSizeMake(MAX(0, lx1 - lx0), MAX(0, ly1 - ly0));
+    CGPoint lookc = CGPointMake((lx0 + lx1) / 2, (ly0 + ly1) / 2);
+
+    // Then this page's own places and sizes, from edit mode.
+    NSDictionary *lay = [self sp_layout];
+    CGFloat rs = r * sp_layout_size(lay, @"stick");
+    _stick.bounds = CGRectMake(0, 0, 2 * rs, 2 * rs);
+    _stick.rest = sp_layout_at(lay, @"stick", stick, g);
+    CGFloat d = big * sp_layout_size(lay, @"interact");
+    _interact.bounds = CGRectMake(0, 0, d, d);
+    _interact.center = sp_layout_at(lay, @"interact", interact, g);
+    d = mid * sp_layout_size(lay, @"fish");
+    _fish.bounds = CGRectMake(0, 0, d, d);
+    _fish.center = sp_layout_at(lay, @"fish", fish, g);
+    d = mid * sp_layout_size(lay, @"jump");
+    _jump.bounds = CGRectMake(0, 0, d, d);
+    _jump.center = sp_layout_at(lay, @"jump", jump, g);
+    d = small * sp_layout_size(lay, @"autorun");
+    _autorun.bounds = CGRectMake(0, 0, d, d);
+    _autorun.center = sp_layout_at(lay, @"autorun", autorun, g);
+    CGFloat ls = sp_layout_size(lay, @"look");
+    _look.bounds = CGRectMake(0, 0, look.width * ls, look.height * ls);
+    _look.center = sp_layout_at(lay, @"look", lookc, g);
+
+    // The strip's buttons: Touch, Seite, and the gear at its top; the map, Esc, and the keyboard at its bottom
+    // (the keyboard lowest, nearest the thumb); each group clear of the island in the middle, and kept
+    // out of the screen's rounded corners (closing up rather than going further). With no strip (an
+    // iPad), a column at the game's left edge, around the middle.
+    CGRect strip = CGRectNull;
+    if (CGRectGetMinX(g) - CGRectGetMinX(b) >= 30)
+        strip = CGRectMake(CGRectGetMinX(b), CGRectGetMinY(b), CGRectGetMinX(g) - CGRectGetMinX(b), b.size.height);
+    else if (CGRectGetMaxX(b) - CGRectGetMaxX(g) >= 30)
+        strip = CGRectMake(CGRectGetMaxX(g), CGRectGetMinY(b), CGRectGetMaxX(b) - CGRectGetMaxX(g), b.size.height);
+    NSArray<UIView *> *upper = @[ _toggle, _page_button, _gear ], *lower = @[ _map, _esc, _kbd ];
+    if (!CGRectIsNull(strip)) {
+        CGFloat bw = MIN(strip.size.width - 6, 50), bh = 34, pitch = 40, x = CGRectGetMidX(strip);
+        CGFloat t0 = CGRectGetMinY(strip) + 76, t1 = t0 + (upper.count - 1) * pitch;   // centres, top down
+        CGFloat l1 = CGRectGetMaxY(strip) - 58, l0 = l1 - (lower.count - 1) * pitch;
+        if (!CGRectIsNull(sp_game_island) && !CGRectIsEmpty(sp_game_island)) {
+            CGFloat over = t1 + bh / 2 + 6 - CGRectGetMinY(sp_game_island);
+            CGFloat under = CGRectGetMaxY(sp_game_island) + 6 - (l0 - bh / 2);
+            if (over > 0) { t0 -= over; t1 -= over; }
+            if (under > 0) { l0 += under; l1 += under; }
+        }
+        t0 = MAX(t0, CGRectGetMinY(strip) + 26 + bh / 2);
+        l1 = MIN(l1, CGRectGetMaxY(strip) - 26 - bh / 2);
+        CGFloat tp = (t1 - t0) / (upper.count - 1), lp = (l1 - l0) / (lower.count - 1);
+        CGFloat th = MAX(20, MIN(bh, tp - 4)), lh = MAX(20, MIN(bh, lp - 4));
+        for (NSUInteger i = 0; i < upper.count; i++) {
+            upper[i].bounds = CGRectMake(0, 0, bw, th);
+            upper[i].center = CGPointMake(x, t0 + i * tp);
+        }
+        for (NSUInteger i = 0; i < lower.count; i++) {
+            lower[i].bounds = CGRectMake(0, 0, bw, lh);
+            lower[i].center = CGPointMake(x, l0 + i * lp);
+        }
+    } else {
+        NSArray<UIView *> *col = [upper arrayByAddingObjectsFromArray:lower];
+        CGFloat x = CGRectGetMinX(g) + 8 + 25;
+        for (NSUInteger i = 0; i < col.count; i++) {
+            col[i].bounds = CGRectMake(0, 0, 50, 38);
+            col[i].center = CGPointMake(x, CGRectGetMidY(g) + (i - (col.count - 1) / 2.0) * 46);
+        }
+    }
+
+    if (_panel) {
+        CGFloat pw = MIN(430, g.size.width - 40), ph = MIN(34 + SP_TS_COUNT * 36 + 54, h - 20);
+        _panel.frame = CGRectMake(CGRectGetMidX(g) - pw / 2, CGRectGetMidY(g) - ph / 2, pw, ph);
+    }
+    if (_banner) {
+        CGFloat bw = MIN(560, g.size.width - 40);
+        _banner.frame = CGRectMake(CGRectGetMidX(g) - bw / 2, CGRectGetMinY(g) + 8, bw, 48);
+    }
+}
+@end
