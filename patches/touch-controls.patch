+// Which profile each character had last ("Name-Realm" to a profile's name).
+static NSDictionary<NSString *, NSString *> *sp_prof_charmap(void) {
+    id m = [NSUserDefaults.standardUserDefaults objectForKey:@"sp_touch_charmap"];
+    return [m isKindOfClass:NSDictionary.class] ? m : @{};
+}
+
+static NSString *sp_prof_for(NSString *who) {
+    id n = who.length ? sp_prof_charmap()[who] : nil;
+    return [n isKindOfClass:NSString.class] && [n length] ? n : nil;
+}
+
+// name nil: the character's link gone.
+static void sp_prof_link(NSString *who, NSString *name) {
+    if (!who.length) return;
+    NSMutableDictionary *m = [sp_prof_charmap() mutableCopy];
+    if (name.length) m[who] = name;
+    else [m removeObjectForKey:who];
+    [NSUserDefaults.standardUserDefaults setObject:m forKey:@"sp_touch_charmap"];
+    [NSUserDefaults.standardUserDefaults synchronize];
+}
+
+// The links to `from` go to `to` (nil: they go).
+static void sp_prof_relink(NSString *from, NSString *to) {
+    NSMutableDictionary *m = [sp_prof_charmap() mutableCopy];
+    for (NSString *who in sp_prof_charmap())
+        if ([m[who] isEqual:from]) {
+            if (to.length) m[who] = to;
+            else [m removeObjectForKey:who];
+        }
+    [NSUserDefaults.standardUserDefaults setObject:m forKey:@"sp_touch_charmap"];
+    if ([sp_prof_active() isEqualToString:from]) sp_prof_set_active(to);
+    [NSUserDefaults.standardUserDefaults synchronize];
+}
