+// ---- what makes a page show by itself (its "Auto:" in edit mode; sp_touch_page_auto, a key per page):
+// the game's state as the SPTouch addon says it (sp_game_state). A form or stance is the class's own: the
+// menu offers the forms of the character's class once the addon has said it, else all of them.
+static const struct { const char *key, *title; int klass; } sp_auto_triggers[] = {
+    { "", "Nie", 0 }, { "kampf", "Im Kampf", 0 }, { "reiten", "Beim Reiten", 0 }, { "flug", "Auf Flugroute", 0 },
+    { "karte", "Karte offen", 0 },
+    { "form:1", "Bärengestalt", 11 }, { "form:2", "Katzengestalt", 11 }, { "form:3", "Reisegestalt", 11 },
+    { "form:4", "Wassergestalt", 11 }, { "form:5", "Mondkingestalt", 11 },
+    { "form:6", "Kampfhaltung", 1 }, { "form:7", "Verteidigungshaltung", 1 }, { "form:8", "Berserkerhaltung", 1 },
+    { "form:9", "Verstohlenheit", 4 }, { "form:10", "Schattengestalt", 5 }, { "form:11", "Geisterwolf", 7 },
+};
+static const int sp_auto_trigger_count = (int)(sizeof sp_auto_triggers / sizeof sp_auto_triggers[0]);
