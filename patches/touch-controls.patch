+- (void)sp_profile_info {
+    if (!_profileInfo) return;
+    NSString *active = sp_prof_active(), *who = sp_gs_who(), *mine = sp_prof_for(who);
+    NSMutableString *t = [NSMutableString string];
+    [t appendString:active ? [NSString stringWithFormat:@"Aktiv: %@", active] : @"Kein Profil aktiv"];
+    if (who) {
+        [t appendFormat:@" · %@: %@", sp_gs_name(), mine ? [NSString stringWithFormat:@"„%@“", mine] : @"noch keins"];
+        if (!sp_ts[SP_TS_CHARPROF]) [t appendString:@" (Profil je Charakter ist aus)"];
+    } else if (!_profileNames.count) {
+        [t appendString:@" · + Neues Profil sichert das Layout, wie es jetzt ist."];
+    }
+    _profileInfo.text = t;
+}
