+- (void)sp_disarm {
+    _armed = NO;
+    _resetArmed = NO;
+    [_resetButton setTitle:@"Standard" forState:UIControlStateNormal];
+    [_deletePageButton setTitle:@"Seite löschen" forState:UIControlStateNormal];
+}
