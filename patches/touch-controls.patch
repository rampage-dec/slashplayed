+- (void)sp_build_profiles {
+    _profileHead = [[UILabel alloc] init];
+    _profileHead.text = @"Layout-Profile: tippen = laden (das jetzige geht vorher in sein Profil zurück), halten = mehr";
+    _profileHead.font = [UIFont systemFontOfSize:12];
+    _profileHead.textColor = [UIColor colorWithWhite:1 alpha:0.6];
+    _profileHead.numberOfLines = 2;
+    [self sp_add_item:_profileHead];
+    _profileBox = [[UIView alloc] init];
