+- (void)touchesCancelled:(NSSet<UITouch *> *)touches withEvent:(UIEvent *)event {
+    if (!_touch || ![touches containsObject:_touch]) return;
+    _touch = nil;
+    _gen++;
+    [self sp_draw:NO];
+}
