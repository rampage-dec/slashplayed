+// The layout as it is now into the saved file ("Layout laden" brings it back); over an earlier one
+// only at a second tap.
+- (void)sp_save_tapped {
+    if (sp_layout_has_saved() && !_saveArmed) {
+        _saveArmed = YES;
+        [_saveButton setTitle:@"Überschreiben?" forState:UIControlStateNormal];
+        return;
+    }
+    _saveArmed = NO;
+    sp_layout_write(sp_layout_saved_path());
+    [_saveButton setTitle:sp_layout_has_saved() ? @"Gesichert" : @"Ging nicht" forState:UIControlStateNormal];
+}
+
+// Replaces the whole layout, so a second tap confirms it.
+- (void)sp_load_tapped {
+    if (!_loadArmed) {
+        _loadArmed = YES;
+        [_loadButton setTitle:@"Sicher? Nochmal" forState:UIControlStateNormal];
+        return;
+    }
+    _loadArmed = NO;
+    BOOL ok = _load && _load();
+    [_loadButton setTitle:ok ? @"Geladen" : @"Keine Datei" forState:UIControlStateNormal];
+    [self sp_sync];
+}
+
+- (void)sp_choose_tap:(UIButton *)b {
+    int which = (int)b.tag;
+    [_chooser removeFromSuperview];
+    _chooser = [[SPGestureChooser alloc] initWithWhich:which];
+    __weak SPSettingsPanel *weak = self;
+    _chooser.picked = ^(int i) {
+        SPSettingsPanel *me = weak;
+        if (!me) return;
+        if (i >= 0) sp_gesture_set(which, i);
+        [me->_chooser removeFromSuperview];
+        me->_chooser = nil;
+        [me sp_sync];
+        if (me->_changed) me->_changed();
+    };
+    [self addSubview:_chooser];
+    [self setNeedsLayout];
+}
+
+- (void)sp_sync {
+    for (int k = 0; k < 3; k++)
+        [_tapButton[k] setTitle:sp_gesture_title(k + 1, sp_gesture_get(k + 1)) forState:UIControlStateNormal];
+    for (int i = 0; i < SP_TS_COUNT; i++) _segs[i].selectedSegmentIndex = sp_ts[i];
+    _energy.selectedSegmentIndex = sp_energy_now();
+    [self sp_profile_info];
+    [self sp_live_update];
+}
+
+- (void)sp_live_update {
+    if (!_liveLabel || !_live) return;
+    _liveLabel.text = _live();
+    [self setNeedsLayout];
+}
+
+- (void)sp_picked:(UISegmentedControl *)s {
+    int row = (int)s.tag;
+    sp_ts_set(row, (int)s.selectedSegmentIndex);
+    if (row == SP_TS_FPS || row == SP_TS_SAVER || row == SP_TS_HEAT || row == SP_TS_AWAKE || row == SP_TS_CHARGE
+        || row == SP_TS_CALM) sp_fps_apply();
+    _energy.selectedSegmentIndex = sp_energy_now();
+    [self sp_profile_info];
+    [self sp_live_update];
+    if (_changed) _changed();
+}
+
+// An energy profile: its settings at once. Eigene is what the settings are when none fits: picked,
+// nothing changes.
+- (void)sp_energy_picked {
+    int i = (int)_energy.selectedSegmentIndex;
+    if (i >= 0 && i < 3) {
+        sp_energy_set(i);
+        sp_fps_apply();
+    }
+    [self sp_sync];
+    if (_changed) _changed();
+}
+
+// The settings back to what they were at first: at a second tap, and with the layout kept first.
+- (void)sp_defaults {
+    if (!_resetArmed) {
+        _resetArmed = YES;
+        [_reset setTitle:@"Wirklich?" forState:UIControlStateNormal];
+        return;
+    }
+    _resetArmed = NO;
+    [_reset setTitle:@"Standard" forState:UIControlStateNormal];
+    sp_layout_keep_before_reset();
+    for (int i = 0; i < SP_TS_COUNT; i++) sp_ts_set(i, sp_ts_rows[i].def);
+    [NSUserDefaults.standardUserDefaults removeObjectForKey:@"sp_touch_tap1"];
+    [NSUserDefaults.standardUserDefaults removeObjectForKey:@"sp_touch_tap2"];
+    [NSUserDefaults.standardUserDefaults removeObjectForKey:@"sp_touch_tap3"];
+    sp_layout_backup();
+    sp_fps_apply();
+    [self sp_sync];
+    if (_changed) _changed();
+}
