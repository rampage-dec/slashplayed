+// ---- Uhr & Akku: "14:05 · 78 % · −12 %/h" (⚡ charging), "warm", and "heiß" with the phone hot (and
+// Hitzeschutz's step)
+
+// A note over the game, under the status line, for five seconds: a warning (the battery) in red, else blue.
+- (void)sp_toast:(NSString *)text {
+    [self sp_toast:text warn:YES];
+}
+
+- (void)sp_note:(NSString *)text {
+    [self sp_toast:text warn:NO];
+}
+
+- (void)sp_toast:(NSString *)text warn:(BOOL)warn {
+    _toast.backgroundColor = warn ? [UIColor colorWithRed:0.75 green:0.25 blue:0.1 alpha:0.92]
+                                  : [UIColor colorWithRed:0.12 green:0.35 blue:0.7 alpha:0.92];
+    _toast.text = text;
+    CGRect b = self.bounds;
+    CGFloat tw = MIN(MAX(300, [_toast sizeThatFits:CGSizeMake(600, 40)].width + 30), b.size.width - 40);
+    _toast.frame = CGRectMake(CGRectGetMidX(b) - tw / 2, b.origin.y + 44, tw, 40);
+    _toast.hidden = NO;
+    [self bringSubviewToFront:_toast];
+    sp_touch_haptic();
+    NSUInteger gen = ++_toast_gen;
+    __weak SPTouchControls *weak = self;
+    dispatch_after(dispatch_time(DISPATCH_TIME_NOW, (int64_t)(5 * NSEC_PER_SEC)), dispatch_get_main_queue(), ^{
+        SPTouchControls *me = weak;
+        if (me && me->_toast_gen == gen) me->_toast.hidden = YES;
+    });
+}
+
+// The battery down to 20 %, and to 10 %: once each, until it has been above 20 % or charging again.
+- (void)sp_battery_check {
+    float lv = UIDevice.currentDevice.batteryLevel;
+    UIDeviceBatteryState st = UIDevice.currentDevice.batteryState;
+    int pct = lv >= 0 ? (int)lroundf(lv * 100) : -1;
+    if (pct < 0 || pct > 20 || st == UIDeviceBatteryStateCharging || st == UIDeviceBatteryStateFull) {
+        _batt_warned = 100;
+        return;
+    }
+    int mark = pct <= 10 ? 10 : 20;
+    if (mark >= _batt_warned) return;
+    _batt_warned = mark;
+    if (sp_ts[SP_TS_BATT]) [self sp_toast:[NSString stringWithFormat:@"Akku bei %d %%", pct]];
+}
+
+- (void)sp_status_update {
+    sp_heat_tick();   // every 15 seconds (the timer), shown or not: the steps' waits
+    [self sp_battery_check];
+    float level = UIDevice.currentDevice.batteryLevel;
+    UIDeviceBatteryState bst = UIDevice.currentDevice.batteryState;
+    BOOL charging = bst == UIDeviceBatteryStateCharging || bst == UIDeviceBatteryStateFull;
+    sp_batt_note(level, charging);   // shown or not: the rate is there when the status is turned on
+    [_panel sp_live_update];
+    BOOL show = sp_ts[SP_TS_STATUS] != 0;
+    _status.hidden = !show;
+    if (!show) return;
+    NSDateComponents *c = [NSCalendar.currentCalendar components:NSCalendarUnitHour | NSCalendarUnitMinute fromDate:NSDate.date];
+    NSMutableString *text = [NSMutableString stringWithFormat:@"%02ld:%02ld", (long)c.hour, (long)c.minute];
+    if (level >= 0) {
+        [text appendFormat:@" · %@%d %%", charging ? @"⚡" : @"", (int)lroundf(level * 100)];
+        double rate = charging ? -1 : sp_batt_rate(level);
+        if (rate >= 0) [text appendFormat:@" · −%.0f %%/h", rate];
+    }
+    int step = sp_heat_on ? sp_heat_step : 0;
+    if (step) [text appendFormat:@" · %@, max. %d FPS", sp_hot ? (sp_charging ? @"warm beim Laden" : @"heiß") : @"kühlt ab", sp_heat_rates[step]];
+    else if (sp_hot) [text appendString:sp_charging ? @" · warm beim Laden" : @" · heiß"];
+    else if (sp_charging) [text appendString:@" · lädt: max. 30 FPS"];
+    else if (NSProcessInfo.processInfo.thermalState == NSProcessInfoThermalStateFair) [text appendString:@" · warm"];
+    _status.text = text;
+    _status.textColor = (sp_hot || step) ? [UIColor colorWithRed:1 green:0.55 blue:0.3 alpha:0.95]
+                     : (level >= 0 && level < 0.2 ? [UIColor colorWithRed:1 green:0.4 blue:0.4 alpha:0.95]
+                                                  : [UIColor colorWithWhite:1 alpha:0.8]);
+    [self setNeedsLayout];
+}
+
+// ---- ⓘ: a tap arms it for the next touch over the game, a hold for every one until it's tapped again.
+// That touch moves the pointer where it lands and follows the finger (the game shows what's under it:
+// an item's, a buff's, a unit's tooltip) and clicks nothing; the pointer stays there after, so the
+// tooltip does too.
+
+- (void)sp_info_tap {
+    if (_info_locked || _info_armed) {
+        _info_locked = _info_armed = NO;
+    } else {
+        _info_armed = YES;
+    }
+    _info.on = _info_armed;
+}
+
+- (void)sp_info_lock {
+    _info_locked = _info_armed = YES;
+    _info.on = YES;
+    sp_touch_haptic();
+}
