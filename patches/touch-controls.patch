+// A view as large as its superview that takes no touch itself: everything outside its subviews goes
+// to the view underneath (the root view, the game).
+@interface SPPassView : UIView
+@end
+
+@implementation SPPassView
+- (UIView *)hitTest:(CGPoint)point withEvent:(UIEvent *)event {
+    UIView *v = [super hitTest:point withEvent:event];
+    return v == self ? nil : v;
+}
+@end
+
+// ---- the stick
+
+// Forward, left, back, right: the keys (Mac key codes, kVK_ANSI_*) and what they type. Left and right
+// turn (A, D) or strafe (Q, E), the setting's choice. Turning by key, not by a right-button drag: the
+// stick's own mouselook press was taken as a right click on whatever stood there. The camera pad turns
+// by drag, from a touch of its own.
+static void sp_stick_key(int i, BOOL strafe, unsigned short *mac, NSString **chars) {
+    static const unsigned short turn[4] = { 0x0D, 0x00, 0x01, 0x02 }, side[4] = { 0x0D, 0x0C, 0x01, 0x0E };
+    static NSString *const turn_c[4] = { @"w", @"a", @"s", @"d" }, *const side_c[4] = { @"w", @"q", @"s", @"e" };
+    *mac = strafe ? side[i] : turn[i];
+    *chars = strafe ? side_c[i] : turn_c[i];
+}
+
+// Each key's direction (degrees, 0 right, counterclockwise, up 90) and half its sector. Forward and
+// back get 140 degrees, left and right 120: straight ahead and straight back have 60 to themselves,
+// left and right 40, and each diagonal (both keys) 40. A key held keeps its sector 7 degrees wider,
+// so a thumb resting on a boundary doesn't flick the key on and off.
+static const CGFloat sp_stick_dir[4] = { 90, 180, 270, 0 }, sp_stick_half[4] = { 70, 60, 70, 60 };
+
+@interface SPStickView : UIView
+@property(nonatomic) CGPoint rest;   // the centre at rest, in the superview's coordinates
+- (void)sp_release;
+@end
+
+@implementation SPStickView {
+    UITouch *_touch;   // the thumb on the stick; nil when free
+    NSTimeInterval _began, _lastTap;   // the touch's start; the last short tap's end (double tap)
+    UIView *_knob;
+    UILabel *_arrow[4];
+    BOOL _down[4];
+    unsigned short _mac[4];   // the key each pressed, so its release is the same key after a mode change
+    NSString *_chars[4];
+}
+
+- (instancetype)initWithFrame:(CGRect)frame {
+    if (!(self = [super initWithFrame:frame])) return nil;
+    self.backgroundColor = [UIColor colorWithWhite:1 alpha:0.10];
+    self.layer.borderColor = [UIColor colorWithWhite:1 alpha:0.35].CGColor;
+    self.layer.borderWidth = 1.5;
+    static NSString *const arrows[4] = { @"▲", @"◀", @"▼", @"▶" };
+    for (int i = 0; i < 4; i++) {
+        _arrow[i] = [[UILabel alloc] init];
+        _arrow[i].text = arrows[i];
+        _arrow[i].textAlignment = NSTextAlignmentCenter;
+        _arrow[i].textColor = [UIColor colorWithWhite:1 alpha:0.35];
+        _arrow[i].userInteractionEnabled = NO;
+        [self addSubview:_arrow[i]];
+    }
+    _knob = [[UIView alloc] init];
+    _knob.userInteractionEnabled = NO;
+    _knob.backgroundColor = [UIColor colorWithWhite:1 alpha:0.35];
+    [self addSubview:_knob];
+    return self;
+}
+
+- (CGFloat)sp_r {
+    return self.bounds.size.width / 2;
+}
+
+// A new rest point (a layout) moves a stick that's free; a held one goes back there on release.
+- (void)setRest:(CGPoint)rest {
+    _rest = rest;
+    if (!_touch) self.center = rest;
+}
+
+- (void)layoutSubviews {
+    [super layoutSubviews];
+    CGFloat r = [self sp_r], k = r * 0.8;
+    self.layer.cornerRadius = r;
+    _knob.bounds = CGRectMake(0, 0, k, k);
+    _knob.layer.cornerRadius = k / 2;
+    if (!_touch) _knob.center = CGPointMake(r, r);
+    CGFloat a = MAX(10, r * 0.22);
+    for (int i = 0; i < 4; i++) {
+        _arrow[i].font = [UIFont boldSystemFontOfSize:a];
+        _arrow[i].bounds = CGRectMake(0, 0, a * 1.6, a * 1.6);
+        CGFloat rad = sp_stick_dir[i] * M_PI / 180;
+        _arrow[i].center = CGPointMake(r + cos(rad) * r * 0.78, r - sin(rad) * r * 0.78);
+    }
+}
+
+// A catch area wider than the ring, so a thumb landing a little outside still takes the stick; wider
+// still when the centre goes to the thumb.
+- (BOOL)pointInside:(CGPoint)p withEvent:(UIEvent *)event {
+    CGFloat r = [self sp_r];
+    return hypot(p.x - r, p.y - r) <= r * (sp_ts[SP_TS_CENTER] ? 1.45 : 1.3);
+}
+
+- (void)sp_key:(int)i down:(BOOL)down {
+    if (_down[i] == down) return;
+    if (down) {
+        NSString *chars;
+        sp_stick_key(i, sp_ts[SP_TS_SIDE] == 1, &_mac[i], &chars);
+        _chars[i] = chars;
+    }
+    _down[i] = down;
+    sp_virtual_key(_mac[i], _chars[i], down);
+    _arrow[i].textColor = [UIColor colorWithWhite:1 alpha:down ? 0.95 : 0.35];
+}
+
+// p is in the superview's coordinates. Moves the centre to within 0.9 radius of the rest point.
+- (void)sp_center_toward:(CGPoint)c {
+    CGFloat r = [self sp_r], ox = c.x - _rest.x, oy = c.y - _rest.y, ol = hypot(ox, oy), max = r * 0.9;
+    if (ol > max) c = CGPointMake(_rest.x + ox * max / ol, _rest.y + oy * max / ol);
+    self.center = c;
+}
+
+- (void)sp_follow:(CGPoint)p {
+    CGFloat r = [self sp_r];
+    if (r <= 0) return;
+    CGPoint c = self.center;
+    CGFloat dx = (p.x - c.x) / r, dy = (p.y - c.y) / r, len = hypot(dx, dy);
+    // With the centre at the thumb, a thumb past the ring drags the ring along (so turning back is a
+    // short way, not across a far-off centre), within its bounds near the rest point.
+    if (sp_ts[SP_TS_CENTER] && len > 1) {
+        [self sp_center_toward:CGPointMake(p.x - dx / len * r, p.y - dy / len * r)];
+        c = self.center;
+        dx = (p.x - c.x) / r;
+        dy = (p.y - c.y) / r;
+        len = hypot(dx, dy);
+    }
+    if (len > 1) { dx /= len; dy /= len; len = 1; }
+    _knob.center = CGPointMake(r + dx * r * 0.62, r + dy * r * 0.62);
+    BOOL engaged = _down[0] || _down[1] || _down[2] || _down[3];
+    BOOL active = len >= (engaged ? 0.14 : 0.2);   // a resting thumb presses nothing
+    CGFloat deg = atan2(-dy, dx) * 180 / M_PI;     // screen y grows down
+    for (int i = 0; i < 4; i++) {
+        CGFloat off = fabs(remainder(deg - sp_stick_dir[i], 360));
+        [self sp_key:i down:active && off < sp_stick_half[i] + (_down[i] ? 7 : 0)];
+    }
+}
+
+- (void)sp_release {
+    for (int i = 0; i < 4; i++) [self sp_key:i down:NO];
+    _touch = nil;
+    self.center = _rest;
+    CGFloat r = [self sp_r];
+    _knob.center = CGPointMake(r, r);
+}
+
+- (void)touchesBegan:(NSSet<UITouch *> *)touches withEvent:(UIEvent *)event {
+    if (sp_edit_begin(self, touches) || _touch) return;
+    _touch = touches.anyObject;
+    _began = _touch.timestamp;
+    // A second short tap right after one: autorun on or off (F10, SPTouch's autorun).
+    if (_lastTap > 0 && _began - _lastTap < 0.35) {
+        _lastTap = 0;
+        sp_virtual_tap(0x6D, nil);
+        sp_touch_haptic();
+    }
+    CGPoint p = [_touch locationInView:self.superview];
+    // The centre where the thumb landed, so the first touch presses nothing (unless it landed far out).
+    if (sp_ts[SP_TS_CENTER]) [self sp_center_toward:p];
+    [self sp_follow:p];
+}
+
+- (void)touchesMoved:(NSSet<UITouch *> *)touches withEvent:(UIEvent *)event {
+    if (sp_edit_move(self, touches)) return;
+    if (_touch && [touches containsObject:_touch]) [self sp_follow:[_touch locationInView:self.superview]];
+}
+
+- (void)touchesEnded:(NSSet<UITouch *> *)touches withEvent:(UIEvent *)event {
+    if (sp_edit_end(self, touches, NO)) return;
+    if (_touch && [touches containsObject:_touch]) {
+        NSTimeInterval t = _touch.timestamp;
+        _lastTap = t - _began < 0.25 ? t : 0;
+        [self sp_release];
+    }
+}
+
+- (void)touchesCancelled:(NSSet<UITouch *> *)touches withEvent:(UIEvent *)event {
+    if (sp_edit_end(self, touches, YES)) return;
+    if (_touch && [touches containsObject:_touch]) [self sp_release];
+}
+@end
+
+// ---- the camera pad: a one-finger right-button drag
+
+@interface SPLookPad : UIView
+- (void)sp_release;
+- (void)sp_relabel;
+@end
+
+@implementation SPLookPad {
+    UITouch *_touch;
+    UITouch *_second;               // a second finger: the two pinch, which zooms
+    CGPoint _start, _last, _virt;   // UIKit points in the root view; _virt is the mouse, scaled
+    BOOL _pressed;
+    BOOL _spent;                    // the first finger pinched: no turn or tap from it any more
+    CGFloat _pinch;                 // the fingers' distance at the last wheel step
+    NSTimeInterval _lastTap;        // the last tap's lift; taps there in a row count up (double, triple)
+    CGPoint _tapAt;                 // where the row's first tap was
+    int _taps;                      // taps lifted in the row so far
+    BOOL _acted;                    // this touch did the row's action as it landed: no click on its lift
+    NSUInteger _tapGen;             // bumped per touch, so a double's wait for a third does nothing stale
+    UILabel *_label;
+}
+
+// The mouse wheel, one notch: +1 (fingers apart) zooms in, as the wheel turned away from you.
+static void sp_wheel(CGFloat notches) {
+    SPEvent *e = sp_event(SPScrollWheel);
+    e->deltaY = notches;
+    e->scrollingDeltaY = notches;
+    e->precise = NO;
+    e->phase = 0;
+    sp_post(e);
+}
+
+- (instancetype)initWithFrame:(CGRect)frame {
+    if (!(self = [super initWithFrame:frame])) return nil;
+    self.backgroundColor = [UIColor colorWithWhite:1 alpha:0.06];
+    self.layer.borderColor = [UIColor colorWithWhite:1 alpha:0.28].CGColor;
+    self.layer.borderWidth = 1.5;
+    _label = [[UILabel alloc] init];
+    [self sp_relabel];
+    _label.numberOfLines = 2;
+    _label.adjustsFontSizeToFitWidth = YES;
+    _label.minimumScaleFactor = 0.6;
+    self.multipleTouchEnabled = YES;
+    _label.textAlignment = NSTextAlignmentCenter;
+    _label.textColor = [UIColor colorWithWhite:1 alpha:0.5];
+    _label.font = [UIFont boldSystemFontOfSize:12];
+    _label.userInteractionEnabled = NO;
+    [self addSubview:_label];
+    return self;
+}
+
+- (void)layoutSubviews {
+    [super layoutSubviews];
+    self.layer.cornerRadius = MIN(18, self.bounds.size.height / 4);
+    _label.frame = self.bounds;
+}
+
+- (CGPoint)sp_at:(UITouch *)t {
+    return [t locationInView:sp_touch_controls.superview];
+}
+
+- (void)touchesBegan:(NSSet<UITouch *> *)touches withEvent:(UIEvent *)event {
+    if (sp_edit_begin(self, touches)) return;
+    for (UITouch *t in touches) {
+        if (!_touch) {
+            _touch = t;
+            _start = _last = _virt = [self sp_at:_touch];
+            _pressed = NO;
+            _spent = NO;
+            self.backgroundColor = [UIColor colorWithWhite:1 alpha:0.16];
+            [self sp_landed:_start at:_touch.timestamp];
+        } else if (!_second && t != _touch) {
+            _second = t;
+            [self sp_pinch_begin];
+        }
+    }
+}
+
+// Two fingers: a turn under way ends, the mouse goes over the world (the pad's middle, where a wheel
+// zooms the camera rather than scrolling a window), and the pinch begins.
+- (void)sp_pinch_begin {
+    if (_pressed) sp_mouse_button(1, NO, sp_pointer);
+    _pressed = NO;
+    _spent = YES;
+    CGPoint mid = CGPointMake(CGRectGetMidX(self.bounds), CGRectGetMidY(self.bounds));
+    sp_mouse_moved_to(sp_from_uikit([self convertPoint:mid toView:sp_touch_controls.superview]), sp_motion_type(), NO);
+    CGPoint a = [self sp_at:_touch], b = [self sp_at:_second];
+    _pinch = hypot(a.x - b.x, a.y - b.y);
+}
+
+// The press waits until the finger has moved, so a resting finger right-clicks nothing; then down where
+// it landed and a drag from there, as sp_chord_resolve does for two fingers. Vertical moves count for
+// less than across: a sideways swipe mostly turns, and tilts the camera only a little.
+- (void)touchesMoved:(NSSet<UITouch *> *)touches withEvent:(UIEvent *)event {
+    if (sp_edit_move(self, touches)) return;
+    if (_touch && _second) {
+        // A wheel notch for every 16 points the fingers spread or close.
+        CGPoint a = [self sp_at:_touch], b = [self sp_at:_second];
+        CGFloat d = hypot(a.x - b.x, a.y - b.y), step = 16;
+        for (; d - _pinch >= step; _pinch += step) sp_wheel(1);
+        for (; _pinch - d >= step; _pinch -= step) sp_wheel(-1);
+        return;
+    }
+    if (!_touch || _spent || ![touches containsObject:_touch]) return;
+    CGPoint p = [self sp_at:_touch];
+    if (!_pressed) {
+        if (hypot(p.x - _start.x, p.y - _start.y) < 7) return;
+        _pressed = YES;
+        sp_mouse_button(1, YES, sp_from_uikit(_start));
+    }
+    CGFloat speed = sp_ts_look_speed[sp_ts[SP_TS_LOOK]];
+    _virt.x += (p.x - _last.x) * speed;
+    _virt.y += (p.y - _last.y) * speed * 0.7;
+    _last = p;
+    CGPoint m = sp_from_uikit(_virt);
+    if (m.x != sp_pointer.x || m.y != sp_pointer.y) sp_mouse_moved_to(m, sp_motion_type(), NO);
+}
+
+- (void)touchesEnded:(NSSet<UITouch *> *)touches withEvent:(UIEvent *)event {
+    if (sp_edit_end(self, touches, NO)) return;
+    if (_second && [touches containsObject:_second]) _second = nil;
+    if (!_touch || ![touches containsObject:_touch]) return;
+    if (_second) {   // the first finger up, the second still down: it takes over the pinch's end
+        _touch = _second;
+        _second = nil;
+        return;
+    }
+    if (!_pressed && !_spent && !_acted) [self sp_tapped:_start at:_touch.timestamp];
+    else if (_pressed || _spent) _taps = 0;   // a turn or a pinch ends the row
+    _acted = NO;
+    [self sp_release];
+}
+
+- (void)touchesCancelled:(NSSet<UITouch *> *)touches withEvent:(UIEvent *)event {
+    if (sp_edit_end(self, touches, YES)) return;
+    if ((_touch && [touches containsObject:_touch]) || (_second && [touches containsObject:_second])) [self sp_release];
+}
+
+// A tap: a left click where it landed (select what's there), as a tap anywhere else is. Taps in a row
+// there (each landing within 0.3 s of the last one's lift, near the first) are a double or a triple
+// tap, the settings' actions, done as the finger lands (sp_landed), not on its lift: a double at once
+// when there's no triple; with a triple set, a double waits 0.3 s after its lift for a third.
+- (void)sp_landed:(CGPoint)p at:(NSTimeInterval)t {
+    _acted = NO;
+    BOOL row = _taps > 0 && t - _lastTap < 0.3 && hypot(p.x - _tapAt.x, p.y - _tapAt.y) < 50;
+    if (!row) {
+        _taps = 0;
+        _tapAt = p;
+        return;
+    }
+    _tapGen++;   // a double waiting for a third: this is the third, or a new row
+    int two = sp_gesture_get(2), three = sp_gesture_get(3);
+    if (_taps == 1 && two && !three) {
+        _acted = YES;
+        _taps = 0;
+        sp_gesture_do(two, p);
+    } else if (_taps == 2 && three) {
+        _acted = YES;
+        _taps = 0;
+        sp_gesture_do(three, p);
+    }
+}
+
+- (void)sp_tapped:(CGPoint)p at:(NSTimeInterval)t {
+    _taps++;
+    _lastTap = t;
+    int two = sp_gesture_get(2), three = sp_gesture_get(3);
+    if (_taps == 1) {
+        sp_gesture_do(0, p);
+        if (!two && !three) _taps = 0;
+    } else if (_taps == 2 && three) {
+        NSUInteger gen = ++_tapGen;
+        __weak SPLookPad *weak = self;
+        dispatch_after(dispatch_time(DISPATCH_TIME_NOW, (int64_t)(0.3 * NSEC_PER_SEC)), dispatch_get_main_queue(), ^{
+            SPLookPad *me = weak;
+            if (!me || me->_tapGen != gen) return;
+            me->_taps = 0;
+            sp_gesture_do(two, p);
+        });
+    } else {
+        _taps = 0;
+        sp_gesture_do(0, p);
+    }
+}
+
+// The label: what the pad does, with the double and triple taps as set.
+- (void)sp_relabel {
+    NSMutableString *t = [NSMutableString stringWithString:@"Kamera\n◀ wischen ▶ · 2 Finger: Zoom"];
+    int two = sp_gesture_get(2), three = sp_gesture_get(3);
+    if (two) [t appendFormat:@"\n2×: %s", sp_gestures[two].title];
+    if (three) [t appendFormat:@"%@3×: %s", two ? @" · " : @"\n", sp_gestures[three].title];
+    _label.numberOfLines = 3;
+    _label.text = t;
+}
+
+// The release where the mouse is: anywhere else would move it first, mid-mouselook a jump.
+- (void)sp_release {
+    if (_pressed) sp_mouse_button(1, NO, sp_pointer);
+    _pressed = NO;
+    _touch = nil;
+    _second = nil;
+    _spent = NO;
+    self.backgroundColor = [UIColor colorWithWhite:1 alpha:0.06];
+}
+@end
+
