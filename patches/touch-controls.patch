+- (instancetype)initWithFrame:(CGRect)frame {
+    if (!(self = [super initWithFrame:frame])) return nil;
+    self.backgroundColor = [UIColor colorWithWhite:0.08 alpha:0.95];
+    self.layer.cornerRadius = 14;
+    self.layer.borderWidth = 1;
+    self.layer.borderColor = [UIColor colorWithWhite:1 alpha:0.25].CGColor;
+    self.overrideUserInterfaceStyle = UIUserInterfaceStyleDark;   // the controls drawn for a dark panel
+    _title = [[UILabel alloc] init];
+    _title.text = @"Touch-Steuerung";
+    _title.font = [UIFont boldSystemFontOfSize:16];
+    _title.textColor = UIColor.whiteColor;
+    _title.adjustsFontSizeToFitWidth = YES;
+    _title.minimumScaleFactor = 0.7;
+    [self addSubview:_title];
+    NSMutableArray *titles = [NSMutableArray array];
+    for (int t = 0; t < SP_TAB_COUNT; t++) [titles addObject:@(sp_tab_titles[t])];
+    _tabs = [[UISegmentedControl alloc] initWithItems:titles];
+    [_tabs addTarget:self action:@selector(sp_tab_picked) forControlEvents:UIControlEventValueChanged];
+    [self addSubview:_tabs];
+    _scroll = [[SPPanelScroll alloc] initWithFrame:CGRectZero];
+    _scroll.delaysContentTouches = NO;
+    _scroll.alwaysBounceVertical = YES;
+    _scroll.indicatorStyle = UIScrollViewIndicatorStyleWhite;
+    [self addSubview:_scroll];
+    _items = [NSMutableArray array];
+    _profileButtons = [NSMutableArray array];
+    _editButton = [self sp_button:@"Bearbeiten" action:@selector(sp_edit_tapped)];
+    _finish = [self sp_button:@"Fertig" action:@selector(sp_finished)];
+    _finish.titleLabel.font = [UIFont boldSystemFontOfSize:17];
+    _finish.backgroundColor = [UIColor colorWithWhite:1 alpha:0.18];
+    // The addon's options at the bottom, always there: its own window opens in the game.
+    _addonButton = [self sp_button:@"Addon-Optionen" action:@selector(sp_addon_tapped)];
+    [self addSubview:_editButton];
+    [self addSubview:_addonButton];
+    [self addSubview:_finish];
+    // The tab shown last time (not part of a layout: no sp_touch_ name).
+    NSInteger tab = [[NSUserDefaults.standardUserDefaults objectForKey:@"sp_panel_tab"] integerValue];
+    _tab = tab >= 0 && tab < SP_TAB_COUNT ? tab : 0;
+    _tabs.selectedSegmentIndex = _tab;
+    [self sp_build_tab];
