+// A button in the strip beside the game: a tap, and optionally a hold (half a second).
+@interface SPStripButton : UIView
+- (instancetype)initWithTitle:(NSString *)title symbol:(NSString *)symbol;
+@property(nonatomic, copy) void (^tap)(void);
+@property(nonatomic, copy) void (^hold)(void);
+@property(nonatomic) BOOL on;   // drawn lit
+@property(nonatomic) CGFloat slack;   // how far above and below it a touch still counts (half the gap to the next)
+// While editing: dragged up or down the strip (its centre's y in the superview; done at the lift), to
+// change places with its neighbours. A button with none stays where it is.
+@property(nonatomic, copy) void (^drag)(CGFloat y, BOOL done);
+- (void)sp_set_title:(NSString *)title;
+@end
+
+@implementation SPStripButton {
+    UITouch *_touch;
+    UILabel *_label;
+    UIImageView *_image;
+    NSUInteger _gen;   // bumped per touch, so a stale hold timer does nothing
+    BOOL _held;
+    BOOL _dragging;    // being moved along the strip (editing)
+}
+
+- (instancetype)initWithTitle:(NSString *)title symbol:(NSString *)symbol {
+    if (!(self = [super initWithFrame:CGRectZero])) return nil;
+    self.layer.borderWidth = 1;
+    self.layer.cornerRadius = 10;
+    UIImage *img = symbol ? [UIImage systemImageNamed:symbol withConfiguration:
+                             [UIImageSymbolConfiguration configurationWithPointSize:17 weight:UIImageSymbolWeightSemibold]] : nil;
+    if (img) {
+        _image = [[UIImageView alloc] initWithImage:img];
+        _image.contentMode = UIViewContentModeCenter;
+        _image.userInteractionEnabled = NO;
+        [self addSubview:_image];
+    } else {
+        _label = [[UILabel alloc] init];
+        _label.text = title;
+        _label.font = [UIFont boldSystemFontOfSize:12];
+        _label.textAlignment = NSTextAlignmentCenter;
+        _label.adjustsFontSizeToFitWidth = YES;
+        _label.minimumScaleFactor = 0.7;
+        _label.userInteractionEnabled = NO;
+        [self addSubview:_label];
+    }
+    [self sp_draw:NO];
+    return self;
+}
+
+- (void)sp_set_title:(NSString *)title {
+    _label.text = title;
+}
+
+- (void)setOn:(BOOL)on {
+    _on = on;
+    [self sp_draw:_touch != nil];
+}
+
+- (void)sp_draw:(BOOL)pressed {
+    CGFloat bg = pressed ? 0.45 : _on ? 0.28 : 0.10;
+    self.backgroundColor = [UIColor colorWithWhite:1 alpha:bg];
+    self.layer.borderColor = [UIColor colorWithWhite:1 alpha:_on ? 0.6 : 0.3].CGColor;
+    UIColor *fg = [UIColor colorWithWhite:1 alpha:_on || pressed ? 1 : 0.6];
+    _label.textColor = fg;
+    _image.tintColor = fg;
+}
+
+- (void)layoutSubviews {
+    [super layoutSubviews];
+    _label.frame = CGRectInset(self.bounds, 3, 2);
+    _image.frame = self.bounds;
+}
+
+- (BOOL)pointInside:(CGPoint)p withEvent:(UIEvent *)event {
+    return CGRectContainsPoint(CGRectInset(self.bounds, -8, -_slack), p);
+}
+
+- (void)touchesBegan:(NSSet<UITouch *> *)touches withEvent:(UIEvent *)event {
+    if (_touch) return;
+    _touch = touches.anyObject;
+    _held = NO;
+    NSUInteger gen = ++_gen;
+    [self sp_draw:YES];
+    if (!_hold) return;
+    __weak SPStripButton *weak = self;
+    dispatch_after(dispatch_time(DISPATCH_TIME_NOW, (int64_t)(0.5 * NSEC_PER_SEC)), dispatch_get_main_queue(), ^{
+        SPStripButton *me = weak;
+        if (!me || me->_gen != gen || !me->_touch) return;
+        me->_held = YES;
+        sp_touch_haptic();
+        me.hold();
+    });
+}
+
+- (void)touchesMoved:(NSSet<UITouch *> *)touches withEvent:(UIEvent *)event {
+    if (!_touch || ![touches containsObject:_touch] || !_drag || !sp_touch_editing || _held) return;
+    CGFloat y = [_touch locationInView:self.superview].y;
+    if (!_dragging && fabs(y - self.center.y) < 10) return;
+    _dragging = YES;
+    _gen++;   // no hold from here
+    self.center = CGPointMake(self.center.x, y);
+    _drag(y, NO);
+}
+
+- (void)touchesEnded:(NSSet<UITouch *> *)touches withEvent:(UIEvent *)event {
+    if (!_touch || ![touches containsObject:_touch]) return;
+    BOOL inside = [self pointInside:[_touch locationInView:self] withEvent:event];
+    _touch = nil;
+    _gen++;
+    [self sp_draw:NO];
+    if (_dragging) {
+        _dragging = NO;
+        sp_touch_haptic();
+        if (_drag) _drag(self.center.y, YES);
+        return;
+    }
+    if (inside && !_held && _tap) {
+        sp_touch_haptic();
+        _tap();
+    }
+}
+
+- (void)touchesCancelled:(NSSet<UITouch *> *)touches withEvent:(UIEvent *)event {
+    if (!_touch || ![touches containsObject:_touch]) return;
+    _touch = nil;
+    _gen++;
+    [self sp_draw:NO];
+    if (_dragging) {
+        _dragging = NO;
+        if (_drag) _drag(self.center.y, YES);
+    }
+}
+@end
+
+// ---- the keyboard: the system's, its text sent as key presses
+
+// Typed text, a character at a time, each as a press of the ISO section key (0x0A) with that character:
+// the game takes a text box's text from the event's characters, and its key bindings from the key code,
+// so a letter typed with no box open (or before the box has the keyboard) presses nothing bound to it.
+// Before, each went as its own key: "hallo" pressed H, A, L, and O wherever they were bound, and an M
+// opened the map.
+static void sp_type_text(NSString *text) {
+    [text enumerateSubstringsInRange:NSMakeRange(0, text.length) options:NSStringEnumerationByComposedCharacterSequences
+                          usingBlock:^(NSString *ch, NSRange r, NSRange er, BOOL *stop) {
+        sp_virtual_tap(0x0A, ch);
+    }];
+}
+
+// A command into the game's chat: F9 (SPTouch opens the chat), the text, Return.
+static void sp_chat_command(NSString *cmd) {
+    sp_chat_key();
+    sp_type_text(cmd);
+    sp_virtual_tap(0x24, nil);
+}
+
+// ---- the game's state, from the SPTouch addon (SPTouchStrip.lua): in combat, mounted, on a flight, the
+// world map open, dead, resting, in an instance; the form or stance; the class, the level, and who it is
+// ("Name-Realm"). An addon has no way out of the game but pixels, so it draws this as frames of the app's
+// own strip (sphover.m, the format SPKeyboard's and SPHover's share), of kind 'T', for a few frames at each
+// change and again every few seconds, over SPKeyboard's strip. Nothing here acts on a state older than
+// sp_gs_stale_ns: the UI hidden, a loading screen, the addon off or not there.
+#include <string.h>
+#include <time.h>   // clock_gettime_nsec_np (again at the frame limit, below)
+enum { SP_GS_COMBAT = 1, SP_GS_MOUNT = 2, SP_GS_TAXI = 4, SP_GS_MAP = 8, SP_GS_DEAD = 16, SP_GS_REST = 32, SP_GS_INSTANCE = 64 };
+typedef struct {
+    int flags, form, klass, level;   // form: 1 bear, 2 cat, 3 travel, 4 aquatic, 5 moonkin, 6 battle stance,
+                                     // 7 defensive, 8 berserker, 9 stealth, 10 shadowform, 11 ghost wolf,
+                                     // 255 another, 0 none; klass: the game's class number (1 warrior …)
+    char who[64];                    // "Name-Realm", UTF-8
+} sp_game_state;
+static sp_game_state sp_gs;
+static volatile int sp_gs_flags;           // sp_gs.flags, for the render thread (sp_next_drawable)
+static volatile uint64_t sp_gs_at_ns;      // the last frame's arrival; 0: none yet
+static const uint64_t sp_gs_stale_ns = 12000000000ull;   // three of the addon's 4 s repeats
+
+// ---- strip state parser (plain C, tested on its own against SPTouchStrip.lua's frames)
+// One frame of kind 'T' (sphoverstrip.h has checked 'V' 'T' and its checksum) into *st: after 'V' 'T',
+// the sequence number, the chunk and the chunk count (one of one), the payload: version 1, the flags,
+// the form, the class, the level, the name's length in bytes, the name. 0 for anything else.
+static int sp_gs_parse(const uint8_t *frame, size_t frame_bytes, sp_game_state *st) {
+    if (frame_bytes < 13 || frame[0] != 'V' || frame[1] != 'T' || frame[3] != 0 || frame[4] != 1) return 0;
+    const uint8_t *p = frame + 5;
+    size_t room = frame_bytes - 7;   // the payload, less the two checksum bytes at the end
+    if (p[0] != 1) return 0;
+    st->flags = p[1];
+    st->form = p[2];
+    st->klass = p[3];
+    st->level = p[4];
+    size_t n = p[5];
+    if (n > room - 6) n = room - 6;
+    if (n > sizeof st->who - 1) n = sizeof st->who - 1;
+    memcpy(st->who, p + 6, n);
+    st->who[n] = 0;
+    return 1;
+}
+// ---- end of the strip state parser
+
+static BOOL sp_gs_known(void) {
+    return sp_gs_at_ns != 0;
+}
+
+static BOOL sp_gs_fresh(void) {
+    uint64_t at = sp_gs_at_ns;
+    return at && clock_gettime_nsec_np(CLOCK_UPTIME_RAW) - at < sp_gs_stale_ns;
+}
+
+// "Name-Realm" and the name alone, nil until the addon has said.
+static NSString *sp_gs_who(void) {
+    if (!sp_gs_known() || !sp_gs.who[0]) return nil;
+    NSString *s = [NSString stringWithUTF8String:sp_gs.who];
+    return s.length ? s : nil;
+}
+
+static NSString *sp_gs_name(void) {
+    NSString *who = sp_gs_who();
+    if (!who) return nil;
+    NSRange dash = [who rangeOfString:@"-"];
+    return dash.location == NSNotFound ? who : [who substringToIndex:dash.location];
+}
+
+// ---- the frame limit: the game asks its CAMetalLayer for each frame's drawable (nextDrawable); that
+// waits here until the frame's turn, so the game draws (and the CPU and GPU work, and the battery
+// drains) at most that many frames a second. The cadence is kept, a late frame owes nothing: the next
+// is a whole frame after it. By the runtime, so nothing links QuartzCore.
+#include <objc/runtime.h>
+#include <time.h>
+
+static const int sp_fps_rates[5] = { 0, 30, 45, 60, 120 };
+static const int sp_saver_seconds[5] = { 0, 5, 10, 15, 30 };
+static const uint64_t sp_saver_frame_ns = 1000000000ull / 10;   // 10 FPS: still readable, half of 20's work
+// Hitzeschutz, in steps rather than one drop: hot (thermal state serious) takes the limit to 45, still
+// hot a minute and a half later to 30, and critical to 20 at once; cooler again, a step back up each
+// minute. So a 60 FPS setting runs at 60 for as long as the phone stays cool enough, and settles at the
+// rate it can hold.
+static const int sp_heat_rates[4] = { 0, 45, 30, 20 };
+static volatile uint64_t sp_heat_frame_ns;  // the step's frame time; 0: no step
+static volatile int sp_heat_step;           // 0..3 into sp_heat_rates
+static uint64_t sp_heat_stepped_ns;         // when it last changed
+static volatile BOOL sp_heat_on;            // the setting
+static volatile BOOL sp_hot;                // thermal state serious or critical (fair, when charging)
+static volatile BOOL sp_charge_on;          // Laden-Schutz
+static volatile BOOL sp_charging;           // plugged in (charging or full), with Laden-Schutz on
+static const uint64_t sp_charge_frame_ns = 1000000000ull / 30;
+// Außerhalb vom Kampf: the frame time out of combat (as the addon tells it, fresh); 0: the limit as it is.
+static const int sp_calm_rates[4] = { 0, 45, 30, 20 };
+static volatile uint64_t sp_calm_frame_ns;
+
+static BOOL sp_calm_holds(void) {
+    return sp_calm_frame_ns && sp_gs_fresh() && !(sp_gs_flags & SP_GS_COMBAT);
+}
+
+// Called at each change of the thermal state, and every 15 seconds (the status timer).
+static void sp_heat_tick(void) {
+    NSProcessInfoThermalState st = NSProcessInfo.processInfo.thermalState;
+    uint64_t now = clock_gettime_nsec_np(CLOCK_UPTIME_RAW);
+    uint64_t since = now - sp_heat_stepped_ns;
+    int step = sp_heat_step;
+    UIDeviceBatteryState bs = UIDevice.currentDevice.batteryState;
+    sp_charging = sp_charge_on && (bs == UIDeviceBatteryStateCharging || bs == UIDeviceBatteryStateFull);
+    sp_hot = st >= (sp_charging ? NSProcessInfoThermalStateFair : NSProcessInfoThermalStateSerious);
+    if (st >= NSProcessInfoThermalStateCritical) step = 3;
+    else if (sp_hot && (step == 0 || (step < 2 && since > 90ull * 1000000000ull))) step++;
+    else if (!sp_hot && step > 0 && since > 60ull * 1000000000ull) step--;
+    if (step != sp_heat_step) {
+        sp_heat_step = step;
+        sp_heat_stepped_ns = now;
+        fprintf(stderr, "[sp:AppKit] touch heat step %d (%d fps), thermal state %ld\n", step, sp_heat_rates[step], (long)st);
+    }
+    sp_heat_frame_ns = step ? 1000000000ull / (uint64_t)sp_heat_rates[step] : 0;
+}
+static volatile uint64_t sp_fps_frame_ns;   // 0: no limit
+static volatile uint64_t sp_saver_after_ns; // 0: no saver
+static volatile uint64_t sp_last_touch_ns;  // the last touch (or typed key)
+static volatile BOOL sp_saver_ok = YES;     // no controller or keyboard connected
+static volatile BOOL sp_touching;           // a finger is on the screen now (a held stick is no pause)
+static IMP sp_next_drawable_orig;
+
+static void sp_touch_activity(void) {
+    sp_last_touch_ns = clock_gettime_nsec_np(CLOCK_UPTIME_RAW);
+}
+
+static id sp_next_drawable(id self, SEL _cmd) {
+    uint64_t frame = sp_fps_frame_ns, after = sp_saver_after_ns;
+    uint64_t heat = sp_heat_frame_ns;
+    if (sp_heat_on && heat && frame < heat) frame = heat;
+    if (sp_charging && frame < sp_charge_frame_ns) frame = sp_charge_frame_ns;
+    if (frame < sp_calm_frame_ns && sp_calm_holds()) frame = sp_calm_frame_ns;
+    if (after && sp_saver_ok && !sp_touching && frame < sp_saver_frame_ns
+        && clock_gettime_nsec_np(CLOCK_UPTIME_RAW) - sp_last_touch_ns > after)
+        frame = sp_saver_frame_ns;
+    // For the log, every 30 s: the frames asked for, the limit, the time waited (spconsole.log).
+    static uint64_t calls, slept, logged;
+    uint64_t start = clock_gettime_nsec_np(CLOCK_UPTIME_RAW);
+    calls++;
+    if (frame) {
+        static uint64_t due;
+        uint64_t now = start;
+        if (due > now && due - now <= frame) {
+            uint64_t wait = due - now;
+            struct timespec ts = { (time_t)(wait / 1000000000ull), (long)(wait % 1000000000ull) };
+            nanosleep(&ts, NULL);
+            slept += wait;
+            now = due;
+        }
+        due = now + frame;
+    }
+    if (!logged) logged = start;
+    if (start - logged >= 30000000000ull) {
+        double secs = (start - logged) / 1e9;
+        fprintf(stderr, "[sp:AppKit] touch frame limit: %.1f drawables/s, limit %s, waited %.0f%% of the time\n",
+                calls / secs, frame ? [NSString stringWithFormat:@"%.0f fps", 1e9 / frame].UTF8String : "none",
+                slept / 1e9 / secs * 100);
+        calls = slept = 0;
+        logged = start;
+    }
+    return ((id (*)(id, SEL))sp_next_drawable_orig)(self, _cmd);
+}
+
+static void sp_fps_apply(void) {
+    UIApplication.sharedApplication.idleTimerDisabled = sp_ts[SP_TS_AWAKE] != 0;
+    int i = sp_ts[SP_TS_FPS], j = sp_ts[SP_TS_SAVER];
+    int rate = i > 0 && i < 5 ? sp_fps_rates[i] : 0;
+    int idle = j > 0 && j < 5 ? sp_saver_seconds[j] : 0;
+    sp_fps_frame_ns = rate ? 1000000000ull / (uint64_t)rate : 0;
+    sp_saver_after_ns = (uint64_t)idle * 1000000000ull;
+    sp_heat_on = sp_ts[SP_TS_HEAT] != 0;
+    sp_charge_on = sp_ts[SP_TS_CHARGE] != 0;
+    int calm = sp_ts[SP_TS_CALM] > 0 && sp_ts[SP_TS_CALM] < 4 ? sp_calm_rates[sp_ts[SP_TS_CALM]] : 0;
+    sp_calm_frame_ns = calm ? 1000000000ull / (uint64_t)calm : 0;
+    UIDevice.currentDevice.batteryMonitoringEnabled = YES;   // for Laden-Schutz's plugged in
+    sp_heat_tick();
+    if (!sp_last_touch_ns) sp_touch_activity();
+    if ((!rate && !idle && !sp_heat_on && !sp_charge_on && !calm) || sp_next_drawable_orig) return;
+    Class c = NSClassFromString(@"CAMetalLayer");
+    Method m = c ? class_getInstanceMethod(c, @selector(nextDrawable)) : NULL;
+    if (m) sp_next_drawable_orig = method_setImplementation(m, (IMP)sp_next_drawable);
+    sp_stub_log(m ? "touch frame limit: on -[CAMetalLayer nextDrawable]" : "touch frame limit: no CAMetalLayer nextDrawable");
+}
+
+// What limits the frames now, as the Akku tab says it (a finger on the screen: the pause's saver aside).
+static NSString *sp_limit_text(void) {
+    uint64_t frame = sp_fps_frame_ns;
+    NSString *why = @"Einstellung";
+    if (sp_heat_on && sp_heat_frame_ns && frame < sp_heat_frame_ns) { frame = sp_heat_frame_ns; why = @"Hitzeschutz"; }
+    if (sp_charging && frame < sp_charge_frame_ns) { frame = sp_charge_frame_ns; why = @"Laden-Schutz"; }
+    if (frame < sp_calm_frame_ns && sp_calm_holds()) { frame = sp_calm_frame_ns; why = @"kein Kampf"; }
+    return frame ? [NSString stringWithFormat:@"höchstens %.0f FPS (%@)", 1e9 / frame, why] : @"ohne Grenze";
+}
+
+static NSString *sp_thermal_word(void) {
+    switch (NSProcessInfo.processInfo.thermalState) {
+    case NSProcessInfoThermalStateFair: return @"warm";
+    case NSProcessInfoThermalStateSerious: return @"heiß";
+    case NSProcessInfoThermalStateCritical: return @"sehr heiß";
+    default: return @"normal";
+    }
+}
+
+// ---- the battery's use: its level at each change (and on the status's 15 s timer), the last hour's
+// samples; a rate once 5 minutes and 2 % lie between the oldest of them and now (the level moves in whole
+// percents, so less says nothing). Charging starts it over.
+enum { SP_BATT_SAMPLES = 64 };
+static double sp_batt_time[SP_BATT_SAMPLES];
+static float sp_batt_level[SP_BATT_SAMPLES];
+static int sp_batt_count;
+
+static void sp_batt_drop_first(void) {
+    memmove(sp_batt_time, sp_batt_time + 1, (size_t)(sp_batt_count - 1) * sizeof sp_batt_time[0]);
+    memmove(sp_batt_level, sp_batt_level + 1, (size_t)(sp_batt_count - 1) * sizeof sp_batt_level[0]);
+    sp_batt_count--;
+}
+
+static void sp_batt_note(float level, BOOL charging) {
+    if (charging || level < 0) {
+        sp_batt_count = 0;
+        return;
+    }
+    double now = clock_gettime_nsec_np(CLOCK_UPTIME_RAW) / 1e9;
+    // A level that went up (the charger, a moment) starts over too.
+    if (sp_batt_count && level > sp_batt_level[sp_batt_count - 1] + 0.001f) sp_batt_count = 0;
+    if (sp_batt_count && level == sp_batt_level[sp_batt_count - 1]) return;   // the first time at each level
+    if (sp_batt_count == SP_BATT_SAMPLES) sp_batt_drop_first();
+    sp_batt_time[sp_batt_count] = now;
+    sp_batt_level[sp_batt_count] = level;
+    sp_batt_count++;
+    while (sp_batt_count > 2 && now - sp_batt_time[0] > 3600) sp_batt_drop_first();
+}
+
+// Percent an hour the battery has fallen lately, from the oldest sample to the level now; -1 while it
+// can't be told yet.
+static double sp_batt_rate(float level) {
+    if (!sp_batt_count || level < 0) return -1;
+    double dt = clock_gettime_nsec_np(CLOCK_UPTIME_RAW) / 1e9 - sp_batt_time[0];
+    double dl = (double)(sp_batt_level[0] - level);
+    if (dt < 300 || dl < 0.019) return -1;
+    return dl * 100 / dt * 3600;
+}
+
+
+// ---- the two keyboards: the keyboard bar's (below) and the app's own (spkeyboard.m, since 1.6)
+//
+// Only one is ever up. The app's comes up by itself when a game text box takes focus; while ours is
+// open it doesn't (ours opens the chat itself, with F9 or a command, and types into it), nor for a
+// moment after ours closes (a command's chat line is still being sent then), nor at all with
+// "App-Tastatur im Chat" Aus, unless the edit menu's Keyboard just asked for it. Opening ours closes
+// the app's first.
+static BOOL sp_keyboard_up(void);       // spkeyboard.m
+static void sp_keyboard_close(void);    // spkeyboard.m
+static UIView *sp_touch_sink_view;      // the keyboard bar's keyboard: up while it's first responder
+static uint64_t sp_touch_kb_quiet_ns;   // the app's keyboard waits until then
+static uint64_t sp_touch_kb_asked_ns;   // the edit menu's Keyboard: allowed until then
+
+static BOOL sp_touch_keyboard_open(void) {
+    return sp_touch_sink_view.isFirstResponder;
+}
+
+// spkeyboard.m, before it comes up for a box that took focus.
+static BOOL sp_touch_keyboard_blocks(void) {
+    if (sp_touch_keyboard_open()) return YES;
+    uint64_t now = clock_gettime_nsec_np(CLOCK_UPTIME_RAW);
+    if (now < sp_touch_kb_asked_ns) return NO;
+    if (now < sp_touch_kb_quiet_ns) return YES;
+    return sp_ts[SP_TS_APPKB] == 0;
+}
+
+// spkeyboard.m, when the edit menu's Keyboard is chosen: the box it focuses gets the keyboard.
+static void sp_touch_keyboard_asked(void) {
+    sp_touch_kb_asked_ns = clock_gettime_nsec_np(CLOCK_UPTIME_RAW) + 3000000000ull;
+}
+
+@interface SPKeyboardSink : UIView <UIKeyInput>
+@property(nonatomic, copy) void (^changed)(BOOL open);
+- (void)sp_open:(BOOL)chat;
+- (void)sp_close;
+@end
+
+// The bar over the keyboard: Esc, Chat and Tab on the left, what was typed (the game's own box is
+// usually under the keyboard), Fertig on the right.
+@interface SPKeyBar : UIView
+@property(nonatomic, strong) NSArray<UIView *> *left;
+@property(nonatomic, strong) UILabel *preview;
+@property(nonatomic, strong) UIView *right;
+@end
+
+@implementation SPKeyBar
+- (void)layoutSubviews {
+    [super layoutSubviews];
+    UIEdgeInsets s = self.safeAreaInsets;
+    CGRect b = self.bounds;
+    CGFloat x = b.origin.x + s.left + 8, h = b.size.height, end = CGRectGetMaxX(b) - s.right - 8;
+    for (UIView *v in _left) {
+        CGFloat w = MAX(58, [v sizeThatFits:CGSizeMake(200, h - 10)].width + 14);   // "/reload" is wider
+        v.frame = CGRectMake(x, 5, w, h - 10);
+        x += w + 6;
+    }
+    _right.frame = CGRectMake(end - 80, 5, 80, h - 10);
+    _preview.frame = CGRectMake(x + 6, 0, MAX(0, end - 86 - x - 6), h);
+}
+@end
+
+@implementation SPKeyboardSink {
+    SPKeyBar *_bar;
+    NSMutableString *_typed;   // what was typed since the last Return or Esc, for the bar
+    // The two command buttons: what each sends (sp_touch_cmds; "/sit" and "/reload" at first). Held, a
+    // button takes a new command: typed into the bar only, not the game, and kept at Return.
+    NSMutableArray<NSString *> *_cmds;
+    NSArray<UIButton *> *_cmdButtons;
+    NSInteger _assign;         // the button being given a command, or -1
+}
+
+- (instancetype)initWithFrame:(CGRect)frame {
+    if (!(self = [super initWithFrame:frame])) return nil;
+    self.backgroundColor = UIColor.clearColor;
+    _typed = [NSMutableString string];
+    _assign = -1;
+    _cmds = [NSMutableArray arrayWithArray:@[ @"/sit", @"/reload" ]];
+    NSArray *saved = [NSUserDefaults.standardUserDefaults arrayForKey:@"sp_touch_cmds"];
+    for (NSUInteger i = 0; i < 2 && i < saved.count; i++)
+        if ([saved[i] isKindOfClass:NSString.class] && [saved[i] length]) _cmds[i] = saved[i];
+    _bar = [[SPKeyBar alloc] initWithFrame:CGRectMake(0, 0, 320, 44)];
+    _bar.autoresizingMask = UIViewAutoresizingFlexibleWidth;
+    _bar.backgroundColor = [UIColor colorWithWhite:0.1 alpha:0.96];
+    NSMutableArray *left = [NSMutableArray array];
+    // After the keys, two commands sent whole with one tap: at first sit down or stand up, and reload
+    // the interface (which also saves the addons' and the game's settings).
+    for (NSString *t in @[ @"Esc", @"Chat", @"Tab", [self sp_cmd_title:_cmds[0]], [self sp_cmd_title:_cmds[1]] ]) {
+        UIButton *b = [self sp_button:t];
+        [left addObject:b];
+        [_bar addSubview:b];
+    }
+    [(UIButton *)left[0] addTarget:self action:@selector(sp_escape) forControlEvents:UIControlEventTouchUpInside];
+    [(UIButton *)left[1] addTarget:self action:@selector(sp_chat) forControlEvents:UIControlEventTouchUpInside];
+    [(UIButton *)left[2] addTarget:self action:@selector(sp_tab) forControlEvents:UIControlEventTouchUpInside];
+    _cmdButtons = @[ left[3], left[4] ];
+    for (UIButton *b in _cmdButtons) {
+        [b addTarget:self action:@selector(sp_cmd_tap:) forControlEvents:UIControlEventTouchUpInside];
+        [b addGestureRecognizer:[[UILongPressGestureRecognizer alloc] initWithTarget:self action:@selector(sp_cmd_hold:)]];
+    }
+    _bar.left = left;
+    UIButton *done = [self sp_button:@"Fertig"];
+    [done addTarget:self action:@selector(sp_close) forControlEvents:UIControlEventTouchUpInside];
+    _bar.right = done;
+    [_bar addSubview:done];
+    _bar.preview = [[UILabel alloc] init];
+    _bar.preview.font = [UIFont systemFontOfSize:15];
+    _bar.preview.lineBreakMode = NSLineBreakByTruncatingHead;
+    [_bar addSubview:_bar.preview];
+    [self sp_show_typed];
+    return self;
+}
+
+- (UIButton *)sp_button:(NSString *)title {
+    UIButton *b = [UIButton buttonWithType:UIButtonTypeSystem];
+    [b setTitle:title forState:UIControlStateNormal];
+    b.titleLabel.font = [UIFont boldSystemFontOfSize:15];
+    b.tintColor = UIColor.whiteColor;
+    b.backgroundColor = [UIColor colorWithWhite:1 alpha:0.12];
+    b.layer.cornerRadius = 8;
+    return b;
+}
+
+// A whole command: a line begun is dropped first (Esc closes the game's box, text and all), so the
+// command isn't added to it.
+- (void)sp_command:(NSString *)cmd {
+    sp_touch_activity();
+    sp_touch_haptic();
+    if (_typed.length) sp_virtual_tap(0x35, nil);
+    [_typed setString:@""];
+    sp_chat_command(cmd);
+    [self sp_show_typed];
+}
+// A button's title: its command, cut to fit.
+- (NSString *)sp_cmd_title:(NSString *)cmd {
+    return cmd.length > 10 ? [[cmd substringToIndex:9] stringByAppendingString:@"…"] : cmd;
+}
+
+- (void)sp_cmd_tap:(UIButton *)sender {
+    NSUInteger i = [_cmdButtons indexOfObject:sender];
+    if (i == NSNotFound) return;
+    if (_assign >= 0) {   // a tap while one is being set: leave that
+        [self sp_assign_end];
+        return;
+    }
+    NSString *cmd = _cmds[i];
+    [self sp_command:cmd];
+    // Reloading the interface: the keyboard out of the way.
+    if ([cmd.lowercaseString isEqualToString:@"/reload"] || [cmd.lowercaseString isEqualToString:@"/rl"]) [self sp_close];
+}
+
+// Held: the button's command is typed anew (see insertText:).
+- (void)sp_cmd_hold:(UILongPressGestureRecognizer *)g {
+    if (g.state != UIGestureRecognizerStateBegan) return;
+    NSUInteger i = [_cmdButtons indexOfObject:(UIButton *)g.view];
+    if (i == NSNotFound) return;
+    sp_touch_haptic();
+    if (_typed.length && _assign < 0) sp_virtual_tap(0x35, nil);   // a line begun in the game's box: dropped
+    [_typed setString:@""];
+    _assign = (NSInteger)i;
+    [self sp_show_typed];
+}
+
+- (void)sp_assign_end {
+    _assign = -1;
+    [_typed setString:@""];
+    [self sp_show_typed];
+}
+
+// Return while a button is being set: what was typed is its command from now on (nothing typed: as it was).
+- (void)sp_assign_save {
+    NSString *cmd = [_typed stringByTrimmingCharactersInSet:NSCharacterSet.whitespaceAndNewlineCharacterSet];
+    NSInteger i = _assign;
+    if (cmd.length && i >= 0 && i < 2) {
+        _cmds[(NSUInteger)i] = cmd;
+        [_cmdButtons[(NSUInteger)i] setTitle:[self sp_cmd_title:cmd] forState:UIControlStateNormal];
+        [NSUserDefaults.standardUserDefaults setObject:[_cmds copy] forKey:@"sp_touch_cmds"];
+        [NSUserDefaults.standardUserDefaults synchronize];
+        sp_layout_backup();
+        [_bar setNeedsLayout];
+    }
+    [self sp_assign_end];
+}
+
+- (void)sp_show_typed {
+    BOOL empty = !_typed.length;
+    if (_assign >= 0) {
+        _bar.preview.text = empty ? @"Neuer Befehl für den Knopf: tippen, Enter speichert (Esc bricht ab)"
+                                  : [@"Knopf: " stringByAppendingString:_typed];
+        _bar.preview.textColor = [UIColor colorWithRed:1 green:0.8 blue:0.3 alpha:0.95];
+        return;
+    }
+    _bar.preview.text = empty ? @"Schreiben … (Enter sendet)" : _typed;
+    _bar.preview.textColor = [UIColor colorWithWhite:1 alpha:empty ? 0.45 : 0.95];
+}
+
+- (UIView *)inputAccessoryView {
+    return _bar;
+}
+
+// Never a touch's view: it's only the keyboard's first responder.
+- (BOOL)pointInside:(CGPoint)p withEvent:(UIEvent *)event {
+    return NO;
+}
+
+// A hardware keyboard's presses while this has the keyboard: its text comes as insertText: too, so
+// passing them on (up the responder chain to the root view's pressesBegan:) would type it twice.
+- (void)pressesBegan:(NSSet<UIPress *> *)presses withEvent:(UIPressesEvent *)event {
+}
+- (void)pressesEnded:(NSSet<UIPress *> *)presses withEvent:(UIPressesEvent *)event {
+}
+- (void)pressesCancelled:(NSSet<UIPress *> *)presses withEvent:(UIPressesEvent *)event {
+}
+
+- (BOOL)canBecomeFirstResponder {
+    return YES;
+}
+
+// The system keyboard as a plain one: no corrections, capitals, or smart punctuation, which would
+// change text the game has already been sent.
+- (UITextAutocorrectionType)autocorrectionType { return UITextAutocorrectionTypeNo; }
+- (UITextAutocapitalizationType)autocapitalizationType { return UITextAutocapitalizationTypeNone; }
+- (UITextSpellCheckingType)spellCheckingType { return UITextSpellCheckingTypeNo; }
+- (UITextSmartQuotesType)smartQuotesType { return UITextSmartQuotesTypeNo; }
+- (UITextSmartDashesType)smartDashesType { return UITextSmartDashesTypeNo; }
+- (UITextSmartInsertDeleteType)smartInsertDeleteType { return UITextSmartInsertDeleteTypeNo; }
+- (UIKeyboardAppearance)keyboardAppearance { return UIKeyboardAppearanceDark; }
+- (UIReturnKeyType)returnKeyType { return UIReturnKeySend; }
+
+// Always: the game's box may hold text from before, which the delete key should still reach.
+- (BOOL)hasText {
+    return YES;
+}
+
+- (void)insertText:(NSString *)text {
+    sp_touch_activity();
+    if (_assign >= 0) {   // a button's new command: into the bar only
+        if ([text containsString:@"\n"] || [text containsString:@"\r"]) {
+            [self sp_assign_save];
+        } else {
+            [_typed appendString:text];
+            [self sp_show_typed];
+        }
+        return;
+    }
+    [text enumerateSubstringsInRange:NSMakeRange(0, text.length) options:NSStringEnumerationByComposedCharacterSequences
+                          usingBlock:^(NSString *ch, NSRange r, NSRange er, BOOL *stop) {
+        if ([ch isEqualToString:@"\n"] || [ch isEqualToString:@"\r"]) {
+            [self sp_return];
+            return;
+        }
+        // A line's first character opens the chat first (F9), in case nothing has the keyboard: after
+        // Esc closed the box, say. In a box that has it, F9 does nothing.
+        if (!self->_typed.length) [self sp_chat];
+        sp_type_text(ch);
+        [self->_typed appendString:ch];
+    }];
+    [self sp_show_typed];
+}
+
+- (void)deleteBackward {
+    if (_assign < 0) sp_virtual_tap(0x33, nil);  // Delete: deleteBackward: in the game's box
+    if (_typed.length) {
+        NSRange last = [_typed rangeOfComposedCharacterSequenceAtIndex:_typed.length - 1];
+        [_typed deleteCharactersInRange:last];
+    }
+    [self sp_show_typed];
+}
+
+// Return sends what's typed (and closes the chat box); with something typed, the keyboard closes
+// too, back to the game. With nothing typed it's the game's Enter, which opens the chat.
+- (void)sp_return {
+    BOOL sent = _typed.length > 0;
+    sp_virtual_tap(0x24, nil);
+    [_typed setString:@""];
+    [self sp_show_typed];
+    if (sent) dispatch_async(dispatch_get_main_queue(), ^{ [self sp_close]; });
+}
+
+- (void)sp_escape {
+    if (_assign >= 0) {
+        [self sp_assign_end];
+        return;
+    }
+    sp_virtual_tap(0x35, nil);
+    [_typed setString:@""];
+    [self sp_show_typed];
+}
+
+// F9: SPTouch binds it to open the chat. Unlike Enter it does nothing in a text box that already has
+// the keyboard (the chat's, a search field's): the box takes the key, and with no characters
+// (sp_chat_key) types nothing.
+- (void)sp_chat {
+    sp_chat_key();
+}
+
+- (void)sp_tab {
+    sp_virtual_tap(0x30, nil);
+}
+
+- (void)sp_open:(BOOL)chat {
+    if (self.isFirstResponder) return;
+    sp_touch_sink_view = self;
+    if (sp_keyboard_up()) {
+        // The app's keyboard first: it hands first responder back to the input view on the next turn
+        // of the main queue, so ours opens after that.
+        sp_stub_log("touch keyboard: the app's keyboard closed for the keyboard bar's");
+        sp_keyboard_close();
+        dispatch_async(dispatch_get_main_queue(), ^{
+            if (!sp_keyboard_up()) [self sp_open:chat];
+        });
+        return;
+    }
+    _assign = -1;
+    [_typed setString:@""];
+    [self sp_show_typed];
+    if (![self becomeFirstResponder]) return;
+    if (chat) [self sp_chat];
+    if (_changed) _changed(YES);
+}
+
+// Back to the root view, which takes a hardware keyboard's keys as first responder.
+- (void)sp_close {
+    _assign = -1;
+    sp_touch_kb_quiet_ns = clock_gettime_nsec_np(CLOCK_UPTIME_RAW) + 1500000000ull;
+    if (self.isFirstResponder) [self resignFirstResponder];
+    [self.superview.superview becomeFirstResponder];
+    if (_changed) _changed(NO);
+}
+@end
