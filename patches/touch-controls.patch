+// p: where the tap was, UIKit points in the root view.
+static void sp_gesture_do(int i, CGPoint p) {
+    if (i < 0 || i >= sp_gesture_count) i = 0;
+    unsigned short mac = sp_gestures[i].mac;
+    if (mac == 0xFFFF || mac == 0xFFFE) {
