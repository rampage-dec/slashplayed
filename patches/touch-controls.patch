+    CGRect b = self.bounds;
+    CGFloat pad = 12, gap = 6, w = b.size.width - 2 * pad;
+    CGFloat rowH = MAX(24, MIN(36, (b.size.height - 30 - 3 * 18 - 4 * gap - 44) / 4));
+    _title.frame = CGRectMake(pad, 6, w, 24);
+    CGFloat y = 32;
+    for (int s = 0; s < 3; s++) {
+        _sections[s].frame = CGRectMake(pad, y, w, 16);
+        y += 18;
+        int cols = s == 2 ? 11 : 6, n = 0;
+        CGFloat bw = (w - (cols - 1) * gap) / cols;
+        for (int i = 0; i < sp_add_count; i++) {
+            if (sp_add_items[i].section != s) continue;
+            _buttons[i].frame = CGRectMake(pad + (n % cols) * (bw + gap), y + (n / cols) * (rowH + gap), bw, rowH);
