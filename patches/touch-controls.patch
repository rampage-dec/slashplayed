+// ---- the layout as a file: every "sp_touch_*" default (pages, stick, settings) in Documents/
+// SPTouch-Layout.plist, written on each change, so it can be copied with the Files app into another
+// install (a new Apple ID makes a new app, with empty defaults). An app with no layout of its own takes
+// it from there at its start; the settings' "Layout laden" takes it any time.
+static NSString *sp_layout_path(void) {
+    const char *home = getenv("HOME");
+    return home ? [NSString stringWithFormat:@"%s/Documents/SPTouch-Layout.plist", home] : nil;
+}
+
+// A layout the player saved by hand ("Layout sichern"): never written on a change, so it's still what
+// it was after a slip (Standard, a button dragged away). "Layout laden" takes this one where there is one.
+static NSString *sp_layout_saved_path(void) {
+    const char *home = getenv("HOME");
+    return home ? [NSString stringWithFormat:@"%s/Documents/SPTouch-Layout-Gesichert.plist", home] : nil;
+}
+
+static void sp_layout_write(NSString *path);
+
+static void sp_layout_backup(void) {
+    sp_layout_write(sp_layout_path());
+}
+
+static BOOL sp_layout_has_saved(void) {
+    NSString *path = sp_layout_saved_path();
+    return path && [NSDictionary dictionaryWithContentsOfFile:path].count > 0;
+}
+
+// Before a Standard: the layout as it is into the saved file, where the player has saved none.
+static void sp_layout_keep_before_reset(void) {
+    if (!sp_layout_has_saved()) sp_layout_write(sp_layout_saved_path());
+}
+
+static void sp_layout_write(NSString *path) {
+    if (!path) return;
+    NSMutableDictionary *out = [NSMutableDictionary dictionary];
+    NSDictionary *all = NSUserDefaults.standardUserDefaults.dictionaryRepresentation;
+    for (NSString *k in all)
+        if ([k hasPrefix:@"sp_touch_"]) out[k] = all[k];
+    if (out.count) [out writeToFile:path atomically:YES];
+}
+
+// YES when the file was there and taken.
+static BOOL sp_layout_restore_from(NSString *path) {
+    NSDictionary *in = path ? [NSDictionary dictionaryWithContentsOfFile:path] : nil;
+    if (![in isKindOfClass:NSDictionary.class] || !in.count) return NO;
+    NSUserDefaults *d = NSUserDefaults.standardUserDefaults;
+    for (NSString *k in in)
+        if ([k isKindOfClass:NSString.class] && [k hasPrefix:@"sp_touch_"]) [d setObject:in[k] forKey:k];
+    [d synchronize];
+    sp_stub_log([NSString stringWithFormat:@"touch controls: layout taken from %@ (%lu settings)",
+                 path.lastPathComponent, (unsigned long)in.count].UTF8String);
+    return YES;
+}
+
+// The automatic file (an app with no layout of its own, at its start).
+static BOOL sp_layout_restore(void) {
+    return sp_layout_restore_from(sp_layout_path());
+}
+
+// ---- layout profiles: whole layouts kept under a name, Documents/SPTouch-Profile/<name>.plist, loaded
+// with a tap in the panel's Layout tab, and with Profil je Charakter each character's own at its login
+// (the SPTouch addon says who it is: sp_game_state, below). A profile holds the layout's keys: the pages
+// and what each shows by itself, the stick, the sizes and opacity, the taps, the strip's order. Not the
+// device's (the frame limits, the battery and heat settings, the screen, the app's keyboard, the keyboard
+// bar's two commands) nor the profiles' own bookkeeping: those stay as they are from profile to profile.
+//
+// The profile last loaded or saved is the active one (sp_touch_prof_active): before another is loaded,
+// the layout as it is goes back into it, so what was changed since isn't lost.
+static NSString *const sp_prof_global_keys[] = {
+    @"sp_touch_fps", @"sp_touch_saver2", @"sp_touch_saver", @"sp_touch_heat", @"sp_touch_charge", @"sp_touch_calm",
+    @"sp_touch_awake", @"sp_touch_batt", @"sp_touch_status", @"sp_touch_appkb", @"sp_touch_on", @"sp_touch_controls",
+    @"sp_touch_autopage", @"sp_touch_charprof", @"sp_touch_prof_active", @"sp_touch_charmap", @"sp_touch_cmds",
+};
+
+static BOOL sp_prof_is_global(NSString *key) {
+    for (size_t i = 0; i < sizeof sp_prof_global_keys / sizeof sp_prof_global_keys[0]; i++)
+        if ([key isEqualToString:sp_prof_global_keys[i]]) return YES;
+    return NO;
+}
+
+static NSString *sp_prof_dir(void) {
+    const char *home = getenv("HOME");
+    return home ? [NSString stringWithFormat:@"%s/Documents/SPTouch-Profile", home] : nil;
+}
+
+// A name as typed, made fit for a file name: trimmed, no slashes or colons, no leading dot, 30 characters
+// at most. nil when nothing's left.
+static NSString *sp_prof_clean(NSString *name) {
+    if (![name isKindOfClass:NSString.class]) return nil;
+    NSString *n = [name stringByTrimmingCharactersInSet:NSCharacterSet.whitespaceAndNewlineCharacterSet];
+    for (NSString *bad in @[ @"/", @"\\", @":" ]) n = [n stringByReplacingOccurrencesOfString:bad withString:@"-"];
+    while ([n hasPrefix:@"."]) n = [n substringFromIndex:1];
+    if (n.length > 30) n = [n substringToIndex:30];
+    n = [n stringByTrimmingCharactersInSet:NSCharacterSet.whitespaceAndNewlineCharacterSet];
+    return n.length ? n : nil;
+}
+
+static NSString *sp_prof_path(NSString *name) {
+    NSString *dir = sp_prof_dir();
+    return dir && name.length ? [dir stringByAppendingPathComponent:[name stringByAppendingString:@".plist"]] : nil;
+}
+
+static BOOL sp_prof_exists(NSString *name) {
+    NSString *path = sp_prof_path(name);
+    return path && [NSFileManager.defaultManager fileExistsAtPath:path];
+}
+
+// The profiles there are, by name, A to Z.
+static NSArray<NSString *> *sp_prof_names(void) {
+    NSString *dir = sp_prof_dir();
+    NSArray *files = dir ? [NSFileManager.defaultManager contentsOfDirectoryAtPath:dir error:NULL] : nil;
+    NSMutableArray<NSString *> *names = [NSMutableArray array];
+    for (NSString *f in files)
+        if ([f.pathExtension isEqualToString:@"plist"] && ![f hasPrefix:@"."]) [names addObject:f.stringByDeletingPathExtension];
+    return [names sortedArrayUsingSelector:@selector(localizedCaseInsensitiveCompare:)];
+}
+
+// The layout as it is now into the profile `name` (made, or written over).
+static BOOL sp_prof_write(NSString *name) {
+    NSString *path = sp_prof_path(name);
+    if (!path) return NO;
+    NSMutableDictionary *out = [NSMutableDictionary dictionary];
+    NSDictionary *all = NSUserDefaults.standardUserDefaults.dictionaryRepresentation;
+    for (NSString *k in all)
+        if ([k hasPrefix:@"sp_touch_"] && !sp_prof_is_global(k)) out[k] = all[k];
+    if (!out.count) return NO;
+    [NSFileManager.defaultManager createDirectoryAtPath:sp_prof_dir() withIntermediateDirectories:YES attributes:nil error:NULL];
+    return [out writeToFile:path atomically:YES];
+}
+
+// The profile `name` in place of the layout: the layout's keys there are now go first, so none of the old
+// layout's is left that the profile doesn't have. YES when it was there and taken.
+static BOOL sp_prof_apply(NSString *name) {
+    NSDictionary *in = [NSDictionary dictionaryWithContentsOfFile:sp_prof_path(name)];
+    if (![in isKindOfClass:NSDictionary.class] || ![in[@"sp_touch_pages"] isKindOfClass:NSArray.class]) return NO;
+    NSUserDefaults *d = NSUserDefaults.standardUserDefaults;
+    for (NSString *k in d.dictionaryRepresentation)
+        if ([k hasPrefix:@"sp_touch_"] && !sp_prof_is_global(k)) [d removeObjectForKey:k];
+    for (NSString *k in in)
+        if ([k isKindOfClass:NSString.class] && [k hasPrefix:@"sp_touch_"] && !sp_prof_is_global(k)) [d setObject:in[k] forKey:k];
+    [d synchronize];
+    sp_stub_log([NSString stringWithFormat:@"touch controls: layout profile taken (%lu settings)", (unsigned long)in.count].UTF8String);
+    return YES;
+}
+
+static NSString *sp_prof_active(void) {
+    NSString *n = [NSUserDefaults.standardUserDefaults stringForKey:@"sp_touch_prof_active"];
+    return n.length ? n : nil;
+}
+
+static void sp_prof_set_active(NSString *name) {
+    NSUserDefaults *d = NSUserDefaults.standardUserDefaults;
+    if (name.length) [d setObject:name forKey:@"sp_touch_prof_active"];
+    else [d removeObjectForKey:@"sp_touch_prof_active"];
+    [d synchronize];
+}
