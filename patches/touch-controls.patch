+- (void)sp_profile_tapped:(UIButton *)b {
+    NSInteger i = b.tag;
+    if (i < 0 || i >= (NSInteger)_profileNames.count) return;
+    NSString *name = _profileNames[(NSUInteger)i];
+    BOOL ok = _profile_load && _profile_load(name);
+    [self sp_build_tab];
+    if (!ok && _profileInfo) _profileInfo.text = [NSString stringWithFormat:@"„%@“ ging nicht zu laden.", name];
+}
+
+// A name typed into an alert: what's typed goes to `then`, cleaned (sp_prof_clean).
+- (void)sp_ask_name:(NSString *)title message:(NSString *)message text:(NSString *)text then:(void (^)(NSString *name))then {
+    UIAlertController *ac = [UIAlertController alertControllerWithTitle:title message:message
+                                                         preferredStyle:UIAlertControllerStyleAlert];
+    [ac addTextFieldWithConfigurationHandler:^(UITextField *f) {
+        f.text = text;
+        f.clearButtonMode = UITextFieldViewModeWhileEditing;
+        f.autocorrectionType = UITextAutocorrectionTypeNo;
+    }];
+    __weak UIAlertController *weak = ac;
+    [ac addAction:[UIAlertAction actionWithTitle:@"Abbrechen" style:UIAlertActionStyleCancel handler:nil]];
+    [ac addAction:[UIAlertAction actionWithTitle:@"Sichern" style:UIAlertActionStyleDefault handler:^(UIAlertAction *a) {
+        NSString *name = sp_prof_clean(weak.textFields.firstObject.text);
+        if (name) then(name);
+    }]];
+    [sp_presenter() presentViewController:ac animated:YES completion:nil];
+}
+
+// + Neues Profil: the layout as it is, under a name (at first the character's, where the addon has
+// said it), and from now on the active one (and the character's, with Profil je Charakter).
+- (void)sp_profile_new {
+    NSString *suggest = sp_gs_name() ?: [NSString stringWithFormat:@"Profil %lu", (unsigned long)_profileNames.count + 1];
+    __weak SPSettingsPanel *weak = self;
+    [self sp_ask_name:@"Neues Layout-Profil" message:@"Das Layout, wie es jetzt ist, unter diesem Namen:" text:suggest
+                 then:^(NSString *name) {
+        NSString *n = name;
+        for (int k = 2; sp_prof_exists(n) && k < 100; k++) n = [NSString stringWithFormat:@"%@ %d", name, k];
+        BOOL ok = sp_prof_write(n);
+        if (ok) {
+            sp_prof_set_active(n);
+            if (sp_ts[SP_TS_CHARPROF]) sp_prof_link(sp_gs_who(), n);
+            sp_layout_backup();
+        }
+        SPSettingsPanel *me = weak;
+        if (!me) return;
+        [me sp_build_tab];
+        if (!ok && me->_profileInfo) me->_profileInfo.text = @"Das Profil ging nicht zu sichern.";
+    }];
+}
+
+// Held: load, write over with the layout as it is, keep for the character, rename, delete.
+- (void)sp_profile_held:(UILongPressGestureRecognizer *)g {
+    if (g.state != UIGestureRecognizerStateBegan) return;
+    UIView *b = g.view;
+    NSInteger i = b.tag;
+    if (i < 0 || i >= (NSInteger)_profileNames.count) return;
+    NSString *name = _profileNames[(NSUInteger)i], *who = sp_gs_who();
+    sp_touch_haptic();
+    __weak SPSettingsPanel *weak = self;
+    UIAlertController *ac = [UIAlertController alertControllerWithTitle:[NSString stringWithFormat:@"Profil „%@“", name]
+                                                                message:nil preferredStyle:UIAlertControllerStyleActionSheet];
+    [ac addAction:[UIAlertAction actionWithTitle:@"Laden" style:UIAlertActionStyleDefault handler:^(UIAlertAction *a) {
+        SPSettingsPanel *me = weak;
+        if (me && me->_profile_load) me->_profile_load(name);
+        [me sp_build_tab];
+    }]];
+    [ac addAction:[UIAlertAction actionWithTitle:@"Mit dem jetzigen Layout überschreiben" style:UIAlertActionStyleDefault
+                                         handler:^(UIAlertAction *a) {
+        if (sp_prof_write(name)) {
+            sp_prof_set_active(name);
+            sp_layout_backup();
+        }
+        [weak sp_build_tab];
+    }]];
+    if (who) {
+        [ac addAction:[UIAlertAction actionWithTitle:[NSString stringWithFormat:@"Für %@ merken", sp_gs_name()]
+                                               style:UIAlertActionStyleDefault handler:^(UIAlertAction *a) {
+            sp_prof_link(who, name);
+            sp_layout_backup();
+            [weak sp_build_tab];
+        }]];
+    }
+    [ac addAction:[UIAlertAction actionWithTitle:@"Umbenennen …" style:UIAlertActionStyleDefault handler:^(UIAlertAction *a) {
+        SPSettingsPanel *me = weak;
+        [me sp_ask_name:@"Profil umbenennen" message:nil text:name then:^(NSString *to) {
+            BOOL ok = sp_prof_rename(name, to);
+            SPSettingsPanel *me2 = weak;
+            if (!me2) return;
+            [me2 sp_build_tab];
+            if (!ok && me2->_profileInfo) me2->_profileInfo.text = [NSString stringWithFormat:@"„%@“ gibt es schon, oder es ging nicht.", to];
+        }];
+    }]];
+    [ac addAction:[UIAlertAction actionWithTitle:@"Löschen" style:UIAlertActionStyleDestructive handler:^(UIAlertAction *a) {
+        sp_prof_delete(name);
+        [weak sp_build_tab];
+    }]];
+    [ac addAction:[UIAlertAction actionWithTitle:@"Abbrechen" style:UIAlertActionStyleCancel handler:nil]];
+    // An iPad shows it as a popover, from the button.
+    ac.popoverPresentationController.sourceView = b;
+    ac.popoverPresentationController.sourceRect = b.bounds;
+    [sp_presenter() presentViewController:ac animated:YES completion:nil];
+}
