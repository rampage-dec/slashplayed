+
+- (SPStripButton *)sp_strip_button:(NSString *)key {
+    return [key isEqualToString:@"map"] ? _map : [key isEqualToString:@"info"] ? _info
+         : [key isEqualToString:@"esc"] ? _esc : _kbd;
+}
+
+// A lower button dragged along the strip (editing): past a neighbour's middle, the two change places;
+// the others move, this one stays under the finger until it lifts. The order is kept (sp_touch_strip,
+// and in the layout file).
+- (void)sp_strip_drag:(SPStripButton *)button y:(CGFloat)y done:(BOOL)done {
+    if (!button) return;
+    NSUInteger at = NSNotFound;
+    for (NSUInteger i = 0; i < _strip_order.count; i++)
+        if ([self sp_strip_button:_strip_order[i]] == button) at = i;
+    if (at == NSNotFound) return;
+    if (!done) {
+        // The shown neighbour above and below (a hidden ⓘ is stepped over, and goes along).
+        for (int dir = -1; dir <= 1; dir += 2) {
+            NSInteger j = (NSInteger)at + dir;
+            while (j >= 0 && j < (NSInteger)_strip_order.count && [self sp_strip_button:_strip_order[j]].hidden) j += dir;
+            if (j < 0 || j >= (NSInteger)_strip_order.count) continue;
+            CGFloat other = [self sp_strip_button:_strip_order[j]].center.y;
+            if (dir < 0 ? y < other : y > other) {
+                [_strip_order exchangeObjectAtIndex:at withObjectAtIndex:(NSUInteger)j];
+                sp_touch_haptic();
+                break;
+            }
+        }
+        _strip_dragged = button;
+        [UIView animateWithDuration:0.15 animations:^{
+            [self setNeedsLayout];
+            [self layoutIfNeeded];
+        }];
+        return;
+    }
+    _strip_dragged = nil;
+    [NSUserDefaults.standardUserDefaults setObject:[_strip_order copy] forKey:@"sp_touch_strip"];
+    [NSUserDefaults.standardUserDefaults synchronize];
+    sp_layout_backup();
+    [UIView animateWithDuration:0.15 animations:^{
+        [self setNeedsLayout];
+        [self layoutIfNeeded];
+    }];
+}
+
+// The strip's buttons, for the root view's pointInside: (the strip is outside the game, where the root
+// view takes no touch).
+- (BOOL)sp_claims:(CGPoint)p {
+    if (self.hidden) return NO;
+    for (UIView *v in @[ _toggle, _page_button, _gear, _map, _esc, _kbd, _info ])
+        if (!v.hidden && [v pointInside:[self convertPoint:p toView:v] withEvent:nil]) return YES;
+    return NO;
+}
+
+// Placed from the game rect (the window less the Dynamic Island's strip), sized from its height, so
+// they sit the same on every iPhone and iPad, times the settings' sizes; then each item's own place
+// and size from edit mode. The defaults, for a thumb: the stick lower left with Auto Run above it, and
+// on the right Interact, the one used most, biggest and lowest, where the thumb rests, with Fishing to
+// its left, Jump above it, and the camera pad in the corner between. Well clear of the screen's edges:
+// the root view defers the system's edge gestures (preferredScreenEdgesDeferringSystemGestures), and
+// for that iOS holds back touches that start near an edge, which made a stick in the corner answer late.
+- (void)layoutSubviews {
+    [super layoutSubviews];
+    CGRect g = [self sp_game];
+    CGRect b = self.bounds;
+    _pad.frame = b;
+    CGFloat h = g.size.height;
+    CGFloat margin = MAX(h * 0.09, 40);  // from the screen's edges, not the game rect's
+    CGFloat bottom = MIN(CGRectGetMaxY(g), CGRectGetMaxY(b) - margin);
+    CGFloat left = MAX(CGRectGetMinX(g) + h * 0.04, CGRectGetMinX(b) + margin);
+    CGFloat right = MIN(CGRectGetMaxX(g) - h * 0.04, CGRectGetMaxX(b) - margin);
+    CGFloat ss = sp_ts_size[sp_ts[SP_TS_STICK]], bs = sp_ts_size[sp_ts[SP_TS_BUTTONS]];
+
+    CGFloat r = MIN(h * 0.165, 82) * ss;  // the stick's radius
+    CGFloat big = MIN(h * 0.22, 104) * bs, mid = MIN(h * 0.17, 84) * bs, small = MIN(h * 0.13, 64) * bs;
+    CGPoint stick = CGPointMake(left + r, bottom - r - h * 0.02);
+    CGPoint interact = CGPointMake(right - big / 2, bottom - big / 2 - h * 0.02);
+    CGPoint fish = CGPointMake(interact.x - big / 2 - mid * 0.75, interact.y - big * 0.45);
+    CGPoint jump = CGPointMake(interact.x, interact.y - big / 2 - mid * 0.8);
+    CGPoint autorun = CGPointMake(stick.x + r * 0.9, stick.y - r - small * 0.75);
+    // The camera pad: left of Jump, above Fishing, kept to the right half and below the top eighth.
+    CGFloat lx1 = jump.x - mid / 2 - mid * 0.1, ly1 = fish.y - mid / 2 - mid * 0.12;
+    CGFloat lx0 = MAX(lx1 - big * 1.5, CGRectGetMidX(g) + 20), ly0 = MAX(ly1 - big * 1.05, CGRectGetMinY(g) + h * 0.12);
+    CGSize lookSize = CGSizeMake(MAX(0, lx1 - lx0), MAX(0, ly1 - ly0));
+    CGPoint look = CGPointMake((lx0 + lx1) / 2, (ly0 + ly1) / 2);
+
+    id st = [NSUserDefaults.standardUserDefaults objectForKey:@"sp_touch_stick"];
+    NSDictionary *stickItem = [st isKindOfClass:NSDictionary.class] ? st : @{};
+    CGFloat rs = r * sp_item_size(stickItem);
+    _stick.bounds = CGRectMake(0, 0, 2 * rs, 2 * rs);
+    _stick.rest = sp_item_at(stickItem, stick, g);
+
+    NSArray<NSMutableDictionary *> *items = [self sp_items];
+    for (NSUInteger i = 0; i < _views.count && i < items.count; i++) {
+        NSDictionary *it = items[i];
+        UIView *v = _views[i];
+        NSString *k = it[@"k"];
+        CGFloat s = sp_item_size(it);
+        if ([k isEqualToString:@"look"]) {
+            v.bounds = CGRectMake(0, 0, lookSize.width * s, lookSize.height * s);
+            v.center = sp_item_at(it, look, g);
+            continue;
+        }
+        CGFloat d = mid;
+        CGPoint def = CGPointMake(CGRectGetMidX(g) + h * 0.3, CGRectGetMidY(g));
+        if ([k isEqualToString:@"interact"]) {
+            d = big;
+            def = interact;
+        } else if ([k isEqualToString:@"fish"]) {
+            def = fish;
+        } else if ([k isEqualToString:@"jump"]) {
+            def = jump;
+        } else if ([k isEqualToString:@"autorun"]) {
+            d = small;
+            def = autorun;
+        }
+        v.bounds = CGRectMake(0, 0, d * s, d * s);
+        v.center = sp_item_at(it, def, g);
+    }
+
+    // The strip's buttons: Touch, Seite, and the gear at its top; the map, Esc, and the keyboard at its
+    // bottom (the keyboard lowest, nearest the thumb); each group clear of the island in the middle, and
+    // kept out of the screen's rounded corners (closing up rather than going further). With no strip
+    // (an iPad), a column at the game's left edge, around the middle.
+    CGRect strip = CGRectNull;
+    if (CGRectGetMinX(g) - CGRectGetMinX(b) >= 30)
+        strip = CGRectMake(CGRectGetMinX(b), CGRectGetMinY(b), CGRectGetMinX(g) - CGRectGetMinX(b), b.size.height);
+    else if (CGRectGetMaxX(b) - CGRectGetMaxX(g) >= 30)
+        strip = CGRectMake(CGRectGetMaxX(g), CGRectGetMinY(b), CGRectGetMaxX(b) - CGRectGetMaxX(g), b.size.height);
+    // ⓘ with the map when the setting has it; off, it's put down too.
+    _info.hidden = !sp_ts[SP_TS_INFO];
+    if (_info.hidden && (_info_armed || _info_locked)) {
+        _info_armed = _info_locked = NO;
+        _info.on = NO;
+    }
+    NSArray<UIView *> *upper = @[ _toggle, _page_button, _gear ];
+    NSMutableArray<UIView *> *lower = [NSMutableArray array];   // in the player's order (sp_strip_drag:)
+    for (NSString *k in _strip_order) {
+        SPStripButton *v = [self sp_strip_button:k];
+        if (!v.hidden) [lower addObject:v];
+    }
+    if (!CGRectIsNull(strip)) {
+        CGFloat bw = MIN(strip.size.width - 6, 50), bh = 34, pitch = 40, x = CGRectGetMidX(strip);
+        CGFloat t0 = CGRectGetMinY(strip) + 76, t1 = t0 + (upper.count - 1) * pitch;   // centres, top down
+        CGFloat l1 = CGRectGetMaxY(strip) - 58, l0 = l1 - (lower.count - 1) * pitch;
+        if (!CGRectIsNull(sp_game_island) && !CGRectIsEmpty(sp_game_island)) {
+            CGFloat over = t1 + bh / 2 + 6 - CGRectGetMinY(sp_game_island);
+            CGFloat under = CGRectGetMaxY(sp_game_island) + 6 - (l0 - bh / 2);
+            if (over > 0) { t0 -= over; t1 -= over; }
+            if (under > 0) { l0 += under; l1 += under; }
+        }
+        t0 = MAX(t0, CGRectGetMinY(strip) + 26 + bh / 2);
+        l1 = MIN(l1, CGRectGetMaxY(strip) - 26 - bh / 2);
+        CGFloat tp = (t1 - t0) / (upper.count - 1), lp = (l1 - l0) / (lower.count - 1);
+        CGFloat th = MAX(22, MIN(bh, tp - 4)), lh = MAX(22, MIN(bh, lp - 4));
+        for (NSUInteger i = 0; i < upper.count; i++) {
+            upper[i].bounds = CGRectMake(0, 0, bw, th);
+            ((SPStripButton *)upper[i]).slack = MAX(0, MIN(8, (tp - th) / 2));
+            upper[i].center = CGPointMake(x, t0 + i * tp);
+        }
+        for (NSUInteger i = 0; i < lower.count; i++) {
+            lower[i].bounds = CGRectMake(0, 0, bw, lh);
+            ((SPStripButton *)lower[i]).slack = MAX(0, MIN(8, (lp - lh) / 2));
+            if (lower[i] != _strip_dragged) lower[i].center = CGPointMake(x, l0 + i * lp);
+        }
+    } else {
+        NSArray<UIView *> *col = [upper arrayByAddingObjectsFromArray:lower];
+        CGFloat x = CGRectGetMinX(g) + 8 + 25;
+        for (NSUInteger i = 0; i < col.count; i++) {
+            col[i].bounds = CGRectMake(0, 0, 50, 38);
+            ((SPStripButton *)col[i]).slack = 4;
+            if (col[i] != _strip_dragged) col[i].center = CGPointMake(x, CGRectGetMidY(g) + (i - (col.count - 1) / 2.0) * 46);
+        }
+    }
+
+    if (!_status.hidden) {
+        CGSize sz = [_status sizeThatFits:CGSizeMake(g.size.width, 20)];
+        _status.bounds = CGRectMake(0, 0, sz.width + 16, 18);
+        _status.center = CGPointMake(CGRectGetMidX(g), CGRectGetMinY(g) + 4 + 9);
+    }
+
+    if (_panel) {
+        // Kept 60 points from the screen's edges: iOS holds back touches that start near one (the root
+        // view defers the system's edge gestures), which made controls near them answer late.
