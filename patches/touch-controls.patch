+
+// The page's trigger as the button's title, and its menu: Nie, the general ones, then the forms and
+// stances (the class's own, inline; with the class not known yet, all of them in a submenu).
+- (void)sp_auto:(NSString *)key klass:(int)klass {
+    NSString *now = key ?: @"";
+    [_autoButton setTitle:[NSString stringWithFormat:@"Auto: %@ ▾", sp_auto_title(now)] forState:UIControlStateNormal];
+    __weak SPEditBanner *weak = self;
+    UIAction *(^item)(int) = ^UIAction *(int i) {
+        NSString *k = @(sp_auto_triggers[i].key);
+        UIAction *a = [UIAction actionWithTitle:@(sp_auto_triggers[i].title) image:nil identifier:nil
+                                        handler:^(__kindof UIAction *action) {
+            SPEditBanner *me = weak;
+            if (me && me.auto_pick) me.auto_pick(k);
+        }];
+        a.state = [k isEqualToString:now] ? UIMenuElementStateOn : UIMenuElementStateOff;
+        return a;
+    };
+    NSMutableArray<UIMenuElement *> *general = [NSMutableArray array], *forms = [NSMutableArray array];
+    for (int i = 0; i < sp_auto_trigger_count; i++) {
+        if (!sp_auto_triggers[i].klass) [general addObject:item(i)];
+        else if (!klass || sp_auto_triggers[i].klass == klass) [forms addObject:item(i)];
+    }
+    NSMutableArray<UIMenuElement *> *children = [NSMutableArray arrayWithArray:general];
+    if (forms.count)
+        [children addObject:[UIMenu menuWithTitle:klass ? @"" : @"Gestalt oder Haltung" image:nil identifier:nil
+                                          options:klass ? UIMenuOptionsDisplayInline : 0 children:forms]];
+    _autoButton.menu = [UIMenu menuWithTitle:@"Diese Seite zeigt sich von selbst:" children:children];
+}
