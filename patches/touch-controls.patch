+    { SP_TS_STICK, SP_TS_BUTTONS, SP_TS_SIDE, SP_TS_CENTER, SP_TS_HAPTICS, SP_TS_GRID, SP_ROW_END },
+    { SP_TS_LOOK, SP_ROW_TAP1, SP_ROW_TAP2, SP_ROW_TAP3, SP_TS_TAPWAIT, SP_TS_SCROLL, SP_TS_INFO, SP_ROW_END },
+    { SP_TS_OPACITY, SP_TS_STATUS, SP_TS_BATT, SP_TS_APPKB, SP_TS_AWAKE, SP_ROW_END },
+    { SP_ROW_ENERGY, SP_TS_FPS, SP_TS_CALM, SP_TS_SAVER, SP_TS_HEAT, SP_TS_CHARGE, SP_ROW_END },
+    { SP_TS_AUTOPAGE, SP_TS_CHARPROF, SP_ROW_END },
+    { SP_ROW_END },
+};
