+@interface SPSettingsPanel : UIView
+@property(nonatomic, copy) void (^changed)(void);
+@property(nonatomic, copy) void (^done)(void);
+@property(nonatomic, copy) void (^edit)(void);
+@property(nonatomic, copy) BOOL (^load)(void);   // the layout file; NO: there's none
+- (void)sp_sync;
+@end
+
+@implementation SPSettingsPanel {
+    UILabel *_title;
+    NSMutableArray<UILabel *> *_labels;
+    NSMutableArray<UISegmentedControl *> *_segs;
+    UIButton *_reset, *_finish, *_editButton, *_loadButton;
+    BOOL _loadArmed;   // "Laden" once: "Sicher?"; twice: loaded
+    UILabel *_tapLabel[2];        // the camera pad's double and triple taps: rows after the settings'
+    UIButton *_tapButton[2];
+    SPGestureChooser *_chooser;
+}
+
+// The rows: the settings', then the two taps'.
+#define SP_PANEL_ROWS (SP_TS_COUNT + 2)
+
+- (instancetype)initWithFrame:(CGRect)frame {
+    if (!(self = [super initWithFrame:frame])) return nil;
+    self.backgroundColor = [UIColor colorWithWhite:0.08 alpha:0.94];
+    self.layer.cornerRadius = 14;
+    self.layer.borderWidth = 1;
+    self.layer.borderColor = [UIColor colorWithWhite:1 alpha:0.25].CGColor;
+    _title = [[UILabel alloc] init];
+    _title.text = @"Touch-Steuerung";
+    _title.font = [UIFont boldSystemFontOfSize:16];
+    _title.textColor = UIColor.whiteColor;
+    [self addSubview:_title];
+    _labels = [NSMutableArray array];
+    _segs = [NSMutableArray array];
+    for (int i = 0; i < SP_TS_COUNT; i++) {
+        UILabel *l = [[UILabel alloc] init];
+        l.text = @(sp_ts_rows[i].title);
+        l.font = [UIFont systemFontOfSize:13];
+        l.textColor = [UIColor colorWithWhite:1 alpha:0.85];
+        l.adjustsFontSizeToFitWidth = YES;
+        l.minimumScaleFactor = 0.75;
+        [_labels addObject:l];
+        [self addSubview:l];
+        NSMutableArray *items = [NSMutableArray array];
+        for (int c = 0; c < sp_ts_rows[i].count; c++) [items addObject:@(sp_ts_rows[i].choices[c])];
+        UISegmentedControl *s = [[UISegmentedControl alloc] initWithItems:items];
+        s.tag = i;
+        [s addTarget:self action:@selector(sp_picked:) forControlEvents:UIControlEventValueChanged];
+        [_segs addObject:s];
+        [self addSubview:s];
+    }
+    _reset = [UIButton buttonWithType:UIButtonTypeSystem];
+    [_reset setTitle:@"Standard" forState:UIControlStateNormal];
+    [_reset addTarget:self action:@selector(sp_defaults) forControlEvents:UIControlEventTouchUpInside];
+    _finish = [UIButton buttonWithType:UIButtonTypeSystem];
+    [_finish setTitle:@"Fertig" forState:UIControlStateNormal];
+    _finish.titleLabel.font = [UIFont boldSystemFontOfSize:17];
+    [_finish addTarget:self action:@selector(sp_finished) forControlEvents:UIControlEventTouchUpInside];
+    _editButton = [UIButton buttonWithType:UIButtonTypeSystem];
+    [_editButton setTitle:@"Bearbeiten" forState:UIControlStateNormal];
+    [_editButton addTarget:self action:@selector(sp_edit_tapped) forControlEvents:UIControlEventTouchUpInside];
+    for (int k = 0; k < 2; k++) {
+        _tapLabel[k] = [[UILabel alloc] init];
+        _tapLabel[k].text = k ? @"Kamera 3× tippen" : @"Kamera 2× tippen";
+        _tapLabel[k].font = [UIFont systemFontOfSize:13];
+        _tapLabel[k].textColor = [UIColor colorWithWhite:1 alpha:0.85];
+        _tapLabel[k].adjustsFontSizeToFitWidth = YES;
+        _tapLabel[k].minimumScaleFactor = 0.75;
+        [self addSubview:_tapLabel[k]];
+        _tapButton[k] = [UIButton buttonWithType:UIButtonTypeSystem];
+        _tapButton[k].backgroundColor = [UIColor colorWithWhite:1 alpha:0.1];
+        _tapButton[k].layer.cornerRadius = 7;
+        _tapButton[k].tag = k + 2;
+        [_tapButton[k] addTarget:self action:@selector(sp_choose_tap:) forControlEvents:UIControlEventTouchUpInside];
+        [self addSubview:_tapButton[k]];
+    }
+    _loadButton = [UIButton buttonWithType:UIButtonTypeSystem];
+    [_loadButton setTitle:@"Layout laden" forState:UIControlStateNormal];
+    _loadButton.titleLabel.adjustsFontSizeToFitWidth = YES;
+    [_loadButton addTarget:self action:@selector(sp_load_tapped) forControlEvents:UIControlEventTouchUpInside];
+    [self addSubview:_reset];
+    [self addSubview:_finish];
+    [self addSubview:_editButton];
+    [self addSubview:_loadButton];
+    [self sp_sync];
+    return self;
+}
+
+// Replaces the whole layout, so a second tap confirms it.
+- (void)sp_load_tapped {
+    if (!_loadArmed) {
+        _loadArmed = YES;
+        [_loadButton setTitle:@"Sicher? Nochmal" forState:UIControlStateNormal];
+        return;
+    }
+    _loadArmed = NO;
+    BOOL ok = _load && _load();
+    [_loadButton setTitle:ok ? @"Geladen" : @"Keine Datei" forState:UIControlStateNormal];
+    [self sp_sync];
+}
+
+- (void)sp_choose_tap:(UIButton *)b {
+    int which = (int)b.tag;
+    [_chooser removeFromSuperview];
+    _chooser = [[SPGestureChooser alloc] initWithWhich:which];
+    __weak SPSettingsPanel *weak = self;
+    _chooser.picked = ^(int i) {
+        SPSettingsPanel *me = weak;
+        if (!me) return;
+        if (i >= 0) sp_gesture_set(which, i);
+        [me->_chooser removeFromSuperview];
+        me->_chooser = nil;
+        [me sp_sync];
+        if (me->_changed) me->_changed();
+    };
+    [self addSubview:_chooser];
+    [self setNeedsLayout];
+}
+
+- (void)sp_sync {
+    for (int k = 0; k < 2; k++)
+        [_tapButton[k] setTitle:@(sp_gestures[sp_gesture_get(k + 2)].title) forState:UIControlStateNormal];
+    for (int i = 0; i < SP_TS_COUNT; i++) _segs[i].selectedSegmentIndex = sp_ts[i];
+}
+
+- (void)sp_picked:(UISegmentedControl *)s {
+    sp_ts_set((int)s.tag, (int)s.selectedSegmentIndex);
+    if (s.tag == SP_TS_FPS || s.tag == SP_TS_SAVER || s.tag == SP_TS_HEAT) sp_fps_apply();
+    if (_changed) _changed();
+}
+
+- (void)sp_defaults {
+    for (int i = 0; i < SP_TS_COUNT; i++) sp_ts_set(i, sp_ts_rows[i].def);
+    [NSUserDefaults.standardUserDefaults removeObjectForKey:@"sp_touch_tap2"];
+    [NSUserDefaults.standardUserDefaults removeObjectForKey:@"sp_touch_tap3"];
+    sp_layout_backup();
+    sp_fps_apply();
+    [self sp_sync];
+    if (_changed) _changed();
+}
+
+- (void)sp_finished {
+    if (_done) _done();
+}
+
+- (void)sp_edit_tapped {
+    if (_edit) _edit();
+}
+
+// Rows as tall as fit (36 points at most), the label column a third of a column's width; two columns
+// side by side when the panel is wide (sp_ts_columns), the first half of the rows left.
+static int sp_ts_columns(CGFloat width) {
+    return width >= 700 ? 2 : 1;
+}
+
+- (void)layoutSubviews {
+    [super layoutSubviews];
+    CGRect b = self.bounds;
+    CGFloat pad = 14, w = b.size.width - 2 * pad, head = 34, foot = 40, gap = 20;
+    int cols = sp_ts_columns(b.size.width), per = (SP_PANEL_ROWS + cols - 1) / cols;
+    CGFloat row = MIN(36, (b.size.height - head - foot - pad) / per);
+    CGFloat cw = (w - (cols - 1) * gap) / cols;
+    _title.frame = CGRectMake(pad, 6, w, head - 6);
+    CGFloat lw = cw * 0.38;
+    for (int i = 0; i < SP_PANEL_ROWS; i++) {
+        CGFloat x = pad + (i / per) * (cw + gap), y = head + (i % per) * row;
+        UIView *l = i < SP_TS_COUNT ? (UIView *)_labels[i] : _tapLabel[i - SP_TS_COUNT];
+        UIView *c = i < SP_TS_COUNT ? (UIView *)_segs[i] : _tapButton[i - SP_TS_COUNT];
+        l.frame = CGRectMake(x, y, lw - 6, row);
+        c.frame = CGRectMake(x + lw, y + 3, cw - lw, row - 6);
+    }
+    _chooser.frame = CGRectInset(b, 6, 6);
+    CGFloat fy = head + per * row + 2, bw = w / 4;
+    _reset.frame = CGRectMake(pad, fy, bw, foot - 4);
+    _loadButton.frame = CGRectMake(pad + bw, fy, bw, foot - 4);
+    _editButton.frame = CGRectMake(pad + 2 * bw, fy, bw, foot - 4);
+    _finish.frame = CGRectMake(pad + 3 * bw, fy, bw, foot - 4);
+}
+@end
+
