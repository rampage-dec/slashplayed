+    { "X", "key", 0x07, "x", 2 }, { "V", "key", 0x09, "v", 2 }, { "Tab", "key", 0x30, "\t", 2 },
+    // F4 to F12 are the touch controls' own keys (SPTouch binds them with priority): the addon's list has
+    // every key the player has bound, those too, as fight buttons.
+    { "F1", "key", 0x7A, "", 2 }, { "F2", "key", 0x78, "", 2 }, { "F3", "key", 0x63, "", 2 },
+};
