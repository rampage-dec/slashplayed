+}
+
+- (instancetype)initWithWhich:(int)which {
+    if (!(self = [super initWithFrame:CGRectZero])) return nil;
+    self.backgroundColor = [UIColor colorWithWhite:0.06 alpha:0.98];
+    self.layer.cornerRadius = 14;
+    _title = [[UILabel alloc] init];
+    _title.text = which == 3 ? @"Kamera-Feld 3× tippen:" : @"Kamera-Feld 2× tippen:";
+    _title.font = [UIFont boldSystemFontOfSize:15];
+    _title.textColor = UIColor.whiteColor;
+    [self addSubview:_title];
+    int current = sp_gesture_get(which);
+    _buttons = [NSMutableArray array];
+    for (int i = 0; i < sp_gesture_count; i++) {
+        UIButton *b = [UIButton buttonWithType:UIButtonTypeSystem];
+        [b setTitle:@(sp_gestures[i].title) forState:UIControlStateNormal];
+        b.titleLabel.adjustsFontSizeToFitWidth = YES;
+        b.backgroundColor = [UIColor colorWithWhite:1 alpha:i == current ? 0.3 : 0.08];
+        b.layer.cornerRadius = 8;
+        b.tag = i;
+        [b addTarget:self action:@selector(sp_tap:) forControlEvents:UIControlEventTouchUpInside];
+        [_buttons addObject:b];
+        [self addSubview:b];
+    }
+    _close = [UIButton buttonWithType:UIButtonTypeSystem];
+    [_close setTitle:@"Abbrechen" forState:UIControlStateNormal];
+    [_close addTarget:self action:@selector(sp_cancel) forControlEvents:UIControlEventTouchUpInside];
+    [self addSubview:_close];
+    return self;
+}
+
+- (void)sp_tap:(UIButton *)b {
+    if (_picked) _picked((int)b.tag);
+}
+
+- (void)sp_cancel {
+    if (_picked) _picked(-1);
+}
+
+- (void)layoutSubviews {
+    [super layoutSubviews];
+    CGRect b = self.bounds;
+    CGFloat pad = 12, w = b.size.width - 2 * pad;
+    _title.frame = CGRectMake(pad, 6, w - 110, 28);
+    _close.frame = CGRectMake(CGRectGetMaxX(b) - pad - 100, 6, 100, 28);
+    int cols = w >= 600 ? 7 : 4, n = (int)_buttons.count, rows = (n + cols - 1) / cols;
+    CGFloat top = 40, cw = w / cols, rh = MIN(40, (b.size.height - top - pad) / rows);
+    for (int i = 0; i < n; i++)
+        _buttons[i].frame = CGRectMake(pad + (i % cols) * cw + 2, top + (i / cols) * rh + 2, cw - 4, rh - 4);
+}
+@end
