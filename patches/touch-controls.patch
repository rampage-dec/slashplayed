+// ---- energy profiles (the panel's Akku tab): one tap sets the frame limit, the one out of combat, the
+// pause's saver, Hitzeschutz, and Laden-Schutz together. Each can still be changed alone after; the row
+// then shows Eigene. Hitzeschutz is on in all three: it only ever takes frames away from a hot phone.
+static const struct { const char *title; int fps, calm, saver, heat, charge; } sp_energy[3] = {
+    { "Schonen", 1, 3, 1, 1, 1 },      // 30 FPS, 20 out of combat, the saver after 5 s
+    { "Ausgewogen", 2, 2, 2, 1, 1 },   // 45, 30 out of combat, 10 s
+    { "Leistung", 3, 0, 4, 1, 0 },     // 60, the same out of combat, 30 s, and not held to 30 at the charger
+};
+
+// The profile the settings are now, or 3: none of them (Eigene).
+static int sp_energy_now(void) {
+    for (int i = 0; i < 3; i++)
+        if (sp_ts[SP_TS_FPS] == sp_energy[i].fps && sp_ts[SP_TS_CALM] == sp_energy[i].calm
+            && sp_ts[SP_TS_SAVER] == sp_energy[i].saver && sp_ts[SP_TS_HEAT] == sp_energy[i].heat
+            && sp_ts[SP_TS_CHARGE] == sp_energy[i].charge) return i;
+    return 3;
+}
+
+static void sp_energy_set(int i) {
+    if (i < 0 || i >= 3) return;
+    sp_ts_set(SP_TS_FPS, sp_energy[i].fps);
+    sp_ts_set(SP_TS_CALM, sp_energy[i].calm);
+    sp_ts_set(SP_TS_SAVER, sp_energy[i].saver);
+    sp_ts_set(SP_TS_HEAT, sp_energy[i].heat);
+    sp_ts_set(SP_TS_CHARGE, sp_energy[i].charge);
+}
