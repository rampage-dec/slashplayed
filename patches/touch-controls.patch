+@implementation SPEditBanner {
+    UILabel *_label, *_hint;
+    UIButton *_prevButton, *_nextButton, *_addPageButton, *_deletePageButton, *_addKeyButton, *_resetButton, *_doneButton;
+    UIButton *_abilityButton, *_foldButton, *_unfoldButton, *_autoButton;
+    BOOL _armed;        // Seite löschen tapped once: the next tap within three seconds deletes
+    BOOL _resetArmed;   // Standard tapped once: the next tap resets
+    NSUInteger _armGen; // bumped per arming, so a stale timer does nothing
+}
+
+- (UIButton *)sp_button:(NSString *)title action:(SEL)action {
+    UIButton *b = [UIButton buttonWithType:UIButtonTypeSystem];
+    [b setTitle:title forState:UIControlStateNormal];
+    b.titleLabel.font = [UIFont boldSystemFontOfSize:14];
+    b.tintColor = UIColor.whiteColor;
+    b.backgroundColor = [UIColor colorWithWhite:1 alpha:0.12];
+    b.layer.cornerRadius = 8;
+    [b addTarget:self action:action forControlEvents:UIControlEventTouchUpInside];
+    [self addSubview:b];
+    return b;
+}
+
+- (instancetype)initWithFrame:(CGRect)frame {
+    if (!(self = [super initWithFrame:frame])) return nil;
+    self.backgroundColor = [UIColor colorWithWhite:0.08 alpha:0.94];
+    self.layer.cornerRadius = 12;
+    self.layer.borderWidth = 1.5;
+    self.layer.borderColor = [UIColor colorWithRed:1 green:0.78 blue:0.2 alpha:0.9].CGColor;
+    _label = [[UILabel alloc] init];
+    _label.textColor = UIColor.whiteColor;
+    _label.font = [UIFont boldSystemFontOfSize:14];
+    _label.textAlignment = NSTextAlignmentCenter;
+    _label.adjustsFontSizeToFitWidth = YES;
+    _label.minimumScaleFactor = 0.7;
+    [self addSubview:_label];
+    _hint = [[UILabel alloc] init];
+    _hint.textColor = [UIColor colorWithWhite:1 alpha:0.75];
+    _hint.font = [UIFont systemFontOfSize:12];
+    _hint.numberOfLines = 2;
+    _hint.adjustsFontSizeToFitWidth = YES;
+    _hint.minimumScaleFactor = 0.7;
+    _hint.text = @"Ziehen = verschieben · Tippen = Größe · auf den Papierkorb = weg.\nKampfknöpfe (im Spiel): antippen = ändern, Größe, löschen.";
+    [self addSubview:_hint];
+    _prevButton = [self sp_button:@"◀" action:@selector(sp_prev_tapped)];
+    _nextButton = [self sp_button:@"▶" action:@selector(sp_next_tapped)];
+    _addPageButton = [self sp_button:@"+ Seite" action:@selector(sp_add_page_tapped)];
+    _deletePageButton = [self sp_button:@"Seite löschen" action:@selector(sp_delete_page_tapped)];
+    _addKeyButton = [self sp_button:@"+ Taste" action:@selector(sp_add_key_tapped)];
+    _abilityButton = [self sp_button:@"+ Fähigkeit" action:@selector(sp_add_ability_tapped)];
+    _foldButton = [self sp_button:@"▲" action:@selector(sp_fold_tapped)];
+    _unfoldButton = [self sp_button:@"▼ Bearbeiten" action:@selector(sp_fold_tapped)];
