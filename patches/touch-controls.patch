+// ---- the keyboard: the system's, its text sent as key presses
+
+// The Mac key code (US layout, kVK_ANSI_*) for a typed character, lowercase; the umlauts and ß at a
+// German keyboard's places. The game takes the text from the event's characters, so the code only
+// matters for a key binding (a letter typed with no chat box open is that letter's key). Anything
+// else goes as the ISO section key (0x0A), which nothing is bound to.
+static unsigned short sp_char_mac(unichar c) {
+    static const char *const ansi = "asdfhgzxcv\0bqweryt123465=97-80]ou[ip\0lj'k;\\,/nm.\0 `";
+    if (c >= 'A' && c <= 'Z') c += 'a' - 'A';
+    switch (c) {
+    case 0xE4: case 0xC4: return 0x27;  // ä
+    case 0xF6: case 0xD6: return 0x29;  // ö
+    case 0xFC: case 0xDC: return 0x21;  // ü
+    case 0xDF: return 0x1B;             // ß
+    }
+    if (c && c < 128)
+        for (unsigned short i = 0; i <= 0x32; i++)
+            if ((unsigned char)ansi[i] == c) return i;
+    return 0x0A;
+}
