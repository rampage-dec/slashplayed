+        [left addObject:b];
+        [_bar addSubview:b];
+    }
+    [(UIButton *)left[0] addTarget:self action:@selector(sp_escape) forControlEvents:UIControlEventTouchUpInside];
+    [(UIButton *)left[1] addTarget:self action:@selector(sp_chat) forControlEvents:UIControlEventTouchUpInside];
+    [(UIButton *)left[2] addTarget:self action:@selector(sp_tab) forControlEvents:UIControlEventTouchUpInside];
+    _bar.left = left;
+    UIButton *done = [self sp_button:@"Fertig"];
+    [done addTarget:self action:@selector(sp_close) forControlEvents:UIControlEventTouchUpInside];
+    _bar.right = done;
+    [_bar addSubview:done];
+    _bar.preview = [[UILabel alloc] init];
+    _bar.preview.font = [UIFont systemFontOfSize:15];
+    _bar.preview.lineBreakMode = NSLineBreakByTruncatingHead;
