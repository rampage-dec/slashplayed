+    UIButton *add = [self sp_button:@"+ Neues Profil" action:@selector(sp_profile_new)];
+    add.tag = -1;
+    [_profileButtons addObject:add];
+    [_profileBox addSubview:add];
+    [self sp_add_item:_profileBox];
+    _profileInfo = [[UILabel alloc] init];
+    _profileInfo.font = [UIFont systemFontOfSize:12];
+    _profileInfo.textColor = [UIColor colorWithRed:0.6 green:0.9 blue:1 alpha:0.95];
+    _profileInfo.numberOfLines = 2;
+    [self sp_add_item:_profileInfo];
