+- (void)sp_prev_tapped { [self sp_disarm]; if (_prev) _prev(); }
+- (void)sp_next_tapped { [self sp_disarm]; if (_next) _next(); }
+- (void)sp_add_page_tapped { [self sp_disarm]; if (_add_page) _add_page(); }
+- (void)sp_add_key_tapped { [self sp_disarm]; if (_add_key) _add_key(); }
+- (void)sp_add_ability_tapped { [self sp_disarm]; if (_add_ability) _add_ability(); }
+- (void)sp_fold_tapped { [self sp_disarm]; if (_fold) _fold(); }
+// Twice, as Seite löschen: one slip of the finger doesn't undo a page's places and sizes.
+- (void)sp_reset_tapped {
+    if (!_resetArmed) {
+        [self sp_disarm];
+        _resetArmed = YES;
+        [_resetButton setTitle:@"Wirklich?" forState:UIControlStateNormal];
+        return;
+    }
+    [self sp_disarm];
+    if (_reset) _reset();
+}
+- (void)sp_done_tapped { [self sp_disarm]; if (_done) _done(); }
+
+// Twice, so one slip of the finger doesn't take a page and its buttons with it.
+- (void)sp_delete_page_tapped {
+    if (_armed) {
+        [self sp_disarm];
+        if (_delete_page) _delete_page();
+        return;
+    }
+    _armed = YES;
+    NSUInteger gen = ++_armGen;
+    [_deletePageButton setTitle:@"Sicher? Nochmal" forState:UIControlStateNormal];
+    __weak SPEditBanner *weak = self;
+    dispatch_after(dispatch_time(DISPATCH_TIME_NOW, (int64_t)(3 * NSEC_PER_SEC)), dispatch_get_main_queue(), ^{
+        SPEditBanner *me = weak;
+        if (me && me->_armGen == gen && me->_armed) [me sp_disarm];
+    });
+}
