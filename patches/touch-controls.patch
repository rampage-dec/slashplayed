+// Every write straight to disk: the game is killed, not quit, when the app is closed, and the
+// defaults' own lazy write never comes then (the shims' CFPreferences writes synchronize too).
+static void sp_layout_backup(void);   // below
+
+static void sp_ts_set(int row, int value) {
+    sp_ts[row] = value;
+    [NSUserDefaults.standardUserDefaults setInteger:value forKey:@(sp_ts_rows[row].key)];
+    [NSUserDefaults.standardUserDefaults synchronize];
+    sp_layout_backup();
+}
+
+// ---- the layout as a file: every "sp_touch_*" default (pages, stick, settings) in Documents/
+// SPTouch-Layout.plist, written on each change, so it can be copied with the Files app into another
+// install (a new Apple ID makes a new app, with empty defaults). An app with no layout of its own takes
+// it from there at its start; the settings' "Layout laden" takes it any time.
+static NSString *sp_layout_path(void) {
+    const char *home = getenv("HOME");
+    return home ? [NSString stringWithFormat:@"%s/Documents/SPTouch-Layout.plist", home] : nil;
+}
+
+static void sp_layout_backup(void) {
+    NSString *path = sp_layout_path();
+    if (!path) return;
+    NSMutableDictionary *out = [NSMutableDictionary dictionary];
+    NSDictionary *all = NSUserDefaults.standardUserDefaults.dictionaryRepresentation;
+    for (NSString *k in all)
+        if ([k hasPrefix:@"sp_touch_"]) out[k] = all[k];
+    if (out.count) [out writeToFile:path atomically:YES];
+}
+
+// YES when the file was there and taken.
+static BOOL sp_layout_restore(void) {
+    NSString *path = sp_layout_path();
+    NSDictionary *in = path ? [NSDictionary dictionaryWithContentsOfFile:path] : nil;
+    if (![in isKindOfClass:NSDictionary.class] || !in.count) return NO;
+    NSUserDefaults *d = NSUserDefaults.standardUserDefaults;
+    for (NSString *k in in)
+        if ([k isKindOfClass:NSString.class] && [k hasPrefix:@"sp_touch_"]) [d setObject:in[k] forKey:k];
+    [d synchronize];
+    sp_stub_log([NSString stringWithFormat:@"touch controls: layout taken from %@ (%lu settings)",
+                 path.lastPathComponent, (unsigned long)in.count].UTF8String);
+    return YES;
+}
