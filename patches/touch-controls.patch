+// ---- the camera pad's double and triple taps: what each does, the settings' choice (NSUserDefaults
+// "sp_touch_tap2", "sp_touch_tap3": the title). "Aus" is a plain click, as a tap; a right click is
+// where the tap was; anything else a key (the touch controls' own: F10 autorun, F11 interact, F12
+// fishing; the game's windows by their default keys; the plain keys, for what's bound to them).
+static const struct {
+    const char *title;
+    unsigned short mac;   // 0xFFFF a plain click, 0xFFFE a right click
+    const char *chars;
+} sp_gestures[] = {
+    { "Aus", 0xFFFF, NULL }, { "Rechtsklick", 0xFFFE, NULL }, { "Springen", 0x31, " " },
+    { "Interagieren", 0x67, NULL }, { "Auto-Lauf", 0x6D, NULL }, { "Angeln", 0x6F, NULL },
+    { "Nächstes Ziel", 0x30, "\t" }, { "Karte", 0x2E, "m" }, { "Taschen", 0x0B, "b" }, { "Charakter", 0x08, "c" },
+    { "Zauberbuch", 0x23, "p" }, { "Talente", 0x2D, "n" }, { "Questlog", 0x25, "l" },
+    { "1", 0x12, "1" }, { "2", 0x13, "2" }, { "3", 0x14, "3" }, { "4", 0x15, "4" }, { "5", 0x17, "5" },
+    { "6", 0x16, "6" }, { "7", 0x1A, "7" }, { "8", 0x1C, "8" }, { "9", 0x19, "9" }, { "0", 0x1D, "0" },
+    { "Q", 0x0C, "q" }, { "E", 0x0E, "e" }, { "R", 0x0F, "r" }, { "T", 0x11, "t" }, { "F", 0x03, "f" },
+    { "G", 0x05, "g" }, { "X", 0x07, "x" }, { "V", 0x09, "v" }, { "F1", 0x7A, "" }, { "F2", 0x78, "" }, { "F3", 0x63, "" },
+    // One tap only (offered for it alone, as its "Aus"): nothing at all, not even a click. Last, so the
+    // others keep their places (the defaults go by place).
+    { "Kein Klick", 0xFFFD, NULL },
+};
+static const int sp_gesture_count = (int)(sizeof sp_gestures / sizeof sp_gestures[0]);
+
+// which: 2 or 3 taps. The index into sp_gestures; a title not (or no longer) there is the default.
+// which: 1, 2, or 3 taps. One tap is a click unless set to something else ("sp_touch_tap1").
+static NSString *sp_gesture_key(int which) {
+    return which == 3 ? @"sp_touch_tap3" : which == 1 ? @"sp_touch_tap1" : @"sp_touch_tap2";
+}
+
+static int sp_gesture_get(int which) {
+    NSString *t = [NSUserDefaults.standardUserDefaults stringForKey:sp_gesture_key(which)];
+    for (int i = 0; t && i < sp_gesture_count; i++)
+        if ([t isEqualToString:@(sp_gestures[i].title)]) return i;
+    return which == 2 ? 1 : 0;   // double: a right click; one: a click; triple: nothing
+}
+
+// As shown: the first of the list is "Aus" for two and three taps, and the plain click for one, whose
+// "Aus" is the last ("Kein Klick").
+static NSString *sp_gesture_title(int which, int i) {
+    if (which == 1 && i == 0) return @"Klick";
+    if (sp_gestures[i].mac == 0xFFFD) return @"Aus";
+    return @(sp_gestures[i].title);
+}
+
+static void sp_gesture_set(int which, int i) {
+    if (i < 0 || i >= sp_gesture_count) return;
+    [NSUserDefaults.standardUserDefaults setObject:@(sp_gestures[i].title) forKey:sp_gesture_key(which)];
+    [NSUserDefaults.standardUserDefaults synchronize];
+    sp_layout_backup();
+}
+
+static void sp_touch_haptic(void);   // below
+static void sp_virtual_tap(unsigned short mac, NSString *chars);
+static void sp_virtual_key(unsigned short mac, NSString *chars, BOOL down);
+
+// p: where the tap was, UIKit points in the root view.
+static void sp_gesture_do(int i, CGPoint p) {
+    if (i < 0 || i >= sp_gesture_count) i = 0;
+    unsigned short mac = sp_gestures[i].mac;
+    if (mac == 0xFFFD) return;   // one tap set to nothing
+    // A double or triple tap's press is held a moment (60 ms, a few frames): down and up in one instant
+    // can fall into one frame of the game, which then may take a right click or a key as nothing.
+    dispatch_time_t later = dispatch_time(DISPATCH_TIME_NOW, (int64_t)(0.06 * NSEC_PER_SEC));
+    if (mac == 0xFFFF || mac == 0xFFFE) {
+        int button = mac == 0xFFFE ? 1 : 0;
+        CGPoint m = sp_from_uikit(p);
+        sp_mouse_button(button, YES, m);
+        if (i) dispatch_after(later, dispatch_get_main_queue(), ^{ sp_mouse_button(button, NO, sp_pointer); });
+        else sp_mouse_button(button, NO, m);
+    } else {
+        NSString *chars = sp_gestures[i].chars ? @(sp_gestures[i].chars) : nil;
+        sp_virtual_key(mac, chars, YES);
+        dispatch_after(later, dispatch_get_main_queue(), ^{ sp_virtual_key(mac, chars, NO); });
+    }
+    if (i) sp_touch_haptic();
+}
+
+static const CGFloat sp_ts_size[3] = { 0.8, 1.0, 1.2 };
+static const CGFloat sp_ts_look_speed[5] = { 0, 1.0, 1.7, 3.6, 5.2 };
+static const CGFloat sp_ts_alpha[5] = { 0.12, 0.26, 0.45, 0.72, 1.0 };
+
+// A light tap in the hand on a press, when vibration is on.
+static void sp_touch_haptic(void) {
+    if (!sp_ts[SP_TS_HAPTICS]) return;
+    static UIImpactFeedbackGenerator *g;
+    if (!g) g = [[UIImpactFeedbackGenerator alloc] initWithStyle:UIImpactFeedbackStyleLight];
+    [g impactOccurred];
+}
+
+// A key press with no UIKey behind it: the Mac key code and the characters it types.
+static void sp_virtual_key(unsigned short mac, NSString *chars, BOOL down) {
+    SPEvent *e = sp_event(down ? SPKeyDown : SPKeyUp);
+    e->keyCode = mac;
+    unichar fc = sp_function_char(mac);
+    if (fc) {
+        e->characters = e->charactersIgnoringModifiers = [NSString stringWithCharacters:&fc length:1];
+        if (fc >= 0xF700) e->modifierFlags |= SPFunction;
+    } else {
+        e->characters = e->charactersIgnoringModifiers = chars ?: @"";
+    }
+    sp_post(e);
+}
+
+static void sp_virtual_tap(unsigned short mac, NSString *chars) {
+    sp_virtual_key(mac, chars, YES);
+    sp_virtual_key(mac, chars, NO);
+}
+
+// F9 with no characters: SPTouch binds it to open the chat, and the game takes bindings from the key
+// code. With its function character (0xF70C, as a real F9 has) Forever's text boxes take that as typed
+// text, a stray glyph before what follows: in the chat opened by it, or one open already.
+static void sp_chat_key(void) {
+    for (int down = 1; down >= 0; down--) {
+        SPEvent *e = sp_event(down ? SPKeyDown : SPKeyUp);
+        e->keyCode = 0x65;
+        e->characters = e->charactersIgnoringModifiers = @"";
+        e->modifierFlags |= SPFunction;
+        sp_post(e);
+    }
+}
+
+// ---- edit mode: the controls move and change size instead of pressing anything
+//
+// Each control's touch handlers start with these; YES means edit mode had the touch. A drag moves the
+// control with the finger; a lift without one is a tap, which steps its size. SPTouchControls saves
+// either (sp_touch_edit_done), for the page shown.
+static BOOL sp_touch_editing;
+static void (^sp_touch_edit_done)(UIView *view, BOOL moved);
+static void (^sp_touch_edit_moving)(UIView *view);   // during a drag: for the trash's highlight
+static CGPoint (^sp_touch_edit_snap)(UIView *view, CGPoint centre);   // during a drag: the grid's place
+static UIView *sp_edit_view;
+static UITouch *sp_edit_touch;
+static CGPoint sp_edit_from, sp_edit_center;
+static BOOL sp_edit_moved;
+static const CGFloat sp_edit_steps[5] = { 0.7, 0.85, 1.0, 1.2, 1.4 };
+
+static BOOL sp_edit_begin(UIView *v, NSSet<UITouch *> *touches) {
+    if (!sp_touch_editing) return NO;
+    if (!sp_edit_touch) {
+        sp_edit_view = v;
+        sp_edit_touch = touches.anyObject;
+        sp_edit_from = [sp_edit_touch locationInView:v.superview];
+        sp_edit_center = v.center;
+        sp_edit_moved = NO;
+    }
+    return YES;
+}
+
+static BOOL sp_edit_move(UIView *v, NSSet<UITouch *> *touches) {
+    if (!sp_touch_editing) return NO;
+    if (v != sp_edit_view || ![touches containsObject:sp_edit_touch]) return YES;
+    CGPoint p = [sp_edit_touch locationInView:v.superview];
+    CGFloat dx = p.x - sp_edit_from.x, dy = p.y - sp_edit_from.y;
+    if (!sp_edit_moved && hypot(dx, dy) < 8) return YES;   // a tap's wobble isn't a move
+    sp_edit_moved = YES;
+    CGPoint c = CGPointMake(sp_edit_center.x + dx, sp_edit_center.y + dy);
+    if (sp_touch_edit_snap) c = sp_touch_edit_snap(v, c);
+    v.center = c;
+    if (sp_touch_edit_moving) sp_touch_edit_moving(v);
+    return YES;
+}
+
+static BOOL sp_edit_end(UIView *v, NSSet<UITouch *> *touches, BOOL cancelled) {
+    if (!sp_touch_editing) return NO;
+    if (v != sp_edit_view || ![touches containsObject:sp_edit_touch]) return YES;
+    BOOL moved = sp_edit_moved;
+    sp_edit_view = nil;
+    sp_edit_touch = nil;
+    if ((moved || !cancelled) && sp_touch_edit_done) sp_touch_edit_done(v, moved);
+    return YES;
+}
