+// ---- the bar over the game in edit mode: the page (◀ ▶, + Seite, Seite löschen), + Fähigkeit (the
+// addon's list, by F4), + Taste, Standard (this page's places and sizes back to the defaults), Fertig;
+// and ▲, which folds it to a small tab, for what's under it
+
+@interface SPEditBanner : UIView
+@property(nonatomic, copy) void (^prev)(void);
+@property(nonatomic, copy) void (^next)(void);
+@property(nonatomic, copy) void (^add_page)(void);
+@property(nonatomic, copy) void (^delete_page)(void);
+@property(nonatomic, copy) void (^add_key)(void);
+@property(nonatomic, copy) void (^add_ability)(void);
+@property(nonatomic, copy) void (^reset)(void);
+@property(nonatomic, copy) void (^done)(void);
+@property(nonatomic, copy) void (^fold)(void);
+@property(nonatomic, copy) void (^auto_pick)(NSString *key);   // the page's trigger ("": none)
+@property(nonatomic) BOOL small;   // folded: only ▼ Bearbeiten and Fertig
+- (void)sp_page:(NSInteger)page of:(NSInteger)count;
+- (void)sp_auto:(NSString *)key klass:(int)klass;
