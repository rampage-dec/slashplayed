+- (void)sp_tab_picked {
+    _tab = _tabs.selectedSegmentIndex;
+    [NSUserDefaults.standardUserDefaults setInteger:_tab forKey:@"sp_panel_tab"];
+    [_chooser removeFromSuperview];
+    _chooser = nil;
+    [self sp_build_tab];
+    _scroll.contentOffset = CGPointMake(0, 0);
+}
+
+// The tab's rows anew (a tab picked, the profiles changed).
+- (void)sp_build_tab {
+    for (UIView *v in _items) [v removeFromSuperview];
+    [_items removeAllObjects];
+    _saveButton = _loadButton = _reset = nil;
+    for (int i = 0; i < SP_TS_COUNT; i++) _segs[i] = nil;
+    for (int k = 0; k < 3; k++) _tapButton[k] = nil;
+    _energy = nil;
+    _liveLabel = _profileHead = _profileInfo = _help = nil;
+    _profileBox = _actions = nil;
+    [_profileButtons removeAllObjects];
+    _loadArmed = _resetArmed = _saveArmed = NO;
+    if (_tab == SP_TAB_HELP) {
+        _help = [[UILabel alloc] init];
+        _help.text = sp_help_text;
+        _help.font = [UIFont systemFontOfSize:13];
+        _help.textColor = [UIColor colorWithWhite:1 alpha:0.85];
+        _help.numberOfLines = 0;
+        [self sp_add_item:_help];
+    }
+    if (_tab == SP_TAB_BATTERY) {
+        _liveLabel = [[UILabel alloc] init];
+        _liveLabel.font = [UIFont systemFontOfSize:12];
+        _liveLabel.textColor = [UIColor colorWithRed:0.6 green:0.9 blue:1 alpha:0.95];
+        _liveLabel.numberOfLines = 0;
+        [self sp_add_item:_liveLabel];
+    }
+    if (_tab == SP_TAB_LAYOUT) [self sp_build_profiles];
+    for (int r = 0; sp_tab_rows[_tab][r] != SP_ROW_END; r++) {
+        int row = sp_tab_rows[_tab][r];
+        if (row >= 0) {
+            NSMutableArray *items = [NSMutableArray array];
+            for (int c = 0; c < sp_ts_rows[row].count; c++) [items addObject:@(sp_ts_rows[row].choices[c])];
+            UISegmentedControl *s = [[UISegmentedControl alloc] initWithItems:items];
+            s.tag = row;
+            [s addTarget:self action:@selector(sp_picked:) forControlEvents:UIControlEventValueChanged];
+            _segs[row] = s;
+            [self sp_add_item:[[SPPanelRow alloc] initWithTitle:@(sp_ts_rows[row].title) note:@(sp_ts_rows[row].note) control:s]];
+        } else if (row == SP_ROW_ENERGY) {
+            NSMutableArray *items = [NSMutableArray array];
+            for (int e = 0; e < 3; e++) [items addObject:@(sp_energy[e].title)];
+            [items addObject:@"Eigene"];
+            _energy = [[UISegmentedControl alloc] initWithItems:items];
+            [_energy addTarget:self action:@selector(sp_energy_picked) forControlEvents:UIControlEventValueChanged];
+            [self sp_add_item:[[SPPanelRow alloc] initWithTitle:@"Energie-Profil"
+                note:@"Ein Tipp stellt Bildrate, Außerhalb vom Kampf, Akku sparen, Hitze- und Laden-Schutz zusammen ein."
+                control:_energy]];
+        } else {
+            int k = -row - 1;   // SP_ROW_TAP1..3: 0..2
+            UIButton *b = [self sp_button:@"" action:@selector(sp_choose_tap:)];
+            b.tag = k + 1;
+            _tapButton[k] = b;
+            static NSString *const notes[3] = { @"Ein Tipp: am Anfang ein Klick, wo du tippst.",
+                                                @"Zweimal schnell tippen: am Anfang ein Rechtsklick (ansprechen, plündern).",
+                                                @"Dreimal schnell tippen. Ist hier etwas belegt, wartet ein Doppeltipp kurz." };
+            [self sp_add_item:[[SPPanelRow alloc] initWithTitle:[NSString stringWithFormat:@"Kamera %d× tippen", k + 1]
+                                                           note:notes[k] control:b]];
+        }
+    }
+    if (_tab == SP_TAB_LAYOUT) [self sp_build_actions];
+    [self sp_sync];
+    [self setNeedsLayout];
+}
