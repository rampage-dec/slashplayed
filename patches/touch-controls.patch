+    _autoButton = [UIButton buttonWithType:UIButtonTypeSystem];
+    _autoButton.titleLabel.font = [UIFont boldSystemFontOfSize:14];
+    _autoButton.titleLabel.adjustsFontSizeToFitWidth = YES;
+    _autoButton.titleLabel.minimumScaleFactor = 0.6;
+    _autoButton.tintColor = UIColor.whiteColor;
+    _autoButton.backgroundColor = [UIColor colorWithRed:0.3 green:0.6 blue:1 alpha:0.3];
+    _autoButton.layer.cornerRadius = 8;
+    _autoButton.showsMenuAsPrimaryAction = YES;
