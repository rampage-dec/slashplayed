+// A key press with no UIKey behind it: the Mac key code and the characters it types.
+static void sp_virtual_key(unsigned short mac, NSString *chars, BOOL down) {
+    SPEvent *e = sp_event(down ? SPKeyDown : SPKeyUp);
+    e->keyCode = mac;
+    unichar fc = sp_function_char(mac);
+    if (fc) {
+        e->characters = e->charactersIgnoringModifiers = [NSString stringWithCharacters:&fc length:1];
+        if (fc >= 0xF700) e->modifierFlags |= SPFunction;
+    } else {
+        e->characters = e->charactersIgnoringModifiers = chars ?: @"";
+    }
+    sp_post(e);
+}
+
+static void sp_virtual_tap(unsigned short mac, NSString *chars) {
+    sp_virtual_key(mac, chars, YES);
+    sp_virtual_key(mac, chars, NO);
+}
+
+// F9 with no characters: SPTouch binds it to open the chat, and the game takes bindings from the key
+// code. With its function character (0xF70C, as a real F9 has) Forever's text boxes take that as typed
+// text, a stray glyph before what follows: in the chat opened by it, or one open already.
+static void sp_chat_key(void) {
+    for (int down = 1; down >= 0; down--) {
+        SPEvent *e = sp_event(down ? SPKeyDown : SPKeyUp);
+        e->keyCode = 0x65;
+        e->characters = e->charactersIgnoringModifiers = @"";
+        e->modifierFlags |= SPFunction;
+        sp_post(e);
+    }
+}
