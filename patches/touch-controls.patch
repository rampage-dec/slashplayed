+- (void)sp_page:(NSInteger)page of:(NSInteger)count {
+    _label.text = [NSString stringWithFormat:@"Seite %ld von %ld", (long)page, (long)count];
+    _deletePageButton.enabled = count > 1;
+    _deletePageButton.alpha = count > 1 ? 1 : 0.4;
+    _addPageButton.enabled = count < 9;
+    _addPageButton.alpha = count < 9 ? 1 : 0.4;
+}
