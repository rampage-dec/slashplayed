+// ---- the grid in edit mode: dots where a control's centre can sit. 32 rows over the game's height,
+// squares, from the game rect's corner; the SPTouch addon snaps its fight buttons to the same grid, so
+// both line up.
+
+static const CGFloat sp_grid_rows = 32;
+
+@interface SPGridView : UIView
+@property(nonatomic) CGRect game;
+@end
+
+@implementation SPGridView
+- (instancetype)initWithFrame:(CGRect)frame {
+    if (!(self = [super initWithFrame:frame])) return nil;
+    self.userInteractionEnabled = NO;
+    self.opaque = NO;
+    self.backgroundColor = UIColor.clearColor;
+    return self;
+}
+
+- (void)setGame:(CGRect)game {
+    if (CGRectEqualToRect(game, _game)) return;
+    _game = game;
+    [self setNeedsDisplay];
+}
+
+- (void)drawRect:(CGRect)rect {
+    CGRect g = _game;
+    if (g.size.height <= 0) return;
+    CGFloat step = g.size.height / sp_grid_rows;
+    [[UIColor colorWithWhite:1 alpha:0.25] setFill];
+    for (CGFloat y = g.origin.y; y <= CGRectGetMaxY(g) + 0.5; y += step)
+        for (CGFloat x = g.origin.x; x <= CGRectGetMaxX(g) + 0.5; x += step)
+            UIRectFill(CGRectMake(x - 1, y - 1, 2, 2));
+}
