+// A button in the strip beside the game: a tap, and optionally a hold (half a second).
+@interface SPStripButton : UIView
+- (instancetype)initWithTitle:(NSString *)title symbol:(NSString *)symbol;
+@property(nonatomic, copy) void (^tap)(void);
+@property(nonatomic, copy) void (^hold)(void);
+@property(nonatomic) BOOL on;   // drawn lit
+@end
+
+@implementation SPStripButton {
+    UITouch *_touch;
+    UILabel *_label;
+    UIImageView *_image;
+    NSUInteger _gen;   // bumped per touch, so a stale hold timer does nothing
+    BOOL _held;
+}
+
+- (instancetype)initWithTitle:(NSString *)title symbol:(NSString *)symbol {
+    if (!(self = [super initWithFrame:CGRectZero])) return nil;
+    self.layer.borderWidth = 1;
+    self.layer.cornerRadius = 10;
+    UIImage *img = symbol ? [UIImage systemImageNamed:symbol withConfiguration:
+                             [UIImageSymbolConfiguration configurationWithPointSize:17 weight:UIImageSymbolWeightSemibold]] : nil;
+    if (img) {
+        _image = [[UIImageView alloc] initWithImage:img];
+        _image.contentMode = UIViewContentModeCenter;
+        _image.userInteractionEnabled = NO;
+        [self addSubview:_image];
+    } else {
+        _label = [[UILabel alloc] init];
+        _label.text = title;
+        _label.font = [UIFont boldSystemFontOfSize:12];
+        _label.textAlignment = NSTextAlignmentCenter;
+        _label.adjustsFontSizeToFitWidth = YES;
+        _label.minimumScaleFactor = 0.7;
+        _label.userInteractionEnabled = NO;
+        [self addSubview:_label];
+    }
+    [self sp_draw:NO];
+    return self;
+}
+
+- (void)setOn:(BOOL)on {
+    _on = on;
+    [self sp_draw:_touch != nil];
+}
+
+- (void)sp_draw:(BOOL)pressed {
+    CGFloat bg = pressed ? 0.45 : _on ? 0.28 : 0.10;
+    self.backgroundColor = [UIColor colorWithWhite:1 alpha:bg];
+    self.layer.borderColor = [UIColor colorWithWhite:1 alpha:_on ? 0.6 : 0.3].CGColor;
+    UIColor *fg = [UIColor colorWithWhite:1 alpha:_on || pressed ? 1 : 0.6];
+    _label.textColor = fg;
+    _image.tintColor = fg;
+}
+
+- (void)layoutSubviews {
+    [super layoutSubviews];
+    _label.frame = CGRectInset(self.bounds, 3, 2);
+    _image.frame = self.bounds;
+}
+
+- (BOOL)pointInside:(CGPoint)p withEvent:(UIEvent *)event {
+    return CGRectContainsPoint(CGRectInset(self.bounds, -8, -8), p);
+}
+
+- (void)touchesBegan:(NSSet<UITouch *> *)touches withEvent:(UIEvent *)event {
+    if (_touch) return;
+    _touch = touches.anyObject;
+    _held = NO;
+    NSUInteger gen = ++_gen;
+    [self sp_draw:YES];
+    if (!_hold) return;
+    __weak SPStripButton *weak = self;
+    dispatch_after(dispatch_time(DISPATCH_TIME_NOW, (int64_t)(0.5 * NSEC_PER_SEC)), dispatch_get_main_queue(), ^{
+        SPStripButton *me = weak;
+        if (!me || me->_gen != gen || !me->_touch) return;
+        me->_held = YES;
+        sp_touch_haptic();
+        me.hold();
+    });
+}
+
+- (void)touchesEnded:(NSSet<UITouch *> *)touches withEvent:(UIEvent *)event {
+    if (!_touch || ![touches containsObject:_touch]) return;
+    BOOL inside = [self pointInside:[_touch locationInView:self] withEvent:event];
+    _touch = nil;
+    _gen++;
+    [self sp_draw:NO];
+    if (inside && !_held && _tap) {
+        sp_touch_haptic();
+        _tap();
+    }
+}
+
+- (void)touchesCancelled:(NSSet<UITouch *> *)touches withEvent:(UIEvent *)event {
+    if (!_touch || ![touches containsObject:_touch]) return;
+    _touch = nil;
+    _gen++;
+    [self sp_draw:NO];
+}
+@end
+
+// ---- the keyboard: the system's, its text sent as key presses
+
+// The Mac key code (US layout, kVK_ANSI_*) for a typed character, lowercase; the umlauts and ß at a
+// German keyboard's places. The game takes the text from the event's characters, so the code only
+// matters for a key binding (a letter typed with no chat box open is that letter's key). Anything
+// else goes as the ISO section key (0x0A), which nothing is bound to.
+static unsigned short sp_char_mac(unichar c) {
+    static const char *const ansi = "asdfhgzxcv\0bqweryt123465=97-80]ou[ip\0lj'k;\\,/nm.\0 `";
+    if (c >= 'A' && c <= 'Z') c += 'a' - 'A';
+    switch (c) {
+    case 0xE4: case 0xC4: return 0x27;  // ä
+    case 0xF6: case 0xD6: return 0x29;  // ö
+    case 0xFC: case 0xDC: return 0x21;  // ü
+    case 0xDF: return 0x1B;             // ß
+    }
+    if (c && c < 128)
+        for (unsigned short i = 0; i <= 0x32; i++)
+            if ((unsigned char)ansi[i] == c) return i;
+    return 0x0A;
+}
+
+@interface SPKeyboardSink : UIView <UIKeyInput>
+@property(nonatomic, copy) void (^changed)(BOOL open);
+- (void)sp_open:(BOOL)chat;
+- (void)sp_close;
+@end
+
+// The bar over the keyboard: Esc, Chat and Tab on the left, what was typed (the game's own box is
+// usually under the keyboard), Fertig on the right.
+@interface SPKeyBar : UIView
+@property(nonatomic, strong) NSArray<UIView *> *left;
+@property(nonatomic, strong) UILabel *preview;
+@property(nonatomic, strong) UIView *right;
+@end
+
+@implementation SPKeyBar
+- (void)layoutSubviews {
+    [super layoutSubviews];
+    UIEdgeInsets s = self.safeAreaInsets;
+    CGRect b = self.bounds;
+    CGFloat x = b.origin.x + s.left + 8, h = b.size.height, end = CGRectGetMaxX(b) - s.right - 8;
+    for (UIView *v in _left) {
+        v.frame = CGRectMake(x, 5, 58, h - 10);
+        x += 64;
+    }
+    _right.frame = CGRectMake(end - 80, 5, 80, h - 10);
+    _preview.frame = CGRectMake(x + 6, 0, MAX(0, end - 86 - x - 6), h);
+}
+@end
+
+@implementation SPKeyboardSink {
+    SPKeyBar *_bar;
+    NSMutableString *_typed;   // what was typed since the last Return or Esc, for the bar
+}
+
+- (instancetype)initWithFrame:(CGRect)frame {
+    if (!(self = [super initWithFrame:frame])) return nil;
+    self.userInteractionEnabled = NO;
+    self.backgroundColor = UIColor.clearColor;
+    _typed = [NSMutableString string];
+    _bar = [[SPKeyBar alloc] initWithFrame:CGRectMake(0, 0, 320, 44)];
+    _bar.autoresizingMask = UIViewAutoresizingFlexibleWidth;
+    _bar.backgroundColor = [UIColor colorWithWhite:0.1 alpha:0.96];
+    NSMutableArray *left = [NSMutableArray array];
+    for (NSString *t in @[ @"Esc", @"Chat", @"Tab" ]) {
+        UIButton *b = [self sp_button:t];
+        [left addObject:b];
+        [_bar addSubview:b];
+    }
+    [(UIButton *)left[0] addTarget:self action:@selector(sp_escape) forControlEvents:UIControlEventTouchUpInside];
+    [(UIButton *)left[1] addTarget:self action:@selector(sp_chat) forControlEvents:UIControlEventTouchUpInside];
+    [(UIButton *)left[2] addTarget:self action:@selector(sp_tab) forControlEvents:UIControlEventTouchUpInside];
+    _bar.left = left;
+    UIButton *done = [self sp_button:@"Fertig"];
+    [done addTarget:self action:@selector(sp_close) forControlEvents:UIControlEventTouchUpInside];
+    _bar.right = done;
+    [_bar addSubview:done];
+    _bar.preview = [[UILabel alloc] init];
+    _bar.preview.font = [UIFont systemFontOfSize:15];
+    _bar.preview.lineBreakMode = NSLineBreakByTruncatingHead;
+    [_bar addSubview:_bar.preview];
+    [self sp_show_typed];
+    return self;
+}
+
+- (UIButton *)sp_button:(NSString *)title {
+    UIButton *b = [UIButton buttonWithType:UIButtonTypeSystem];
+    [b setTitle:title forState:UIControlStateNormal];
+    b.titleLabel.font = [UIFont boldSystemFontOfSize:15];
+    b.tintColor = UIColor.whiteColor;
+    b.backgroundColor = [UIColor colorWithWhite:1 alpha:0.12];
+    b.layer.cornerRadius = 8;
+    return b;
+}
+
+- (void)sp_show_typed {
+    BOOL empty = !_typed.length;
+    _bar.preview.text = empty ? @"Schreiben … (Enter sendet)" : _typed;
+    _bar.preview.textColor = [UIColor colorWithWhite:1 alpha:empty ? 0.45 : 0.95];
+}
+
+- (UIView *)inputAccessoryView {
+    return _bar;
+}
+
+- (BOOL)canBecomeFirstResponder {
+    return YES;
+}
+
+// The system keyboard as a plain one: no corrections, capitals, or smart punctuation, which would
+// change text the game has already been sent.
+- (UITextAutocorrectionType)autocorrectionType { return UITextAutocorrectionTypeNo; }
+- (UITextAutocapitalizationType)autocapitalizationType { return UITextAutocapitalizationTypeNone; }
+- (UITextSpellCheckingType)spellCheckingType { return UITextSpellCheckingTypeNo; }
+- (UITextSmartQuotesType)smartQuotesType { return UITextSmartQuotesTypeNo; }
+- (UITextSmartDashesType)smartDashesType { return UITextSmartDashesTypeNo; }
+- (UITextSmartInsertDeleteType)smartInsertDeleteType { return UITextSmartInsertDeleteTypeNo; }
+- (UIKeyboardAppearance)keyboardAppearance { return UIKeyboardAppearanceDark; }
+- (UIReturnKeyType)returnKeyType { return UIReturnKeySend; }
+
+// Always: the game's box may hold text from before, which the delete key should still reach.
+- (BOOL)hasText {
+    return YES;
+}
+
+- (void)insertText:(NSString *)text {
+    [text enumerateSubstringsInRange:NSMakeRange(0, text.length) options:NSStringEnumerationByComposedCharacterSequences
+                          usingBlock:^(NSString *ch, NSRange r, NSRange er, BOOL *stop) {
+        if ([ch isEqualToString:@"\n"] || [ch isEqualToString:@"\r"]) {
+            [self sp_return];
+            return;
+        }
+        sp_virtual_tap(sp_char_mac([ch characterAtIndex:0]), ch);
+        [self->_typed appendString:ch];
+    }];
+    [self sp_show_typed];
+}
+
+- (void)deleteBackward {
+    sp_virtual_tap(0x33, nil);  // Delete: deleteBackward: in the game's box
+    if (_typed.length) {
+        NSRange last = [_typed rangeOfComposedCharacterSequenceAtIndex:_typed.length - 1];
+        [_typed deleteCharactersInRange:last];
+    }
+    [self sp_show_typed];
+}
+
+// Return sends what's typed (and closes the chat box); with something typed, the keyboard closes
+// too, back to the game. With nothing typed it's the game's Enter, which opens the chat.
+- (void)sp_return {
+    BOOL sent = _typed.length > 0;
+    sp_virtual_tap(0x24, nil);
+    [_typed setString:@""];
+    [self sp_show_typed];
+    if (sent) dispatch_async(dispatch_get_main_queue(), ^{ [self sp_close]; });
+}
+
+- (void)sp_escape {
+    sp_virtual_tap(0x35, nil);
+    [_typed setString:@""];
+    [self sp_show_typed];
+}
+
+// F9: SPTouch binds it to open the chat. Unlike Enter it does nothing in a text box that already has
+// the keyboard (the chat's, a search field's): the box takes the key, and a function key types nothing.
+- (void)sp_chat {
+    sp_virtual_tap(0x65, nil);
+}
+
+- (void)sp_tab {
+    sp_virtual_tap(0x30, nil);
+}
+
+- (void)sp_open:(BOOL)chat {
+    if (self.isFirstResponder) return;
+    [_typed setString:@""];
+    [self sp_show_typed];
+    if (![self becomeFirstResponder]) return;
+    if (chat) [self sp_chat];
+    if (_changed) _changed(YES);
+}
+
+// Back to the root view, which takes a hardware keyboard's keys as first responder.
+- (void)sp_close {
+    if (self.isFirstResponder) [self resignFirstResponder];
+    [self.superview.superview becomeFirstResponder];
+    if (_changed) _changed(NO);
+}
+@end
+
+// ---- the settings panel (the gear, or holding Touch)
+
+@interface SPSettingsPanel : UIView
+@property(nonatomic, copy) void (^changed)(void);
+@property(nonatomic, copy) void (^done)(void);
+@end
+
+@implementation SPSettingsPanel {
+    UILabel *_title;
+    NSMutableArray<UILabel *> *_labels;
+    NSMutableArray<UISegmentedControl *> *_segs;
+    UIButton *_reset, *_finish;
+}
+
+- (instancetype)initWithFrame:(CGRect)frame {
+    if (!(self = [super initWithFrame:frame])) return nil;
+    self.backgroundColor = [UIColor colorWithWhite:0.08 alpha:0.94];
+    self.layer.cornerRadius = 14;
+    self.layer.borderWidth = 1;
+    self.layer.borderColor = [UIColor colorWithWhite:1 alpha:0.25].CGColor;
+    _title = [[UILabel alloc] init];
+    _title.text = @"Touch-Steuerung";
+    _title.font = [UIFont boldSystemFontOfSize:16];
+    _title.textColor = UIColor.whiteColor;
+    [self addSubview:_title];
+    _labels = [NSMutableArray array];
+    _segs = [NSMutableArray array];
+    for (int i = 0; i < SP_TS_COUNT; i++) {
+        UILabel *l = [[UILabel alloc] init];
+        l.text = @(sp_ts_rows[i].title);
+        l.font = [UIFont systemFontOfSize:13];
+        l.textColor = [UIColor colorWithWhite:1 alpha:0.85];
+        l.adjustsFontSizeToFitWidth = YES;
+        l.minimumScaleFactor = 0.75;
+        [_labels addObject:l];
+        [self addSubview:l];
+        NSMutableArray *items = [NSMutableArray array];
+        for (int c = 0; c < sp_ts_rows[i].count; c++) [items addObject:@(sp_ts_rows[i].choices[c])];
+        UISegmentedControl *s = [[UISegmentedControl alloc] initWithItems:items];
+        s.tag = i;
+        [s addTarget:self action:@selector(sp_picked:) forControlEvents:UIControlEventValueChanged];
+        [_segs addObject:s];
+        [self addSubview:s];
+    }
+    _reset = [UIButton buttonWithType:UIButtonTypeSystem];
+    [_reset setTitle:@"Standard" forState:UIControlStateNormal];
+    [_reset addTarget:self action:@selector(sp_defaults) forControlEvents:UIControlEventTouchUpInside];
+    _finish = [UIButton buttonWithType:UIButtonTypeSystem];
+    [_finish setTitle:@"Fertig" forState:UIControlStateNormal];
+    _finish.titleLabel.font = [UIFont boldSystemFontOfSize:17];
+    [_finish addTarget:self action:@selector(sp_finished) forControlEvents:UIControlEventTouchUpInside];
+    [self addSubview:_reset];
+    [self addSubview:_finish];
+    [self sp_sync];
+    return self;
+}
+
+- (void)sp_sync {
+    for (int i = 0; i < SP_TS_COUNT; i++) _segs[i].selectedSegmentIndex = sp_ts[i];
+}
+
+- (void)sp_picked:(UISegmentedControl *)s {
+    sp_ts_set((int)s.tag, (int)s.selectedSegmentIndex);
+    if (_changed) _changed();
+}
+
+- (void)sp_defaults {
+    for (int i = 0; i < SP_TS_COUNT; i++) sp_ts_set(i, sp_ts_rows[i].def);
+    [self sp_sync];
+    if (_changed) _changed();
+}
+
+- (void)sp_finished {
+    if (_done) _done();
+}
+
+// Rows as tall as fit (36 points at most), the label column a third of the width.
+- (void)layoutSubviews {
+    [super layoutSubviews];
+    CGRect b = self.bounds;
+    CGFloat pad = 14, w = b.size.width - 2 * pad, head = 34, foot = 40;
+    CGFloat row = MIN(36, (b.size.height - head - foot - pad) / SP_TS_COUNT);
+    _title.frame = CGRectMake(pad, 6, w, head - 6);
+    CGFloat lw = w * 0.34;
+    for (int i = 0; i < SP_TS_COUNT; i++) {
+        CGFloat y = head + i * row;
+        _labels[i].frame = CGRectMake(pad, y, lw - 6, row);
+        _segs[i].frame = CGRectMake(pad + lw, y + 3, w - lw, row - 6);
+    }
+    CGFloat fy = head + SP_TS_COUNT * row + 2;
+    _reset.frame = CGRectMake(pad, fy, 100, foot - 4);
+    _finish.frame = CGRectMake(CGRectGetMaxX(b) - pad - 100, fy, 100, foot - 4);
+}
+@end
